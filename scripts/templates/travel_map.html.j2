<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Road Replay — Tesla Trip Cinema</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
  <style>
    :root {
      --bg: #030306;
      --surface: rgba(12, 14, 20, 0.78);
      --surface-2: rgba(255, 255, 255, 0.035);
      --border: rgba(255, 255, 255, 0.09);
      --border-bright: rgba(255, 255, 255, 0.16);
      --text: #f4f6fa;
      --muted: #8b93a3;
      --accent: #5eead4;
      --accent-2: #38bdf8;
      --gold: #fbbf24;
      --panel-w: 320px;
      --dock-h: 132px;
      --timeline-h: 56px;
      --font-display: 'Syne', system-ui, sans-serif;
      --font-body: 'DM Sans', system-ui, sans-serif;
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%; overflow: hidden;
      font-family: var(--font-body); background: var(--bg); color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    #map-wrap { position: absolute; inset: 0; overflow: hidden; }
    #map { position: absolute; inset: 0; }
    .map-vignette {
      position: absolute; inset: 0; pointer-events: none; z-index: 2;
      background:
        radial-gradient(ellipse 85% 65% at 50% 45%, transparent 30%, rgba(3,3,6,0.55) 100%),
        linear-gradient(to bottom, rgba(3,3,6,0.45) 0%, transparent 18%, transparent 72%, rgba(3,3,6,0.82) 100%);
    }
    .map-grain {
      position: absolute; inset: 0; pointer-events: none; z-index: 3; opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }
    .mapboxgl-canvas { transition: filter 0.8s ease; }
    body.night .mapboxgl-canvas { filter: brightness(0.38) contrast(1.12) saturate(0.78) hue-rotate(205deg); }

    /* ── Splash ── */
    #splash {
      position: fixed; inset: 0; z-index: 9999; background: var(--bg);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      transition: opacity 0.9s ease, visibility 0.9s;
    }
    #splash.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    #splash .brand-mark {
      font-family: var(--font-display); font-size: 13px; letter-spacing: 0.45em;
      text-transform: uppercase; color: var(--muted); margin-bottom: 28px;
    }
    #splash h1 {
      font-family: var(--font-display); font-size: clamp(28px, 4vw, 42px);
      font-weight: 800; letter-spacing: -0.03em; margin-bottom: 10px;
      background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
      -webkit-background-clip: text; -webkit-text-fill-color: transparent;
    }
    #splash p { font-size: 13px; color: var(--muted); margin-bottom: 32px; }
    .splash-bar { width: 280px; height: 2px; background: var(--surface-2); border-radius: 99px; overflow: hidden; }
    .splash-fill {
      height: 100%; width: 0%; border-radius: 99px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      box-shadow: 0 0 20px rgba(94, 234, 212, 0.5);
      transition: width 0.35s ease;
    }

    /* ── Top bar ── */
    .top-bar {
      position: absolute; top: 0; left: 0; right: 0; z-index: 12;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 22px; pointer-events: none;
    }
    .brand {
      font-family: var(--font-display); font-size: 15px; font-weight: 800;
      letter-spacing: 0.18em; text-transform: uppercase; pointer-events: auto;
      text-shadow: 0 2px 16px rgba(0,0,0,0.8);
    }
    .brand span { color: var(--accent); }
    .stat-rail {
      display: flex; gap: 8px; pointer-events: auto;
    }
    .stat-chip {
      background: var(--surface); backdrop-filter: blur(20px) saturate(1.3);
      border: 1px solid var(--border); border-radius: 999px;
      padding: 8px 14px; font-size: 11px; color: var(--muted);
      box-shadow: 0 8px 32px rgba(0,0,0,0.35);
    }
    .stat-chip strong { color: var(--text); font-weight: 700; margin-left: 4px; font-size: 12px; }

    /* ── Trip panel ── */
    .trip-panel {
      position: absolute; top: 72px; left: 18px; bottom: calc(var(--dock-h) + var(--timeline-h) + 36px);
      width: var(--panel-w); z-index: 10;
      background: var(--surface); backdrop-filter: blur(28px) saturate(1.5);
      border: 1px solid var(--border); border-radius: 18px;
      box-shadow: 0 24px 80px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.04);
      display: flex; flex-direction: column; overflow: hidden;
      transition: transform 0.45s cubic-bezier(.22,1,.36,1), opacity 0.35s;
    }
    .trip-panel.collapsed { transform: translateX(calc(-1 * var(--panel-w) - 28px)); opacity: 0.4; }

    .panel-head { padding: 18px 18px 14px; border-bottom: 1px solid var(--border); }
    .panel-head .eyebrow {
      font-size: 10px; font-weight: 600; letter-spacing: 0.14em;
      text-transform: uppercase; color: var(--muted); margin-bottom: 6px;
    }
    .panel-head h2 {
      font-family: var(--font-display); font-size: 18px; font-weight: 700;
      letter-spacing: -0.02em; line-height: 1.2;
    }
    .panel-head .sub { font-size: 11px; color: var(--muted); margin-top: 4px; }

    .trip-hero {
      margin: 14px 14px 0; padding: 16px; border-radius: 14px;
      background: linear-gradient(145deg, rgba(255,255,255,0.06), rgba(255,255,255,0.02));
      border: 1px solid var(--border); position: relative; overflow: hidden;
    }
    .trip-hero::before {
      content: ''; position: absolute; inset: 0;
      background: radial-gradient(circle at 100% 0%, rgba(94,234,212,0.12), transparent 55%);
      pointer-events: none;
    }
    .trip-hero.featured::before {
      background: radial-gradient(circle at 100% 0%, rgba(251,191,36,0.16), transparent 55%);
    }
    .trip-hero-name {
      font-family: var(--font-display); font-size: 15px; font-weight: 700;
      line-height: 1.35; margin-bottom: 6px; position: relative;
    }
    .trip-hero-via { font-size: 11px; color: var(--muted); line-height: 1.45; margin-bottom: 12px; position: relative; }
    .trip-hero-via em { color: var(--accent-2); font-style: normal; font-weight: 600; }
    .metric-grid { display: grid; grid-template-columns: repeat(4, 1fr); gap: 8px; position: relative; }
    .metric {
      text-align: center; padding: 8px 4px; border-radius: 10px;
      background: rgba(0,0,0,0.22); border: 1px solid rgba(255,255,255,0.04);
    }
    .metric .val { display: block; font-family: var(--font-display); font-size: 14px; font-weight: 700; }
    .metric .lbl { font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.08em; margin-top: 2px; }

    .trip-scroll { flex: 1; overflow-y: auto; padding: 10px 10px 14px; }
    .trip-scroll::-webkit-scrollbar { width: 3px; }
    .trip-scroll::-webkit-scrollbar-thumb { background: var(--border-bright); border-radius: 99px; }
    .group-label {
      font-size: 9px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.12em; padding: 10px 6px 6px;
    }
    .group-label.featured { color: var(--gold); }
    .trip-item {
      display: flex; align-items: center; gap: 12px; padding: 11px 12px;
      border-radius: 12px; cursor: pointer; margin-bottom: 3px;
      border: 1px solid transparent; transition: background 0.2s, border-color 0.2s, transform 0.15s;
    }
    .trip-item:hover { background: var(--surface-2); transform: translateX(2px); }
    .trip-item.active {
      background: rgba(94, 234, 212, 0.08); border-color: rgba(94, 234, 212, 0.22);
      box-shadow: inset 0 0 0 1px rgba(94, 234, 212, 0.08);
    }
    .trip-item.featured { border-color: rgba(251, 191, 36, 0.15); }
    .trip-item.featured.active { background: rgba(251, 191, 36, 0.1); border-color: rgba(251, 191, 36, 0.35); }
    .trip-swatch {
      width: 10px; height: 36px; border-radius: 99px; flex-shrink: 0;
      box-shadow: 0 0 12px currentColor;
    }
    .trip-name { font-size: 12px; font-weight: 600; line-height: 1.3; }
    .trip-meta { font-size: 10px; color: var(--muted); margin-top: 2px; }

    .panel-toggle {
      position: absolute; top: 78px; left: calc(var(--panel-w) + 30px); z-index: 11;
      width: 34px; height: 34px; border-radius: 10px;
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(16px); transition: left 0.45s cubic-bezier(.22,1,.36,1);
      box-shadow: 0 4px 20px rgba(0,0,0,0.35);
    }
    .panel-toggle svg { width: 14px; height: 14px; opacity: 0.8; }
    .trip-panel.collapsed ~ .panel-toggle { left: 18px; }

    /* ── Transport dock ── */
    .transport-dock {
      position: absolute; bottom: calc(var(--timeline-h) + 22px); left: 50%;
      transform: translateX(-50%); z-index: 14;
      width: min(720px, calc(100vw - 40px));
      background: var(--surface); backdrop-filter: blur(32px) saturate(1.4);
      border: 1px solid var(--border-bright); border-radius: 20px;
      padding: 14px 18px 16px;
      box-shadow: 0 20px 60px rgba(0,0,0,0.55), inset 0 1px 0 rgba(255,255,255,0.05);
    }
    .dock-top { display: flex; align-items: center; gap: 14px; margin-bottom: 12px; }
    .dock-info { flex: 1; min-width: 0; }
    .dock-location {
      font-family: var(--font-display); font-size: 14px; font-weight: 700;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .dock-sub { font-size: 10px; color: var(--muted); margin-top: 2px; }
    .dock-actions { display: flex; gap: 6px; align-items: center; }
    .icon-btn {
      width: 38px; height: 38px; border-radius: 12px;
      border: 1px solid var(--border); background: rgba(255,255,255,0.04);
      color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s, border-color 0.15s, transform 0.12s;
    }
    .icon-btn:hover { background: rgba(255,255,255,0.08); border-color: var(--border-bright); }
    .icon-btn:active { transform: scale(0.94); }
    .icon-btn:disabled { opacity: 0.28; cursor: default; }
    .icon-btn.on { background: rgba(94,234,212,0.12); border-color: rgba(94,234,212,0.35); color: var(--accent); }
    .icon-btn.primary {
      width: 46px; height: 46px; border-radius: 14px;
      background: linear-gradient(145deg, #fff, #cbd5e1); border: none; color: #0f172a;
      box-shadow: 0 4px 24px rgba(255,255,255,0.15);
    }
    .icon-btn.primary:hover { background: #fff; }
    .icon-btn.export {
      width: auto; padding: 0 14px; gap: 7px; font-size: 11px; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase;
      background: linear-gradient(135deg, rgba(94,234,212,0.18), rgba(56,189,248,0.12));
      border-color: rgba(94,234,212,0.35); color: var(--accent);
    }
    .icon-btn svg { width: 16px; height: 16px; flex-shrink: 0; }

    .scrub-track {
      position: relative; height: 6px; background: rgba(255,255,255,0.06);
      border-radius: 99px; overflow: hidden; cursor: pointer;
    }
    .scrub-fill {
      position: absolute; left: 0; top: 0; bottom: 0; width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      border-radius: 99px; box-shadow: 0 0 12px rgba(94,234,212,0.45);
      transition: width 0.08s linear;
    }
    input[type=range]#scrubber {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; cursor: pointer; margin: 0;
    }
    .dock-sliders { display: grid; grid-template-columns: 1fr 120px; gap: 14px; margin-top: 10px; align-items: center; }
    .speed-wrap label { font-size: 9px; color: var(--muted); text-transform: uppercase; letter-spacing: 0.1em; }
    input[type=range]#speed { width: 100%; accent-color: var(--accent); height: 3px; margin-top: 4px; }
    .speed-val { font-size: 11px; font-weight: 700; color: var(--accent); text-align: right; }

    /* ── Timeline ── */
    .timeline-bar {
      position: absolute; bottom: 14px; left: 18px; right: 18px; height: var(--timeline-h);
      background: var(--surface); backdrop-filter: blur(24px);
      border: 1px solid var(--border); border-radius: 14px;
      z-index: 10; padding: 8px 14px 10px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
    }
    .timeline-label { font-size: 9px; font-weight: 600; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; margin-bottom: 6px; }
    .timeline-track { position: relative; flex: 1; height: 22px; background: rgba(0,0,0,0.35); border-radius: 8px; overflow: hidden; cursor: pointer; }
    .tl-seg {
      position: absolute; top: 3px; bottom: 3px; border-radius: 5px;
      cursor: pointer; opacity: 0.7; transition: opacity 0.2s, filter 0.2s; min-width: 3px;
    }
    .tl-seg:hover, .tl-seg.active { opacity: 1; filter: brightness(1.15); }
    .tl-seg.featured { box-shadow: 0 0 10px rgba(251,191,36,0.4); }
    .timeline-scrub {
      position: absolute; top: 0; bottom: 0; width: 2px;
      background: #fff; box-shadow: 0 0 8px rgba(255,255,255,0.8);
      pointer-events: none; transition: left 0.08s;
    }

    /* ── Location HUD (cinema) ── */
    .location-hud {
      position: absolute; top: 68px; left: 50%; transform: translateX(-50%); z-index: 13;
      display: none; align-items: center; gap: 12px;
      background: rgba(8,10,16,0.82); backdrop-filter: blur(24px);
      border: 1px solid var(--border-bright); border-radius: 16px;
      padding: 12px 20px; box-shadow: 0 16px 48px rgba(0,0,0,0.5);
      max-width: min(92vw, 560px);
    }
    .location-hud.visible { display: flex; }
    .hud-icon {
      width: 36px; height: 36px; border-radius: 10px; flex-shrink: 0;
      display: flex; align-items: center; justify-content: center;
      background: rgba(94,234,212,0.12); border: 1px solid rgba(94,234,212,0.25);
      font-size: 16px;
    }
    .hud-icon.charging { background: rgba(251,191,36,0.12); border-color: rgba(251,191,36,0.3); }
    .hud-body { min-width: 0; }
    .hud-phase { font-size: 10px; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
    .hud-text {
      font-family: var(--font-display); font-size: 17px; font-weight: 700;
      letter-spacing: -0.02em; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }

    /* ── Beacons & labels ── */
    .beacon-wrap { display: flex; flex-direction: column; align-items: center; pointer-events: none; }
    .beacon {
      position: relative; width: 32px; height: 32px;
      opacity: 0; transform: scale(0.4); transition: opacity 0.45s, transform 0.45s cubic-bezier(.34,1.4,.64,1);
    }
    .beacon.visible { opacity: 1; transform: scale(1); }
    .beacon-ring {
      position: absolute; inset: -6px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.35);
      animation: beacon-pulse 2.4s ease-in-out infinite;
    }
    .beacon.active .beacon-ring { inset: -10px; border-color: rgba(255,255,255,0.7); animation-duration: 1.2s; }
    @keyframes beacon-pulse { 0%,100%{transform:scale(1);opacity:0.6} 50%{transform:scale(1.08);opacity:0.2} }
    .beacon-core {
      position: absolute; inset: 0; border-radius: 50%;
      display: flex; align-items: center; justify-content: center;
      font-family: var(--font-display); font-size: 11px; font-weight: 800; color: #fff;
      border: 2px solid rgba(255,255,255,0.95);
      box-shadow: 0 4px 20px rgba(0,0,0,0.55), 0 0 24px var(--beacon-glow, rgba(94,234,212,0.5));
    }
    .beacon-label {
      margin-top: 6px; padding: 4px 10px; border-radius: 999px;
      font-size: 10px; font-weight: 700; letter-spacing: 0.02em; color: #fff;
      background: rgba(8,10,16,0.82); border: 1px solid rgba(255,255,255,0.12);
      backdrop-filter: blur(8px); white-space: nowrap; max-width: 150px;
      overflow: hidden; text-overflow: ellipsis;
      opacity: 0; transform: translateY(6px); transition: opacity 0.35s, transform 0.35s;
    }
    .beacon-label.visible { opacity: 1; transform: translateY(0); }
    .beacon-label.active { border-color: rgba(251,191,36,0.5); color: var(--gold); }

    .stop-dot {
      width: 5px; height: 5px; border-radius: 50%;
      border: 1px solid rgba(255,255,255,0.7);
      box-shadow: 0 0 8px currentColor;
    }

    /* ── Vehicle ── */
    .vehicle-wrap { position: relative; width: 52px; height: 52px; }
    .vehicle-glow {
      position: absolute; inset: -12px; border-radius: 50%;
      background: radial-gradient(circle, rgba(94,234,212,0.55) 0%, transparent 68%);
      animation: vglow 2s ease-in-out infinite;
    }
    @keyframes vglow { 0%,100%{transform:scale(1);opacity:0.9} 50%{transform:scale(1.25);opacity:0.35} }
    .vehicle-body {
      position: absolute; inset: 6px; display: flex; align-items: center; justify-content: center;
      background: rgba(8,10,16,0.92); border-radius: 50%;
      border: 2px solid rgba(255,255,255,0.9);
      box-shadow: 0 0 24px rgba(94,234,212,0.5), 0 4px 16px rgba(0,0,0,0.5);
    }
    .vehicle-body svg { width: 22px; height: 22px; fill: #fff; }

    /* ── Cinema / export ── */
    body.cinema-mode .trip-panel,
    body.cinema-mode .panel-toggle,
    body.cinema-mode .top-bar,
    body.cinema-mode .transport-dock,
    body.cinema-mode .timeline-bar,
    body.cinema-mode #onboarding,
    body.cinema-mode .mapboxgl-ctrl-group,
    body.cinema-mode .mapboxgl-ctrl-attrib { opacity: 0 !important; pointer-events: none !important; }
    body.cinema-mode.portrait-export #map-wrap {
      display: flex; align-items: center; justify-content: center; background: #000;
    }
    body.cinema-mode.portrait-export #map {
      width: min(100vw, calc(100vh * 9 / 16)); height: 100vh; position: relative; inset: auto;
    }
    .cinema-title {
      position: absolute; bottom: 56px; left: 50%; transform: translateX(-50%); z-index: 15;
      text-align: center; display: none; pointer-events: none;
    }
    body.cinema-mode .cinema-title.visible { display: block; }
    .cinema-title h2 {
      font-family: var(--font-display); font-size: clamp(22px, 4vw, 32px); font-weight: 800;
      text-shadow: 0 4px 24px rgba(0,0,0,0.95);
    }
    .cinema-title p { font-size: 12px; color: #cbd5e1; margin-top: 6px; letter-spacing: 0.06em; }

    .export-status {
      position: fixed; bottom: 24px; right: 24px; z-index: 10001;
      background: var(--surface); border: 1px solid var(--border-bright); border-radius: 12px;
      padding: 12px 18px; font-size: 12px; font-weight: 600; display: none;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5);
    }
    .export-status.visible { display: block; }

    /* ── Onboarding / token ── */
    #onboarding {
      position: fixed; inset: 0; z-index: 9000; background: rgba(3,3,6,0.65);
      display: flex; align-items: center; justify-content: center;
      opacity: 0; visibility: hidden; transition: opacity 0.4s, visibility 0.4s;
    }
    #onboarding.visible { opacity: 1; visibility: visible; }
    .onboard-card {
      max-width: 440px; margin-left: 340px; padding: 32px 36px;
      background: var(--surface); border: 1px solid var(--border-bright); border-radius: 20px;
      backdrop-filter: blur(28px); box-shadow: 0 32px 100px rgba(0,0,0,0.65);
    }
    .onboard-card h2 { font-family: var(--font-display); font-size: 24px; font-weight: 800; margin-bottom: 10px; }
    .onboard-card p { font-size: 14px; color: var(--muted); line-height: 1.6; margin-bottom: 24px; }
    .onboard-card .highlight { color: var(--gold); font-weight: 600; }
    .onboard-actions { display: flex; gap: 10px; }
    .btn {
      flex: 1; padding: 13px 18px; border-radius: 12px; border: 1px solid var(--border);
      background: rgba(255,255,255,0.04); color: var(--text); cursor: pointer;
      font-size: 13px; font-weight: 600; font-family: inherit; transition: all 0.15s;
    }
    .btn:hover { background: rgba(255,255,255,0.08); }
    .btn.gold {
      background: linear-gradient(135deg, rgba(251,191,36,0.25), rgba(245,158,11,0.15));
      border-color: rgba(251,191,36,0.4); color: var(--gold);
    }
    .btn.primary { background: #fff; color: #0f172a; border: none; font-weight: 700; }
    #token-gate {
      position: fixed; inset: 0; z-index: 10000; background: var(--bg);
      display: none; flex-direction: column; align-items: center; justify-content: center; padding: 24px;
    }
    #token-gate.visible { display: flex; }
    #token-gate h2 { font-family: var(--font-display); font-size: 26px; font-weight: 800; margin-bottom: 8px; }
    #token-gate p { font-size: 14px; color: var(--muted); max-width: 420px; text-align: center; line-height: 1.6; margin-bottom: 20px; }
    #token-gate input {
      width: min(420px, 90vw); padding: 14px 16px; border-radius: 12px;
      border: 1px solid var(--border); background: var(--surface-2); color: var(--text); font-size: 13px; margin-bottom: 12px;
    }
    #token-gate a { color: var(--accent-2); }

    .mapboxgl-ctrl-group { background: var(--surface) !important; border: 1px solid var(--border) !important; border-radius: 10px !important; }
    .mapboxgl-ctrl-group button span { filter: invert(1); }
    .mapboxgl-popup-content {
      background: var(--surface) !important; color: var(--text) !important; border-radius: 14px !important;
      border: 1px solid var(--border) !important; font-family: var(--font-body) !important;
      backdrop-filter: blur(20px) !important; box-shadow: 0 16px 48px rgba(0,0,0,0.55) !important;
    }
    .mapboxgl-ctrl-attrib { background: rgba(3,3,6,0.75) !important; color: var(--muted) !important; font-size: 9px !important; }
    kbd {
      background: rgba(255,255,255,0.06); border: 1px solid var(--border);
      border-radius: 4px; padding: 1px 5px; font-size: 10px;
    }
  </style>
</head>
<body>

  <!-- Token gate (shown when no token baked in at build time) -->
  <div id="token-gate">
    <div class="logo" style="font-size:48px;margin-bottom:12px">⚡</div>
    <h2>Mapbox Token Required</h2>
    <p>Paste your free <a href="https://account.mapbox.com/access-tokens/" target="_blank" rel="noopener">Mapbox public token</a> to load satellite terrain. Stored locally in your browser only.</p>
    <input type="password" id="token-input" placeholder="pk.eyJ..." autocomplete="off">
    <button class="btn primary" id="token-submit" style="padding:12px 32px">Launch Map</button>
  </div>

  <!-- Onboarding -->
  <div id="onboarding">
    <div class="onboard-card">
      <h2>Start Your Replay</h2>
      <p>Pick a journey from the trip panel — start with an <span class="highlight">Epic Road Trip</span> for the full cinematic experience with location labels and video export.</p>
      <div class="onboard-actions">
        <button class="btn gold" id="onboard-featured">🎬 Epic Trip</button>
        <button class="btn" id="onboard-dismiss">Explore Overview</button>
      </div>
    </div>
  </div>

  <!-- Splash -->
  <div id="splash">
    <div class="brand-mark">Supercharger Cinema</div>
    <h1>Road Replay</h1>
    <p>Loading terrain · {{ trips|length }} journeys · {{ "{:,}".format(dashboard.total_miles) }} miles driven</p>
    <div class="splash-bar"><div class="splash-fill" id="splash-fill"></div></div>
  </div>

  <div id="map-wrap">
    <div id="map"></div>
    <div class="map-vignette"></div>
    <div class="map-grain"></div>
  </div>

  <!-- Top bar -->
  <header class="top-bar">
    <div class="brand">ROAD<span>REPLAY</span></div>
    <div class="stat-rail">
      <div class="stat-chip">{{ dashboard.trip_count }}<strong>trips</strong></div>
      <div class="stat-chip">{{ "{:,}".format(dashboard.total_miles) }}<strong>mi</strong></div>
      <div class="stat-chip">{{ dashboard.total_kwh|int }}<strong>kWh</strong></div>
      <div class="stat-chip">{{ dashboard.states|length }}<strong>states</strong></div>
    </div>
  </header>

  <div class="location-hud" id="location-hud">
    <div class="hud-icon" id="hud-icon">🚗</div>
    <div class="hud-body">
      <div class="hud-phase" id="hud-phase">Driving</div>
      <div class="hud-text" id="hud-text"></div>
    </div>
  </div>

  <div class="cinema-title" id="cinema-title"><h2 id="cinema-title-text"></h2><p id="cinema-subtitle"></p></div>
  <div class="export-status" id="export-status">Recording…</div>

  <button class="panel-toggle" id="sidebar-toggle" title="Toggle trips panel" aria-label="Toggle panel">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>

  <aside class="trip-panel" id="sidebar">
    <div class="panel-head">
      <div class="eyebrow">Your Journeys</div>
      <h2 id="panel-title">Select a Trip</h2>
      <div class="sub" id="panel-sub">{{ dashboard.trip_count }} road trips from your Supercharger history</div>
    </div>

    <div class="trip-hero" id="hero-card">
      <div class="trip-hero-name" id="hero-name">Overview</div>
      <div class="trip-hero-via" id="hero-via">Choose a journey to begin cinematic playback.</div>
      <div class="metric-grid">
        <div class="metric"><span class="val" id="hero-miles">—</span><span class="lbl">Miles</span></div>
        <div class="metric"><span class="val" id="hero-kwh">—</span><span class="lbl">kWh</span></div>
        <div class="metric"><span class="val" id="hero-days">—</span><span class="lbl">Days</span></div>
        <div class="metric"><span class="val" id="hero-stops">—</span><span class="lbl">Stops</span></div>
      </div>
    </div>

    <div class="trip-scroll" id="trip-list">
      <div class="group-label">Overview</div>
      <div class="trip-item active" data-id="all">
        <div class="trip-swatch" style="background:linear-gradient(180deg,#5eead4,#38bdf8)"></div>
        <div><div class="trip-name">All Routes</div><div class="trip-meta">{{ trips|length }} journeys · lifetime map</div></div>
      </div>
      {% set featured_trips = trips|selectattr('featured')|list %}
      {% if featured_trips %}
      <div class="group-label featured">Epic Road Trips</div>
      {% for trip in featured_trips %}
      <div class="trip-item featured" data-id="{{ trip.id }}">
        <div class="trip-swatch" style="background:{{ trip.color }};color:{{ trip.color }}"></div>
        <div><div class="trip-name">{{ trip.name }}</div><div class="trip-meta">{{ trip.miles }} mi · {{ trip.stop_count }} stops · {{ trip.duration_days }}d</div></div>
      </div>
      {% endfor %}
      {% endif %}
      <div class="group-label">All Trips</div>
      {% for trip in trips if not trip.featured %}
      <div class="trip-item" data-id="{{ trip.id }}">
        <div class="trip-swatch" style="background:{{ trip.color }};color:{{ trip.color }}"></div>
        <div><div class="trip-name">{{ trip.name }}</div><div class="trip-meta">{{ trip.start }} · {{ trip.miles }} mi</div></div>
      </div>
      {% endfor %}
    </div>
  </aside>

  <!-- Transport dock -->
  <div class="transport-dock" id="transport-dock">
    <div class="dock-top">
      <div class="dock-info">
        <div class="dock-location" id="prog-text">Select a trip to replay</div>
        <div class="dock-sub"><span id="prog-start">—</span> → <span id="prog-end">—</span></div>
      </div>
      <div class="dock-actions">
        <button class="icon-btn" id="btn-reset" title="Reset"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v5h5"/></svg></button>
        <button class="icon-btn" id="btn-step" title="Next stop"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l12 8-12 8V4z"/></svg></button>
        <button class="icon-btn primary" id="btn-play" disabled title="Play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7L8 5z"/></svg></button>
        <button class="icon-btn" id="btn-pause" disabled title="Pause"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6V5zm8 0h4v14h-4V5z"/></svg></button>
        <button class="icon-btn" id="btn-loop" title="Loop"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></button>
        <button class="icon-btn on" id="btn-director" title="Director camera"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M10 9l6 3-6 3V9z"/></svg></button>
        <button class="icon-btn" id="btn-night" title="Night mode"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button>
        <button class="icon-btn export" id="btn-export" disabled title="Export video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
          Export
        </button>
      </div>
    </div>
    <div class="scrub-track">
      <div class="scrub-fill" id="scrub-fill"></div>
      <input type="range" id="scrubber" min="0" max="1000" value="0">
    </div>
    <div class="dock-sliders">
      <div class="speed-wrap">
        <label>Playback speed · <span class="speed-val" id="speed-label">1×</span></label>
        <input type="range" id="speed" min="0.25" max="8" step="0.25" value="1">
      </div>
      <div style="font-size:9px;color:var(--muted);text-align:right;padding-top:14px"><kbd>Space</kbd> play · <kbd>←</kbd><kbd>→</kbd> step</div>
    </div>
  </div>

  <!-- Master timeline -->
  <div class="timeline-bar">
    <div class="timeline-label" id="timeline-label">Journey Timeline</div>
    <div class="timeline-track" id="timeline-track">
      {% for seg in timeline %}
      <div class="tl-seg{% if seg.has_colorado %} featured{% endif %}"
           data-id="{{ seg.id }}" title="{{ seg.name }}"
           style="left:{{ seg.left_pct }}%;width:{{ seg.width_pct }}%;background:{{ seg.color }}"></div>
      {% endfor %}
      <div class="timeline-scrub" id="timeline-scrub" style="left:0%"></div>
    </div>
  </div>

  <script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
  <script>
    const TRIPS = {{ trips_json | safe }};
    const DASHBOARD = {{ dashboard_json | safe }};
    const MAPBOX_TOKEN = {{ mapbox_token | tojson }};
    const US_BOUNDS = DASHBOARD.us_bounds;
    const BASE_MS = 1600;

    let map;

    // ── State ──
    let selectedId = 'all', animTimeMs = 0, animProg = 0, animStopIdx = 0;
    let isPlaying = false, animFrame = null, lastTs = 0;
    let speed = 1, loopTrip = false, directorMode = true, nightMode = false;
    let isRecording = false, mediaRecorder = null, recordedChunks = [];
    let vehicleMarker = null, stopMarkers = [];
    const MAX_PITCH = 45;

    const carHtml = `<div class="vehicle-wrap"><div class="vehicle-glow"></div><div class="vehicle-body"><svg viewBox="0 0 24 24"><path d="M18.92 6.01C18.72 5.42 18.16 5 17.5 5h-11c-.66 0-1.21.42-1.42 1.01L3 12v8c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-1h12v1c0 .55.45 1 1 1h1c.55 0 1-.45 1-1v-8l-2.08-5.99zM6.5 16c-.83 0-1.5-.67-1.5-1.5S5.67 13 6.5 13s1.5.67 1.5 1.5S7.33 16 6.5 16zm11 0c-.83 0-1.5-.67-1.5-1.5s.67-1.5 1.5-1.5 1.5.67 1.5 1.5-.67 1.5-1.5 1.5zM5 11l1.5-4.5h11L19 11H5z"/></svg></div></div>`;

    // ── Splash progress ──
    function setSplash(pct) { document.getElementById('splash-fill').style.width = pct + '%'; }
    function hideSplash() {
      setSplash(100);
      setTimeout(() => {
        document.getElementById('splash').classList.add('hidden');
        showOnboarding();
      }, 400);
    }
    function showOnboarding() {
      if (localStorage.getItem('tesla-map-onboarded')) return;
      document.getElementById('onboarding').classList.add('visible');
    }
    function dismissOnboarding() {
      document.getElementById('onboarding').classList.remove('visible');
      localStorage.setItem('tesla-map-onboarded', '1');
    }
    function startWithFeatured() {
      const epic = TRIPS.find(t => t.featured) || TRIPS.find(t => t.has_colorado) || TRIPS[0];
      if (epic) selectTrip(epic.id);
      dismissOnboarding();
    }

    function shortLabel(location) {
      const city = (location || '').split(',')[0].trim();
      const st = (location || '').match(/,\s*([A-Z]{2})\b/);
      return st ? `${city}, ${st[1]}` : city;
    }

    function activePlayback() {
      const t = activeTrip();
      return t?.playback || null;
    }

    function playbackProgress() {
      const pb = activePlayback();
      if (!pb || !pb.total_video_ms) return 0;
      return Math.min(1, animTimeMs / pb.total_video_ms);
    }

    function positionAtTime(elapsedMs) {
      const pb = activePlayback();
      if (!pb || !pb.segments?.length) return null;
      let cursor = 0;
      for (const seg of pb.segments) {
        const end = cursor + seg.duration_ms;
        if (elapsedMs < end) {
          const frac = Math.max(0, Math.min(1, (elapsedMs - cursor) / seg.duration_ms));
          if (seg.type === 'dwell') {
            return {
              lat: seg.lat, lng: seg.lng, phase: 'dwell', label: seg.label,
              stopIndex: seg.stop_index, frac, bearing: 0, path: [[seg.lat, seg.lng]],
            };
          }
          const path = seg.path || [];
          const pos = pointOnPath(path, frac) || { lat: seg.path?.[0]?.[0], lng: seg.path?.[0]?.[1] };
          return {
            ...pos, phase: 'travel', label: seg.to_label, stopIndex: seg.stop_index,
            frac, bearing: pathBearing(path, frac), path,
          };
        }
        cursor = end;
      }
      const last = pb.segments[pb.segments.length - 1];
      return {
        lat: last.lat, lng: last.lng, phase: 'dwell', label: last.label || last.to_label,
        stopIndex: last.stop_index, frac: 1, bearing: 0, path: last.path || [[last.lat, last.lng]],
      };
    }

    // ── Map init ──
    function bootMap(accessToken) {
      mapboxgl.accessToken = accessToken;
      localStorage.setItem('mapbox-token', accessToken);
      document.getElementById('token-gate').classList.remove('visible');
      setSplash(20);
      map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/satellite-streets-v12',
        center: [-105, 39], zoom: 4, pitch: 0, bearing: 0,
        antialias: true,
        maxPitch: MAX_PITCH,
        projection: 'mercator',
      });
      map.addControl(new mapboxgl.NavigationControl({ visualizePitch: true }), 'bottom-right');
      map.on('load', onMapLoad);
    }

    function onMapLoad() {
      setupTerrain();
      drawRoutes();
      drawStops();
      updateHero();
      setMapLabelsVisible(true);
      document.getElementById('btn-play').disabled = true;
      document.getElementById('prog-text').textContent = 'Select a trip to play';
      introFlyover();
    }

    // ── Helpers ──
    function isSingleTrip() { return selectedId !== 'all'; }
    function activeTrips() { return isSingleTrip() ? TRIPS.filter(t => t.id === selectedId) : TRIPS; }
    function activeTrip() { return isSingleTrip() ? TRIPS.find(t => t.id === selectedId) : null; }
    function activeStops() { return activeTrips().flatMap(t => t.stops.map((s,i) => ({...s, tripColor: t.color, tripId: t.id, stopNum: i+1}))); }
    function activePath() {
      if (!isSingleTrip()) return [];
      const t = activeTrip();
      return t ? (t.route_path || []) : [];
    }
    function lerp(a,b,t) { return a+(b-a)*t; }
    function pointOnPath(path, prog) {
      if (!path.length) return null;
      if (prog <= 0) return {lat:path[0][0], lng:path[0][1]};
      if (prog >= 1) return {lat:path[path.length-1][0], lng:path[path.length-1][1]};
      const ex = prog*(path.length-1), idx = Math.floor(ex), frac = ex-idx;
      const a=path[idx], b=path[Math.min(idx+1,path.length-1)];
      return {lat:lerp(a[0],b[0],frac), lng:lerp(a[1],b[1],frac)};
    }
    function pathBearing(path, prog) {
      const ex = prog*(path.length-1), idx = Math.min(Math.floor(ex), path.length-2);
      const a=path[idx], b=path[idx+1];
      const dLng=(b[1]-a[1])*Math.PI/180, lat1=a[0]*Math.PI/180, lat2=b[0]*Math.PI/180;
      const y=Math.sin(dLng)*Math.cos(lat2), x=Math.cos(lat1)*Math.sin(lat2)-Math.sin(lat1)*Math.cos(lat2)*Math.cos(dLng);
      return (Math.atan2(y,x)*180/Math.PI+360)%360;
    }
    function findStopIdx(stops, path, prog) {
      const pos = pointOnPath(path, prog); if (!pos||!stops.length) return 0;
      let best=0, bestD=Infinity;
      stops.forEach((s,i)=>{ const d=(s.lat-pos.lat)**2+(s.lng-pos.lng)**2; if(d<bestD){bestD=d;best=i;} });
      return best;
    }
    function popupHtml(s) {
      const dt = new Date(s.datetime).toLocaleString('en-US',{dateStyle:'medium',timeStyle:'short'});
      let h=`<b>${s.location}</b><br>${dt}<br><strong>${s.kwh} kWh</strong>`;
      if(s.in_colorado) h+='<br>🏔 Colorado';
      if(s.invoice_url) h+=`<br><a href="${s.invoice_url}" target="_blank" style="color:#60a5fa">Invoice →</a>`;
      return h;
    }
    function hexToRgb(hex) {
      const r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);
      return [r,g,b];
    }

    function routeLayerIds(tripId) {
      const base = `route-${tripId}`;
      return {
        src: base,
        shadow: `${base}-shadow`,
        glowOuter: `${base}-glow-outer`,
        glowMid: `${base}-glow-mid`,
        core: `${base}-core`,
        highlight: `${base}-highlight`,
      };
    }

    function addRouteLayers(tripId, coords, color, visible) {
      const ids = routeLayerIds(tripId);
      const vis = visible ? 'visible' : 'none';
      const feature = { type: 'Feature', geometry: { type: 'LineString', coordinates: coords } };
      if (!map.getSource(ids.src)) {
        map.addSource(ids.src, { type: 'geojson', lineMetrics: true, data: feature });
        map.addLayer({
          id: ids.shadow, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: { 'line-color': '#000', 'line-width': 18, 'line-opacity': 0.28, 'line-blur': 6 },
        });
        map.addLayer({
          id: ids.glowOuter, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: { 'line-color': color, 'line-width': 14, 'line-opacity': 0.22, 'line-blur': 5 },
        });
        map.addLayer({
          id: ids.glowMid, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: { 'line-color': color, 'line-width': 7, 'line-opacity': 0.55, 'line-blur': 1.5 },
        });
        map.addLayer({
          id: ids.core, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-width': 2.2,
            'line-gradient': ['interpolate', ['linear'], ['line-progress'], 0, 'rgba(255,255,255,0.15)', 0.08, color, 1, '#ffffff'],
          },
        });
        map.addLayer({
          id: ids.highlight, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: { 'line-color': '#ffffff', 'line-width': 0.8, 'line-opacity': 0.85 },
        });
      } else {
        map.getSource(ids.src).setData(feature);
        [ids.shadow, ids.glowOuter, ids.glowMid, ids.core, ids.highlight].forEach(id => {
          map.setLayoutProperty(id, 'visibility', vis);
        });
        map.setPaintProperty(ids.glowOuter, 'line-color', color);
        map.setPaintProperty(ids.glowMid, 'line-color', color);
        map.setPaintProperty(ids.core, 'line-gradient', ['interpolate', ['linear'], ['line-progress'], 0, 'rgba(255,255,255,0.15)', 0.08, color, 1, '#ffffff']);
      }
    }

    function setRouteStyle(tripId, color, mode) {
      const ids = routeLayerIds(tripId);
      if (!map.getLayer(ids.core)) return;
      const styles = {
        overview: { shadow: 0.12, outer: 0.08, mid: 0.18, coreW: 1, hi: 0.2 },
        active: { shadow: 0.38, outer: 0.32, mid: 0.72, coreW: 2.4, hi: 0.95 },
        hidden: { shadow: 0, outer: 0, mid: 0, coreW: 0, hi: 0 },
      }[mode] || styles.hidden;
      map.setPaintProperty(ids.shadow, 'line-opacity', styles.shadow);
      map.setPaintProperty(ids.glowOuter, 'line-opacity', styles.outer);
      map.setPaintProperty(ids.glowMid, 'line-opacity', styles.mid);
      map.setPaintProperty(ids.core, 'line-width', styles.coreW);
      map.setPaintProperty(ids.highlight, 'line-opacity', styles.hi);
      map.setPaintProperty(ids.glowOuter, 'line-color', color);
      map.setPaintProperty(ids.glowMid, 'line-color', color);
    }

    function ensureTrailLayers(color) {
      if (map.getSource('active-trail')) return;
      map.addSource('active-trail', { type: 'geojson', lineMetrics: true, data: { type: 'Feature', geometry: { type: 'LineString', coordinates: [] } } });
      map.addLayer({
        id: 'active-trail-shadow', type: 'line', source: 'active-trail',
        paint: { 'line-color': '#000', 'line-width': 20, 'line-opacity': 0.35, 'line-blur': 8 },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-glow', type: 'line', source: 'active-trail',
        paint: { 'line-color': color, 'line-width': 12, 'line-opacity': 0.55, 'line-blur': 4 },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-line', type: 'line', source: 'active-trail',
        paint: {
          'line-width': 2.8,
          'line-gradient': ['interpolate', ['linear'], ['line-progress'], 0, color, 0.85, '#ffffff', 1, '#ffffff'],
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-head', type: 'line', source: 'active-trail',
        paint: { 'line-color': '#ffffff', 'line-width': 1, 'line-opacity': 1 },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
    }

    // ── Terrain (subtle — routes use Mapbox line layers on surface) ──
    function setupTerrain() {
      setSplash(50);
      if (!map.getSource('mapbox-dem')) {
        map.addSource('mapbox-dem', { type:'raster-dem', url:'mapbox://mapbox.mapbox-terrain-dem-v1', tileSize:512, maxzoom:14 });
      }
      map.setTerrain({ source:'mapbox-dem', exaggeration: 1.0 });
      setSplash(70);
    }

    function setMapLabelsVisible(visible) {
      if (!map || !map.isStyleLoaded()) return;
      map.getStyle().layers.forEach(layer => {
        if (layer.type === 'symbol' && layer.layout && layer.layout['text-field']) {
          try { map.setLayoutProperty(layer.id, 'visibility', visible ? 'visible' : 'none'); } catch (_) {}
        }
      });
    }

    // ── Premium route rendering ──
    function drawRoutes() {
      TRIPS.forEach(trip => {
        const coords = (trip.route_path || []).map(p => [p[1], p[0]]);
        const isSelected = selectedId === trip.id;
        const isOverview = selectedId === 'all';
        const visible = isOverview || isSelected;
        addRouteLayers(trip.id, coords, trip.color, visible);
        if (!visible) setRouteStyle(trip.id, trip.color, 'hidden');
        else if (isSelected) setRouteStyle(trip.id, trip.color, 'active');
        else setRouteStyle(trip.id, trip.color, 'overview');
      });
    }

    // ── Beacon markers ──
    function drawStops() {
      stopMarkers.forEach(m => m.remove()); stopMarkers = [];
      const single = isSingleTrip();
      activeTrips().forEach(trip => {
        trip.stops.forEach((s, i) => {
          const wrap = document.createElement('div');
          wrap.className = 'beacon-wrap';
          if (single) {
            const beacon = document.createElement('div');
            beacon.className = 'beacon';
            beacon.style.setProperty('--beacon-glow', trip.color + '88');
            beacon.innerHTML = `<div class="beacon-ring"></div><div class="beacon-core" style="background:${trip.color}">${i + 1}</div>`;
            const lbl = document.createElement('div');
            lbl.className = 'beacon-label';
            lbl.textContent = shortLabel(s.location);
            wrap.appendChild(beacon);
            wrap.appendChild(lbl);
            var el = beacon, lblRef = lbl;
          } else {
            const dot = document.createElement('div');
            dot.className = 'stop-dot';
            dot.style.background = trip.color;
            dot.style.color = trip.color;
            wrap.appendChild(dot);
            var el = dot, lblRef = null;
          }
          const m = new mapboxgl.Marker({ element: wrap, anchor: 'bottom' })
            .setLngLat([s.lng, s.lat])
            .setPopup(new mapboxgl.Popup({ offset: 14, maxWidth: '280px' }).setHTML(popupHtml(s)))
            .addTo(map);
          m._idx = i; m._el = el; m._lbl = lblRef; m._stop = s;
          if (single) { el.classList.add('visible'); if (lblRef) lblRef.classList.add('visible'); }
          stopMarkers.push(m);
        });
      });
    }

    // ── Hero card ──
    function updateHero() {
      const trips = activeTrips();
      const card = document.getElementById('hero-card');
      const viaEl = document.getElementById('hero-via');
      const panelTitle = document.getElementById('panel-title');
      if (selectedId === 'all') {
        panelTitle.textContent = 'All Routes';
        document.getElementById('hero-name').textContent = 'Lifetime Overview';
        viaEl.innerHTML = 'Select an <em>Epic Road Trip</em> for cinematic replay and video export.';
        document.getElementById('hero-miles').textContent = DASHBOARD.total_miles.toLocaleString();
        document.getElementById('hero-kwh').textContent = DASHBOARD.total_kwh.toLocaleString();
        document.getElementById('hero-days').textContent = TRIPS.length;
        document.getElementById('hero-stops').textContent = TRIPS.reduce((s, t) => s + t.stop_count, 0);
        card.classList.remove('featured');
      } else {
        const t = trips[0];
        panelTitle.textContent = t.name.split('—').pop()?.trim() || t.name;
        document.getElementById('hero-name').textContent = t.name;
        if (t.via_summary) viaEl.innerHTML = `Route via <em>${t.via_summary}</em> · ${t.state_names?.join(' → ') || ''}`;
        else viaEl.innerHTML = t.states.length ? `Through <em>${t.states.join(', ')}</em>` : '';
        document.getElementById('hero-miles').textContent = t.miles.toLocaleString();
        document.getElementById('hero-kwh').textContent = t.total_kwh;
        document.getElementById('hero-days').textContent = t.duration_days;
        document.getElementById('hero-stops').textContent = t.stop_count;
        card.classList.toggle('featured', t.featured || t.has_colorado);
      }
    }

    // ── Intro — continental US, flat mercator view ──
    function introFlyover() {
      map.fitBounds([[US_BOUNDS.west, US_BOUNDS.south], [US_BOUNDS.east, US_BOUNDS.north]], {
        padding:{top:72,bottom:200,left:360,right:48},
        pitch:0, bearing:0, duration:1400, maxZoom:5,
      });
      setTimeout(hideSplash, 2200);
    }

    // ── Fit trip — frame route in continental US ──
    function fitTrip(animate=true) {
      const bounds = new mapboxgl.LngLatBounds();
      activeTrips().forEach(t => t.stops.forEach(s => bounds.extend([s.lng,s.lat])));
      if (bounds.isEmpty()) return;
      setMapLabelsVisible(true);
      map.fitBounds(bounds, {
        padding:{top:88,bottom:200,left:360,right:48},
        pitch: isSingleTrip() ? 42 : 0,
        bearing: isSingleTrip() ? -12 : 0,
        duration: animate ? 1600 : 0,
        maxZoom: isSingleTrip() ? 6.2 : 5,
        minZoom: 3,
      });
    }

    function updateLocationHud(state) {
      const hud = document.getElementById('location-hud');
      const icon = document.getElementById('hud-icon');
      if (!state || !isSingleTrip()) { hud.classList.remove('visible'); return; }
      hud.classList.add('visible');
      const charging = state.phase === 'dwell';
      icon.textContent = charging ? '⚡' : '→';
      icon.classList.toggle('charging', charging);
      document.getElementById('hud-phase').textContent = charging ? 'Charging' : 'En Route';
      document.getElementById('hud-text').textContent = state.label || '';
    }

    function updateTrailFromState(state) {
      const path = activePath(), stops = activeStops();
      if (!state) return;
      animStopIdx = state.stopIndex ?? 0;
      animProg = playbackProgress();
      const pos = { lat: state.lat, lng: state.lng };
      const segPath = state.path?.length ? state.path : path;
      let trailCoords = [];
      if (state.phase === 'travel' && segPath?.length) {
        const endIdx = Math.max(1, Math.ceil(state.frac * (segPath.length - 1)));
        trailCoords = segPath.slice(0, endIdx + 1).map(p => [p[1], p[0]]);
      } else if (path.length) {
        const endIdx = Math.max(1, Math.ceil(animProg * (path.length - 1)));
        trailCoords = path.slice(0, endIdx + 1).map(p => [p[1], p[0]]);
      }
      if (pos.lat != null) trailCoords.push([pos.lng, pos.lat]);
      const color = stops[Math.min(animStopIdx, stops.length - 1)]?.tripColor || '#5eead4';
      const bearing = state.bearing || 0;

      ensureTrailLayers(color);
      map.getSource('active-trail').setData({ type: 'Feature', geometry: { type: 'LineString', coordinates: trailCoords } });
      ['active-trail-glow', 'active-trail-line'].forEach(id => {
        if (map.getLayer(id)) {
          if (id === 'active-trail-glow') map.setPaintProperty(id, 'line-color', color);
          if (id === 'active-trail-line') map.setPaintProperty(id, 'line-gradient', ['interpolate', ['linear'], ['line-progress'], 0, color, 0.85, '#ffffff', 1, '#ffffff']);
        }
      });

      if (pos.lat != null) {
        if (vehicleMarker) {
          vehicleMarker.setLngLat([pos.lng, pos.lat]);
          const body = vehicleMarker.getElement().querySelector('.vehicle-body');
          if (body) body.style.transform = `rotate(${bearing}deg)`;
        } else {
          const el = document.createElement('div');
          el.innerHTML = carHtml;
          vehicleMarker = new mapboxgl.Marker({ element: el, anchor: 'center', rotationAlignment: 'map' })
            .setLngLat([pos.lng, pos.lat]).addTo(map);
        }
        if (directorMode) {
          const lookFrac = Math.min((state.frac || animProg) + 0.06, 1);
          const ahead = pointOnPath(segPath?.length ? segPath : path, lookFrac) || pos;
          map.easeTo({
            center: [ahead.lng, ahead.lat],
            zoom: Math.min(7, Math.max(5, map.getZoom())),
            pitch: Math.min(MAX_PITCH, 44),
            bearing: bearing * 0.35,
            duration: 700, essential: true,
          });
        }
      }

      stopMarkers.forEach(m => {
        const show = m._idx <= animStopIdx;
        m._el.classList.toggle('visible', show);
        if (m._lbl) m._lbl.classList.toggle('visible', show);
        m._el.classList.toggle('active', m._idx === animStopIdx);
        if (m._lbl) m._lbl.classList.toggle('active', m._idx === animStopIdx);
      });

      document.getElementById('scrubber').value = Math.round(animProg * 1000);
      document.getElementById('scrub-fill').style.width = (animProg * 100) + '%';
      document.getElementById('timeline-scrub').style.left = (animProg * 100) + '%';
      const cur = stops[animStopIdx];
      document.getElementById('prog-text').textContent = cur
        ? (state.phase === 'dwell' ? `Charging · ${shortLabel(cur.location)}` : `Driving · ${state.label || shortLabel(cur.location)}`)
        : 'Ready to replay';
      if (cur) {
        document.getElementById('prog-start').textContent = stops[0]?.datetime?.slice(0, 10) || '';
        document.getElementById('prog-end').textContent = cur.datetime?.slice(0, 10) || '';
      }
      updateLocationHud(state);
    }

    function updateTrail(prog) {
      animTimeMs = prog * (activePlayback()?.total_video_ms || 0);
      updateTrailFromState(positionAtTime(animTimeMs));
    }

    // ── Playback ──
    function animate(ts) {
      if (!isPlaying) return;
      if (!lastTs) lastTs=ts;
      const pb = activePlayback();
      if (!pb?.total_video_ms) { stopPlayback(); return; }
      animTimeMs += (ts - lastTs) * speed;
      lastTs = ts;
      if (animTimeMs >= pb.total_video_ms) {
        animTimeMs = pb.total_video_ms;
        updateTrailFromState(positionAtTime(animTimeMs));
        if (isRecording) finishRecording();
        if (loopTrip) {
          animTimeMs = 0; animStopIdx = 0;
          stopMarkers.forEach(m => { m._el.classList.remove('visible','active'); if (m._lbl) m._lbl.classList.remove('visible','active'); });
          lastTs = 0;
          if (!isRecording) { animFrame = requestAnimationFrame(animate); }
          return;
        }
        stopPlayback();
        return;
      }
      updateTrailFromState(positionAtTime(animTimeMs));
      animFrame = requestAnimationFrame(animate);
    }
    function startPlayback(forRecording=false) {
      if (!isSingleTrip()) {
        document.getElementById('prog-text').textContent = 'Select a trip first';
        return;
      }
      if (!activePlayback()?.total_video_ms) return;
      if (animTimeMs >= activePlayback().total_video_ms) { animTimeMs = 0; resetVisuals(false); drawStops(); }
      isPlaying = true; lastTs = 0;
      document.getElementById('btn-play').disabled = true;
      document.getElementById('btn-pause').disabled = false;
      document.getElementById('location-hud').classList.add('visible');
      animFrame = requestAnimationFrame(animate);
    }
    function stopPlayback() {
      isPlaying=false;
      if (animFrame) cancelAnimationFrame(animFrame);
      document.getElementById('btn-play').disabled = !isSingleTrip();
      document.getElementById('btn-pause').disabled = true;
    }
    function resetVisuals(clearHud=true) {
      stopPlayback(); animTimeMs=0; animProg=0; animStopIdx=0;
      if (vehicleMarker) { vehicleMarker.remove(); vehicleMarker=null; }
      if (map.getSource('active-trail')) map.getSource('active-trail').setData({type:'Feature',geometry:{type:'LineString',coordinates:[]}});
      stopMarkers.forEach(m=>{m._el.classList.remove('visible','active'); if (m._lbl) m._lbl.classList.remove('visible','active');});
      document.getElementById('scrubber').value=0;
      document.getElementById('scrub-fill').style.width='0%';
      document.getElementById('timeline-scrub').style.left='0%';
      document.getElementById('prog-text').textContent = isSingleTrip() ? 'Ready to replay' : 'Select a trip to replay';
      if (clearHud) document.getElementById('location-hud').classList.remove('visible');
    }

    async function exportTripVideo() {
      if (!isSingleTrip() || !map) return;
      const trip = activeTrip();
      const status = document.getElementById('export-status');
      status.textContent = 'Preparing recording…';
      status.classList.add('visible');
      resetVisuals();
      drawStops();
      fitTrip(false);
      await new Promise(r => setTimeout(r, 1600));

      document.body.classList.add('cinema-mode', 'portrait-export');
      const title = document.getElementById('cinema-title');
      document.getElementById('cinema-title-text').textContent = trip.name;
      document.getElementById('cinema-subtitle').textContent =
        `${trip.miles.toLocaleString()} mi · ${trip.stop_count} Supercharger stops · ${trip.duration_days} days`;
      title.classList.add('visible');
      map.resize();
      await new Promise(r => setTimeout(r, 500));

      const canvas = map.getCanvas();
      const stream = canvas.captureStream(30);
      recordedChunks = [];
      mediaRecorder = new MediaRecorder(stream, { mimeType: 'video/webm;codecs=vp9', videoBitsPerSecond: 8_000_000 });
      mediaRecorder.ondataavailable = e => { if (e.data.size) recordedChunks.push(e.data); };
      mediaRecorder.onstop = () => {
        const blob = new Blob(recordedChunks, { type: 'video/webm' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${trip.id}_instagram.webm`;
        a.click();
        URL.revokeObjectURL(url);
        isRecording = false;
        document.body.classList.remove('cinema-mode', 'portrait-export');
        title.classList.remove('visible');
        status.classList.remove('visible');
        map.resize();
        fitTrip(false);
      };

      isRecording = true;
      status.textContent = 'Recording trip…';
      mediaRecorder.start(250);
      startPlayback(true);
    }

    function finishRecording() {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        document.getElementById('export-status').textContent = 'Saving video…';
        mediaRecorder.stop();
      }
      stopPlayback();
    }

    // ── Select trip ──
    function selectTrip(id) {
      selectedId=id;
      dismissOnboarding();
      document.querySelectorAll('.trip-item').forEach(el=>el.classList.toggle('active',el.dataset.id===id));
      document.querySelectorAll('.tl-seg').forEach(el=>el.classList.toggle('active',el.dataset.id===id));
      resetVisuals(); drawRoutes(); drawStops(); updateHero(); fitTrip();
      setMapLabelsVisible(true);
      document.getElementById('btn-play').disabled = !isSingleTrip();
      document.getElementById('btn-export').disabled = !isSingleTrip();
    }

    // ── Night mode ──
    // Tint the canvas instead of reloading the whole base style. A full
    // setStyle() swap tore down/rebuilt every source + refetched all tiles,
    // which threw "Style is not done loading" and left dark tile gaps.
    function toggleNight() {
      nightMode=!nightMode;
      document.getElementById('btn-night').classList.toggle('on', nightMode);
      document.body.classList.toggle('night', nightMode);
    }
    document.getElementById('trip-list').addEventListener('click', e=>{
      const item=e.target.closest('.trip-item'); if(item) selectTrip(item.dataset.id);
    });
    document.getElementById('timeline-track').addEventListener('click', e=>{
      const seg=e.target.closest('.tl-seg'); if(seg) selectTrip(seg.dataset.id);
    });
    document.getElementById('btn-play').addEventListener('click', startPlayback);
    document.getElementById('btn-pause').addEventListener('click', stopPlayback);
    document.getElementById('btn-step').addEventListener('click', ()=>{
      if (!isSingleTrip()) return;
      stopPlayback();
      const pb = activePlayback();
      if (!pb) return;
      let cursor = 0, targetIdx = animStopIdx + 1;
      for (const seg of pb.segments) {
        if (seg.stop_index >= targetIdx && seg.type === 'dwell') {
          animTimeMs = cursor;
          updateTrailFromState(positionAtTime(animTimeMs));
          return;
        }
        cursor += seg.duration_ms;
      }
      animTimeMs = pb.total_video_ms;
      updateTrailFromState(positionAtTime(animTimeMs));
    });
    document.getElementById('btn-reset').addEventListener('click', ()=>{ resetVisuals(); drawStops(); fitTrip(); });
    document.getElementById('btn-loop').addEventListener('click', ()=>{
      loopTrip=!loopTrip; document.getElementById('btn-loop').classList.toggle('on', loopTrip);
    });
    document.getElementById('btn-director').addEventListener('click', ()=>{
      directorMode=!directorMode; document.getElementById('btn-director').classList.toggle('on', directorMode);
    });
    document.getElementById('btn-night').addEventListener('click', toggleNight);
    document.getElementById('speed').addEventListener('input', e=>{ speed=parseFloat(e.target.value); document.getElementById('speed-label').textContent=speed+'×'; });
    document.getElementById('scrubber').addEventListener('input', e=>{
      if (!isSingleTrip()) return;
      stopPlayback();
      const pb = activePlayback();
      if (!pb) return;
      animTimeMs = (parseInt(e.target.value)/1000) * pb.total_video_ms;
      updateTrailFromState(positionAtTime(animTimeMs));
    });
    document.getElementById('sidebar-toggle').addEventListener('click', ()=>{
      const sb=document.getElementById('sidebar');
      sb.classList.toggle('collapsed');
    });
    document.addEventListener('keydown', e=>{
      if (e.target.tagName==='INPUT') return;
      if (e.code==='Space') { e.preventDefault(); isPlaying?stopPlayback():startPlayback(); }
      if (e.code==='ArrowRight') { stopPlayback(); document.getElementById('btn-step').click(); }
      if (e.code==='ArrowLeft') { stopPlayback(); if(isSingleTrip()&&animStopIdx>0){
        const pb = activePlayback(); if (!pb) return;
        let cursor = 0, targetIdx = animStopIdx - 1;
        for (const seg of pb.segments) {
          if (seg.stop_index === targetIdx && seg.type === 'dwell') {
            animTimeMs = cursor; updateTrailFromState(positionAtTime(animTimeMs)); return;
          }
          cursor += seg.duration_ms;
        }
      }}
      if (e.code==='KeyR') document.getElementById('btn-reset').click();
      if (e.code==='KeyD') document.getElementById('btn-director').click();
    });

    document.getElementById('btn-export').addEventListener('click', exportTripVideo);
    document.getElementById('onboard-featured').addEventListener('click', startWithFeatured);
    document.getElementById('onboard-dismiss').addEventListener('click', dismissOnboarding);
    document.getElementById('onboarding').addEventListener('click', e=>{
      if (e.target.id === 'onboarding') dismissOnboarding();
    });

    document.getElementById('token-submit').addEventListener('click', ()=>{
      const t = document.getElementById('token-input').value.trim();
      if (t.startsWith('pk.')) bootMap(t);
    });
    document.getElementById('token-input').addEventListener('keydown', e=>{
      if (e.key === 'Enter') document.getElementById('token-submit').click();
    });

    // ── Timeline label: derive real year span from trip data ──
    (function setTimelineRange() {
      const years = TRIPS
        .flatMap(t => [t.start, t.end])
        .map(d => parseInt(String(d).slice(0, 4), 10))
        .filter(y => y >= 1990 && y <= 2100);
      if (!years.length) return;
      const lo = Math.min(...years), hi = Math.max(...years);
      document.getElementById('timeline-label').textContent =
        `Journey Timeline · ${lo}${hi > lo ? ' — ' + hi : ''}`;
    })();

    // ── Boot ──
    (function boot() {
      const saved = localStorage.getItem('mapbox-token');
      const token = MAPBOX_TOKEN || saved;
      if (token) {
        bootMap(token);
      } else {
        document.getElementById('splash').classList.add('hidden');
        document.getElementById('token-gate').classList.add('visible');
      }
    })();
  </script>
</body>
</html>
