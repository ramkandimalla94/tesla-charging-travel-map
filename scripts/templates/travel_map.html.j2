<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Road Replay — Tesla Trip Cinema</title>
  <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><text y='.9em' font-size='90'>⚡</text></svg>">
  <link href="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=Syne:wght@600;700;800&display=swap" rel="stylesheet">
  {% include 'travel_map/_map_css.html.j2' %}
</head>
<body>

  <!-- Token gate (shown when no token baked in at build time) -->
  <div id="token-gate">
    <div class="logo" style="font-size:48px;margin-bottom:12px">⚡</div>
    <h2>Mapbox Token Required</h2>
    <p>Paste your free <a href="https://account.mapbox.com/access-tokens/" target="_blank" rel="noopener">Mapbox public token</a> to load satellite terrain. Stored locally in your browser only.</p>
    <input type="password" id="token-input" placeholder="pk.eyJ..." autocomplete="off">
    <button class="btn primary" id="token-submit" style="padding:12px 32px">Launch Map</button>
  </div>

  <!-- Onboarding -->
  <div id="onboarding">
    <div class="onboard-card">
      <h2>Start Your Replay</h2>
      <p>Pick a journey from the trip panel — start with an <span class="highlight">Epic Road Trip</span> for the full cinematic experience with location labels and video export.</p>
      <div class="onboard-actions">
        <button class="btn gold" id="onboard-featured">🎬 Epic Trip</button>
        <button class="btn" id="onboard-dismiss">Explore Overview</button>
      </div>
    </div>
  </div>

  <!-- Splash -->
  <div id="splash">
    <div class="brand-mark">Supercharger Cinema</div>
    <h1>Road Replay</h1>
    <p>Loading terrain · {{ trips|length }} journeys · {{ "{:,}".format(dashboard.total_miles) }} miles driven</p>
    <div class="splash-bar"><div class="splash-fill" id="splash-fill"></div></div>
  </div>

  <div id="map-wrap">
    <div id="map"></div>
    <div class="map-vignette"></div>
    <div class="map-grain"></div>
  </div>

  <div class="map-legend" id="map-legend" aria-hidden="true">
    <div class="leg-row"><span class="swatch" id="legend-route-swatch"></span><span id="legend-route-label">Route</span></div>
    <div class="leg-row"><span class="pin start"></span><span>Start</span></div>
    <div class="leg-row"><span class="pin end"></span><span id="legend-end-label">Return</span></div>
  </div>

  <button type="button" class="atlas-cta" id="atlas-cta" aria-label="Replay featured epic trip">
    <span class="atlas-cta-swatch" id="atlas-cta-swatch"></span>
    <span class="atlas-cta-body">
      <div class="atlas-cta-eyebrow">Featured epic</div>
      <div class="atlas-cta-title" id="atlas-cta-title">Replay a road trip</div>
      <div class="atlas-cta-meta" id="atlas-cta-meta">Tap to focus · then Play</div>
    </span>
  </button>
  <div class="memory-badge" id="memory-badge" aria-live="polite">
    <span>Memory reel · <strong id="memory-label">—</strong></span>
    <button type="button" id="memory-pause" title="Pause memory reel">Pause</button>
  </div>

  <!-- Top bar -->
  <header class="top-bar">
    <div class="brand">ROAD<span>REPLAY</span></div>
    <div class="stat-rail">
      <div class="stat-chip">{{ dashboard.trip_count }}<strong>trips</strong></div>
      <div class="stat-chip">{{ "{:,}".format(dashboard.total_miles) }}<strong>mi</strong></div>
      <div class="stat-chip">{{ dashboard.total_kwh|int }}<strong>kWh</strong></div>
      <div class="stat-chip">{{ dashboard.states|length }}<strong>states</strong></div>
    </div>
  </header>

  <div class="location-hud" id="location-hud">
    <div class="hud-icon" id="hud-icon">🚗</div>
    <div class="hud-body">
      <div class="hud-phase" id="hud-phase">Driving</div>
      <div class="hud-text" id="hud-text"></div>
    </div>
  </div>

  <div class="story-overlay" id="story-overlay">
    <div class="story-caption" id="story-caption"></div>
    <div class="story-sub" id="story-sub"></div>
    <div class="story-pois" id="story-pois"></div>
  </div>

  <div class="cinema-title" id="cinema-title">
    <h2 id="cinema-title-text"></h2>
    <p id="cinema-subtitle"></p>
    <div class="cinema-highlights" id="cinema-highlights"></div>
  </div>
  <div class="export-status" id="export-status">Recording…</div>

  <button class="panel-toggle" id="sidebar-toggle" title="Toggle trips panel" aria-label="Toggle panel">
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
  </button>

  <aside class="trip-panel" id="sidebar">
    <div class="panel-head">
      <div class="eyebrow">Your Journeys</div>
      <h2 id="panel-title">Select a Trip</h2>
      <div class="sub" id="panel-sub">{{ dashboard.trip_count }} road trips from your Supercharger history</div>
    </div>

    <div class="trip-hero" id="hero-card">
      <div class="trip-hero-name" id="hero-name">Overview</div>
      <div class="trip-hero-via" id="hero-via">Choose a journey to begin cinematic playback.</div>
      <div class="metric-grid">
        <div class="metric"><span class="val" id="hero-miles">—</span><span class="lbl">Miles</span></div>
        <div class="metric"><span class="val" id="hero-kwh">—</span><span class="lbl">kWh</span></div>
        <div class="metric"><span class="val" id="hero-days">—</span><span class="lbl">Days</span></div>
        <div class="metric"><span class="val" id="hero-stops">—</span><span class="lbl">Stops</span></div>
      </div>
    </div>

    <div class="trip-scroll" id="trip-list">
      <div class="group-label">Overview</div>
      <div class="trip-item active" data-id="all">
        <div class="trip-swatch" style="background:linear-gradient(180deg,#c4b8a8,#e8e4dc)"></div>
        <div><div class="trip-name">Atlas · All Routes</div><div class="trip-meta">{{ trips|length }} journeys · home hubs</div></div>
      </div>
      {% set featured_trips = trips|selectattr('featured')|list %}
      {% if featured_trips %}
      <div class="group-label featured">Epic Road Trips</div>
      {% for trip in featured_trips %}
      <div class="trip-item featured" data-id="{{ trip.id }}" style="color:{{ trip.color }}">
        <div class="trip-swatch" style="background:{{ trip.color }};color:{{ trip.color }}"></div>
        <div>
          <div class="trip-name">{{ trip.name }}</div>
          <div class="trip-meta">{{ trip.miles }} mi · {{ trip.stop_count }} stops · {{ trip.duration_days }}d{% if trip.is_shared %} · {{ trip.trip_crew }}{% elif trip.vehicle_label == 'your Tesla' %} · your Tesla{% elif trip.trip_crew %} · {{ trip.trip_crew }}{% endif %}</div>
        </div>
      </div>
      {% endfor %}
      {% endif %}
      {% set dest_groups = dashboard.destination_groups or [] %}
      {% if dest_groups %}
      <div class="group-label">Destinations</div>
      {% for group in dest_groups %}
      <div class="dest-group-label">
        <span>{{ group.dest }}</span>
        <span class="meta">{{ group.trip_count }} trip{% if group.trip_count != 1 %}s{% endif %} · {{ group.total_miles }} mi</span>
      </div>
      {% for tid in group.trip_ids %}
        {% set trip = trips|selectattr('id', 'equalto', tid)|first %}
        {% if trip %}
      <div class="trip-item nested{% if trip.featured %} featured{% endif %}" data-id="{{ trip.id }}" style="color:{{ trip.color }}">
        <div class="trip-swatch" style="background:{{ trip.color }};color:{{ trip.color }}"></div>
        <div>
          <div class="trip-name">{{ trip.start }} · {{ trip.story_dest or trip.dest_label }}</div>
          <div class="trip-meta">{{ trip.miles }} mi · {{ trip.stop_count }} stops{% if trip.is_shared %} · {{ trip.trip_crew }}{% endif %}</div>
        </div>
      </div>
        {% endif %}
      {% endfor %}
      {% endfor %}
      {% else %}
      <div class="group-label">All Trips</div>
      {% for trip in trips if not trip.featured %}
      <div class="trip-item" data-id="{{ trip.id }}" style="color:{{ trip.color }}">
        <div class="trip-swatch" style="background:{{ trip.color }};color:{{ trip.color }}"></div>
        <div>
          <div class="trip-name">{{ trip.name }}</div>
          <div class="trip-meta">{{ trip.start }} · {{ trip.miles }} mi · {{ trip.stop_count }} stops{% if trip.is_shared %} · {{ trip.trip_crew }}{% elif trip.vehicle_label == 'your Tesla' %} · your Tesla{% elif trip.trip_crew %} · {{ trip.trip_crew }}{% endif %}</div>
        </div>
      </div>
      {% endfor %}
      {% endif %}
    </div>
  </aside>

  <!-- Transport dock -->
  <div class="transport-dock" id="transport-dock">
    <div class="dock-top">
      <div class="dock-info">
        <div class="dock-location" id="prog-text">Select a trip to replay</div>
        <div class="dock-sub"><span id="prog-start">—</span> → <span id="prog-end">—</span></div>
      </div>
      <div class="dock-actions">
        <button class="icon-btn" id="btn-reset" title="Reset"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M3 12a9 9 0 1 0 9-9"/><path d="M3 3v5h5"/></svg></button>
        <button class="icon-btn" id="btn-step" title="Next stop"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 4l12 8-12 8V4z"/></svg></button>
        <button class="icon-btn primary" id="btn-play" disabled title="Play"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7L8 5z"/></svg></button>
        <button class="icon-btn" id="btn-pause" disabled title="Pause"><svg viewBox="0 0 24 24" fill="currentColor"><path d="M6 5h4v14H6V5zm8 0h4v14h-4V5z"/></svg></button>
        <button class="icon-btn" id="btn-loop" title="Loop trip · click again for epic queue"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M17 1l4 4-4 4"/><path d="M3 11V9a4 4 0 0 1 4-4h14"/><path d="M7 23l-4-4 4-4"/><path d="M21 13v2a4 4 0 0 1-4 4H3"/></svg></button>
        <button class="icon-btn on" id="btn-director" title="Director camera"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="5" width="20" height="14" rx="2"/><path d="M10 9l6 3-6 3V9z"/></svg></button>
        <button class="icon-btn" id="btn-night" title="Night mode"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"/></svg></button>
        <button class="icon-btn export" id="btn-export" disabled title="Export video">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="3"/></svg>
          Export
        </button>
      </div>
    </div>
    <div class="scrub-track">
      <div class="scrub-fill" id="scrub-fill"></div>
      <input type="range" id="scrubber" min="0" max="1000" value="0">
    </div>
    <div class="dock-sliders">
      <div class="speed-wrap">
        <label>Playback speed · <span class="speed-val" id="speed-label">1×</span></label>
        <input type="range" id="speed" min="0.25" max="8" step="0.25" value="1">
      </div>
      <div style="font-size:9px;color:var(--muted);text-align:right;padding-top:14px"><kbd>Space</kbd> play · <kbd>Esc</kbd> back · <kbd>←</kbd><kbd>→</kbd> step</div>
    </div>
  </div>

  <!-- Master timeline -->
  <div class="timeline-bar">
    <div class="timeline-head">
      <div class="timeline-label" id="timeline-label">Journey Timeline</div>
      <div class="era-rail" id="era-rail" role="group" aria-label="Filter by year">
        <button type="button" class="era-chip active" data-year="all">All years</button>
        {% for year in dashboard.years or [] %}
        <button type="button" class="era-chip" data-year="{{ year }}">{{ year }}</button>
        {% endfor %}
      </div>
    </div>
    <div class="timeline-track" id="timeline-track">
      {% for seg in timeline %}
      <div class="tl-seg{% if seg.has_colorado %} featured{% endif %}"
           data-id="{{ seg.id }}" data-year="{{ seg.start[:4] if seg.start else '' }}" title="{{ seg.name }}"
           style="left:{{ seg.left_pct }}%;width:{{ seg.width_pct }}%;background:{{ seg.color }}"></div>
      {% endfor %}
      <div class="timeline-scrub" id="timeline-scrub" style="left:0%"></div>
    </div>
  </div>

  <script src="https://api.mapbox.com/mapbox-gl-js/v3.6.0/mapbox-gl.js"></script>
  <script>
    const TRIPS = {{ trips_json | safe }};
    const DASHBOARD = {{ dashboard_json | safe }};
    const HUBS = DASHBOARD.hubs || [];
    const DEST_GROUPS = DASHBOARD.destination_groups || [];
    // Public pk. token is stored base64-encoded so GitHub push protection does not
    // block gh-pages deploys (literal Mapbox tokens in commits are rejected).
    const MAPBOX_TOKEN_B64 = {{ mapbox_token_b64 | tojson }};
    const MAPBOX_TOKEN = MAPBOX_TOKEN_B64 ? atob(MAPBOX_TOKEN_B64) : "";
    const US_BOUNDS = DASHBOARD.us_bounds;
    const BASE_MS = 1600;

    let map;

    // Cache hot-path DOM nodes (playback RAF hits these every frame)
    const uiCache = Object.create(null);
    function ui(id) {
      const cached = uiCache[id];
      if (cached && cached.isConnected) return cached;
      return (uiCache[id] = document.getElementById(id));
    }
    function setPlaybackChrome(prog, label, startText, endText, endHtml) {
      const scrub = ui('scrubber');
      const fill = ui('scrub-fill');
      const tl = ui('timeline-scrub');
      const pt = ui('prog-text');
      if (scrub) scrub.value = Math.round(prog * 1000);
      if (fill) fill.style.width = (prog * 100) + '%';
      if (tl) tl.style.left = (prog * 100) + '%';
      if (label != null && pt) pt.textContent = label;
      if (startText != null) {
        const ps = ui('prog-start');
        if (ps) ps.textContent = startText;
      }
      if (endHtml != null) {
        const pe = ui('prog-end');
        if (pe) pe.innerHTML = endHtml;
      } else if (endText != null) {
        const pe = ui('prog-end');
        if (pe) pe.textContent = endText;
      }
    }

    // ── State ──
    let selectedId = 'all', animTimeMs = 0, animProg = 0, animStopIdx = 0;
    let hoveredTripId = null;
    let yearFilter = 'all';
    let eraApplying = false;
    let routeLabelMarkers = [];
    let hubMarkers = [];
    let destMarkers = [];
    let memoryTimer = null;
    let memoryIndex = 0;
    let memoryPaused = false;
    let memoryActiveId = null;
    let isPlaying = false, animFrame = null, lastTs = 0;
    let speed = 1, loopTrip = false, queueEpics = false, directorMode = true, nightMode = false;
    let isRecording = false, mediaRecorder = null, recordedChunks = [];
    let vehicleMarker = null, stopMarkers = [], poiMarkers = [];
    let poiMarkerKey = '';
    let lastDirectorMove = 0;
    let hoverRaf = null;
    let smoothBearing = 0, camBearing = 0, lastTravelBearing = 0;
    const MAX_PITCH = 45;

    const carHtml = `<div class="vehicle-wrap"><div class="vehicle-glow"></div><div class="vehicle-body"><svg viewBox="0 0 64 28" aria-hidden="true"><path class="tesla-body" d="M2 18 Q8 9 16 8 L48 8 Q56 9 62 18 L60 22 L4 22 Z"/><path class="tesla-accent" d="M18 8 L26 4 L34 8"/><circle cx="14" cy="21" r="3.2" fill="#111"/><circle cx="50" cy="21" r="3.2" fill="#111"/><path class="tesla-accent" d="M28 8 L32 6 L36 8" opacity="0.6"/></svg></div></div>`;

    // ── Splash progress ──
    function setSplash(pct) { document.getElementById('splash-fill').style.width = pct + '%'; }
    function hideSplash() {
      setSplash(100);
      setTimeout(() => {
        document.getElementById('splash').classList.add('hidden');
        showOnboarding();
      }, 400);
    }
    function showOnboarding() {
      if (localStorage.getItem('tesla-map-onboarded')) return;
      document.getElementById('onboarding').classList.add('visible');
    }
    function dismissOnboarding() {
      document.getElementById('onboarding').classList.remove('visible');
      localStorage.setItem('tesla-map-onboarded', '1');
      if (selectedId === 'all' && !memoryPaused) startMemoryReel();
    }
    function startWithFeatured() {
      const epic = TRIPS.find(t => t.featured) || TRIPS.find(t => t.has_colorado) || TRIPS[0];
      if (epic) selectTrip(epic.id);
      dismissOnboarding();
    }

    function shortLabel(location) {
      const city = (location || '').split(',')[0].trim();
      const st = (location || '').match(/,\s*([A-Z]{2})\b/);
      return st ? `${city}, ${st[1]}` : city;
    }

    function activePlayback() {
      const t = activeTrip();
      return t?.playback || null;
    }

    function playbackProgress() {
      const pb = activePlayback();
      if (!pb || !pb.total_video_ms) return 0;
      return Math.min(1, animTimeMs / pb.total_video_ms);
    }

    function smoothAngle(current, target, alpha) {
      let diff = ((target - current + 540) % 360) - 180;
      return (current + diff * alpha + 360) % 360;
    }

    function trailCoordsAtTime(elapsedMs) {
      const pb = activePlayback();
      if (!pb?.segments?.length) return [];
      let t = 0;
      const coords = [];
      for (const seg of pb.segments) {
        const segEnd = t + seg.duration_ms;
        if (seg.type === 'intro' || seg.type === 'outro') {
          if (elapsedMs >= segEnd) t = segEnd;
          continue;
        }
        if (elapsedMs >= segEnd) {
          if (seg.type === 'travel' && seg.path?.length >= 2) {
            const leg = seg.path.map(p => [p[1], p[0]]);
            if (coords.length) leg.shift();
            coords.push(...leg);
          }
          t = segEnd;
          continue;
        }
        if (seg.type === 'travel' && seg.path?.length >= 2) {
          const frac = Math.max(0, Math.min(1, (elapsedMs - t) / seg.duration_ms));
          const endIdx = Math.max(1, Math.ceil(frac * (seg.path.length - 1)));
          const leg = seg.path.slice(0, endIdx + 1).map(p => [p[1], p[0]]);
          if (coords.length) leg.shift();
          coords.push(...leg);
        }
        break;
      }
      return coords;
    }

    function positionAtTime(elapsedMs) {
      const pb = activePlayback();
      if (!pb || !pb.segments?.length) return null;
      let cursor = 0;
      for (const seg of pb.segments) {
        const end = cursor + seg.duration_ms;
        if (elapsedMs < end) {
          const frac = Math.max(0, Math.min(1, (elapsedMs - cursor) / seg.duration_ms));
          if (seg.type === 'intro') {
            return {
              phase: 'intro', label: seg.title || activeTrip()?.name || '',
              caption: seg.caption || '', highlights: seg.highlights || [],
              frac, stopIndex: 0, bearing: lastTravelBearing, seg,
            };
          }
          if (seg.type === 'outro') {
            return {
              phase: 'outro', label: 'Journey Complete',
              caption: seg.caption || '', visitedCount: seg.visited_count || 0,
              nearbyCount: seg.nearby_count || 0, frac, stopIndex: activeStops().length - 1,
              bearing: lastTravelBearing, seg,
            };
          }
          if (seg.type === 'dwell') {
            return {
              lat: seg.lat, lng: seg.lng, phase: 'dwell', label: seg.label,
              caption: seg.caption || '', subcaption: seg.subcaption || '',
              pois: seg.pois || [], stopIndex: seg.stop_index, frac,
              bearing: lastTravelBearing, seg,
            };
          }
          const path = seg.path || [];
          const pos = pointOnPath(path, frac) || { lat: path[0]?.[0], lng: path[0]?.[1] };
          const microBearing = path.length >= 2 ? pathBearing(path, frac) : (seg.bearing || 0);
          const bearing = seg.bearing != null
            ? smoothAngle(seg.bearing, microBearing, Math.min(1, frac * 3))
            : microBearing;
          return {
            ...pos, phase: 'travel', label: seg.to_label, stopIndex: seg.stop_index,
            frac, bearing, path, seg,
          };
        }
        cursor = end;
      }
      const last = pb.segments[pb.segments.length - 1];
      if (last.type === 'outro') {
        return {
          phase: 'outro', label: 'Journey Complete', caption: last.caption || '',
          visitedCount: last.visited_count || 0, nearbyCount: last.nearby_count || 0,
          frac: 1, stopIndex: activeStops().length - 1, bearing: lastTravelBearing, seg: last,
        };
      }
      return {
        lat: last.lat, lng: last.lng, phase: 'dwell', label: last.label || last.to_label,
        caption: last.caption || '', pois: last.pois || [],
        stopIndex: last.stop_index, frac: 1, bearing: lastTravelBearing, seg: last,
      };
    }

    // ── Map init ──
    function bootMap(accessToken) {
      mapboxgl.accessToken = accessToken;
      localStorage.setItem('mapbox-token', accessToken);
      document.getElementById('token-gate').classList.remove('visible');
      setSplash(20);
      map = new mapboxgl.Map({
        container: 'map',
        style: 'mapbox://styles/mapbox/satellite-streets-v12',
        center: [-105, 39], zoom: 4, pitch: 0, bearing: 0,
        antialias: true,
        maxPitch: MAX_PITCH,
        projection: 'mercator',
      });
      map.addControl(new mapboxgl.NavigationControl({ visualizePitch: true }), 'bottom-right');
      map.on('load', onMapLoad);
    }

    function onMapLoad() {
      setupTerrain();
      drawRoutes();
      drawStops();
      drawAtlasSpokes();
      updateHero();
      updateDockIdle();
      updateAtlasCta();
      setMapLabelsVisible(true);
      document.getElementById('btn-play').disabled = true;
      document.getElementById('prog-text').textContent = 'Select a trip to play';
      introFlyover();
      setTimeout(() => {
        if (selectedId === 'all' && !localStorage.getItem('tesla-map-onboarded')) return;
        if (selectedId === 'all') startMemoryReel();
      }, 2800);
    }

    function featuredTrip() {
      return TRIPS.find(t => t.featured) || TRIPS.find(t => t.has_colorado) || TRIPS[0] || null;
    }

    function nextEpicTrip(currentId) {
      const list = TRIPS.filter(t => t.featured && tripInEra(t));
      if (!list.length) return null;
      const idx = list.findIndex(t => t.id === currentId);
      return list[(idx + 1) % list.length];
    }

    function syncLoopButton() {
      const btn = document.getElementById('btn-loop');
      if (!btn) return;
      btn.classList.toggle('on', loopTrip && !queueEpics);
      btn.classList.toggle('queue', queueEpics);
      btn.title = queueEpics
        ? 'Epic queue on — plays featured trips in sequence'
        : (loopTrip ? 'Loop this trip' : 'Loop off · click for loop · again for epic queue');
    }

    function updateAtlasCta() {
      const btn = document.getElementById('atlas-cta');
      if (!btn) return;
      const epic = featuredTrip();
      if (!epic || selectedId !== 'all') {
        btn.classList.remove('visible');
        return;
      }
      document.getElementById('atlas-cta-swatch').style.background = epic.color;
      document.getElementById('atlas-cta-swatch').style.color = epic.color;
      document.getElementById('atlas-cta-title').textContent =
        (epic.name || '').split('—').pop()?.trim().replace(/\s*·.*$/, '') || epic.name;
      document.getElementById('atlas-cta-meta').textContent =
        `${epic.miles.toLocaleString()} mi · ${epic.stop_count} stops · Play after focus`;
      btn.classList.add('visible');
      btn.dataset.tripId = epic.id;
    }

    function memoryPlaylist() {
      const featured = TRIPS.filter(t => t.featured && tripInEra(t));
      return featured.length ? featured : TRIPS.filter(t => tripInEra(t)).slice(0, 6);
    }

    function stopMemoryReel() {
      if (memoryTimer) { clearInterval(memoryTimer); memoryTimer = null; }
      memoryActiveId = null;
      document.getElementById('memory-badge')?.classList.remove('visible');
      if (selectedId === 'all' && !hoveredTripId) applyEraFilter();
    }

    function showMemoryHighlight(trip) {
      if (!trip || selectedId !== 'all') return;
      memoryActiveId = trip.id;
      const label = document.getElementById('memory-label');
      if (label) label.textContent = shortTripLabel(trip);
      document.getElementById('memory-badge')?.classList.add('visible');
      TRIPS.forEach(t => {
        if (!tripInEra(t)) setRouteStyle(t.id, t.color, 'overviewDim');
        else if (t.id === trip.id) setRouteStyle(t.id, t.color, 'overviewHover');
        else setRouteStyle(t.id, t.color, 'overviewDim');
      });
      destMarkers.forEach(m => {
        const hit = (m._tripIds || []).includes(trip.id);
        m.getElement().classList.toggle('hot', hit);
        m.getElement().classList.toggle('dim', !hit);
      });
      hubMarkers.forEach(m => {
        const hit = (m._tripIds || []).includes(trip.id);
        m.getElement().classList.toggle('hot', hit);
        m.getElement().classList.toggle('dim', !hit);
      });
    }

    function startMemoryReel() {
      stopMemoryReel();
      if (selectedId !== 'all' || memoryPaused) return;
      const list = memoryPlaylist();
      if (list.length < 2) return;
      memoryIndex = 0;
      showMemoryHighlight(list[0]);
      memoryTimer = setInterval(() => {
        if (selectedId !== 'all' || memoryPaused || hoveredTripId) return;
        const items = memoryPlaylist();
        if (!items.length) return;
        memoryIndex = (memoryIndex + 1) % items.length;
        showMemoryHighlight(items[memoryIndex]);
      }, 4200);
    }

    /** Perpendicular offset (meters) for parallel corridor filaments. */
    function offsetSpokeCoords(lng1, lat1, lng2, lat2, meters) {
      const dx = lng2 - lng1, dy = lat2 - lat1;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len, ny = dx / len;
      const midLat = (lat1 + lat2) / 2;
      const dLng = (meters / 111320) / Math.max(0.2, Math.cos(midLat * Math.PI / 180));
      const dLat = meters / 110540;
      return [
        [lng1 + nx * dLng, lat1 + ny * dLat],
        [lng2 + nx * dLng, lat2 + ny * dLat],
      ];
    }

    function drawAtlasSpokes() {
      if (!map) return;
      const feats = [];
      const bands = [];
      if (selectedId === 'all') {
        DEST_GROUPS.forEach(group => {
          const visibleIds = (group.trip_ids || []).filter(id => {
            const t = TRIPS.find(x => x.id === id);
            return t && tripInEra(t);
          });
          if (!visibleIds.length) return;
          // Attach spoke to the hub that owns most of this destination's trips
          const hubScore = {};
          visibleIds.forEach(id => {
            const t = TRIPS.find(x => x.id === id);
            const hub = t?.start_hub || 'Home';
            hubScore[hub] = (hubScore[hub] || 0) + 1;
          });
          const hubLabel = Object.entries(hubScore).sort((a, b) => b[1] - a[1])[0]?.[0];
          const hub = HUBS.find(h => h.label === hubLabel) || HUBS[0];
          if (!hub || group.lat == null || group.lng == null) return;
          const visits = visibleIds.length;
          const a = [hub.lng, hub.lat], b = [group.lng, group.lat];
          // Soft corridor band behind the dashed spoke (wider for repeat destinations)
          bands.push({
            type: 'Feature',
            properties: { color: group.color, dest: group.dest, visits },
            geometry: { type: 'LineString', coordinates: [a, b] },
          });
          feats.push({
            type: 'Feature',
            properties: { color: group.color, dest: group.dest, visits, role: 'core' },
            geometry: { type: 'LineString', coordinates: [a, b] },
          });
          // Multi-visit destinations: fan parallel filaments so the corridor reads as a band
          if (visits >= 2) {
            const spacing = Math.min(28000, 9000 + visits * 3500);
            const sides = visits >= 4 ? [-1, 1, -0.5, 0.5] : [-1, 1];
            sides.forEach((s, i) => {
              feats.push({
                type: 'Feature',
                properties: { color: group.color, dest: group.dest, visits, role: 'filament' },
                geometry: {
                  type: 'LineString',
                  coordinates: offsetSpokeCoords(a[0], a[1], b[0], b[1], s * spacing * (1 + (i % 2) * 0.15)),
                },
              });
            });
          }
        });
      }
      const data = { type: 'FeatureCollection', features: feats };
      const bandData = { type: 'FeatureCollection', features: bands };
      const vis = selectedId === 'all' ? 'visible' : 'none';
      if (map.getSource('atlas-spokes')) {
        map.getSource('atlas-spokes').setData(data);
        map.getSource('atlas-spokes-band')?.setData(bandData);
        map.setLayoutProperty('atlas-spokes-line', 'visibility', vis);
        if (map.getLayer('atlas-spokes-band')) map.setLayoutProperty('atlas-spokes-band', 'visibility', vis);
        return;
      }
      map.addSource('atlas-spokes-band', { type: 'geojson', data: bandData });
      map.addSource('atlas-spokes', { type: 'geojson', data });
      const beforeId = (map.getStyle().layers || []).find(l => /^route-.*-casing$/.test(l.id))?.id;
      const bandLayer = {
        id: 'atlas-spokes-band',
        type: 'line',
        source: 'atlas-spokes-band',
        layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
        paint: {
          'line-color': ['get', 'color'],
          'line-width': [
            'interpolate', ['linear'], ['get', 'visits'],
            1, 6, 2, 10, 4, 16, 8, 22,
          ],
          'line-opacity': 0.14,
          'line-blur': 2.5,
        },
      };
      const layer = {
        id: 'atlas-spokes-line',
        type: 'line',
        source: 'atlas-spokes',
        layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
        paint: {
          'line-color': ['get', 'color'],
          'line-width': [
            'match', ['get', 'role'],
            'filament', 0.85,
            1.35,
          ],
          'line-opacity': [
            'match', ['get', 'role'],
            'filament', 0.18,
            0.32,
          ],
          'line-dasharray': [1.2, 1.8],
        },
      };
      try {
        if (beforeId) {
          map.addLayer(bandLayer, beforeId);
          map.addLayer(layer, beforeId);
        } else {
          map.addLayer(bandLayer);
          map.addLayer(layer);
        }
      } catch (_) {
        try { map.addLayer(bandLayer); } catch (__) {}
        try { map.addLayer(layer); } catch (__) {}
      }
    }

    // ── Helpers ──
    function isSingleTrip() { return selectedId !== 'all'; }
    function activeTrips() { return isSingleTrip() ? TRIPS.filter(t => t.id === selectedId) : TRIPS; }
    function activeTrip() { return isSingleTrip() ? TRIPS.find(t => t.id === selectedId) : null; }
    function activeStops() { return activeTrips().flatMap(t => t.stops.map((s,i) => ({...s, tripColor: t.color, tripId: t.id, stopNum: i+1}))); }
    function activePath() {
      if (!isSingleTrip()) return [];
      const t = activeTrip();
      return t ? (t.route_path || []) : [];
    }
    function lerp(a,b,t) { return a+(b-a)*t; }
    function pointOnPath(path, prog) {
      if (!path.length) return null;
      if (prog <= 0) return {lat:path[0][0], lng:path[0][1]};
      if (prog >= 1) return {lat:path[path.length-1][0], lng:path[path.length-1][1]};
      const ex = prog*(path.length-1), idx = Math.floor(ex), frac = ex-idx;
      const a=path[idx], b=path[Math.min(idx+1,path.length-1)];
      return {lat:lerp(a[0],b[0],frac), lng:lerp(a[1],b[1],frac)};
    }
    function pathBearing(path, prog) {
      const ex = prog*(path.length-1), idx = Math.min(Math.floor(ex), path.length-2);
      const a=path[idx], b=path[idx+1];
      const dLng=(b[1]-a[1])*Math.PI/180, lat1=a[0]*Math.PI/180, lat2=b[0]*Math.PI/180;
      const y=Math.sin(dLng)*Math.cos(lat2), x=Math.cos(lat1)*Math.sin(lat2)-Math.sin(lat1)*Math.cos(lat2)*Math.cos(dLng);
      return (Math.atan2(y,x)*180/Math.PI+360)%360;
    }
    function findStopIdx(stops, path, prog) {
      const pos = pointOnPath(path, prog); if (!pos||!stops.length) return 0;
      let best=0, bestD=Infinity;
      stops.forEach((s,i)=>{ const d=(s.lat-pos.lat)**2+(s.lng-pos.lng)**2; if(d<bestD){bestD=d;best=i;} });
      return best;
    }
    function popupHtml(s) {
      const dt = new Date(s.datetime).toLocaleString('en-US',{dateStyle:'medium',timeStyle:'short'});
      let h=`<b>${s.location}</b><br>${dt}<br><strong>${s.kwh} kWh</strong>`;
      if(s.in_colorado) h+='<br>🏔 Colorado';
      if(s.invoice_url) h+=`<br><a href="${s.invoice_url}" target="_blank" style="color:#60a5fa">Invoice →</a>`;
      return h;
    }
    function hexToRgb(hex) {
      const r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);
      return [r,g,b];
    }

    function routeLayerIds(tripId) {
      const base = `route-${tripId}`;
      return {
        src: base,
        casing: `${base}-casing`,
        halo: `${base}-halo`,
        glowOuter: `${base}-glow-outer`,
        glowMid: `${base}-glow-mid`,
        core: `${base}-core`,
        highlight: `${base}-highlight`,
      };
    }

    function zoomWidth(stops) {
      // Zoom-aware widths so routes stay readable on satellite at every scale.
      return ['interpolate', ['linear'], ['zoom'], ...stops];
    }

    function addRouteLayers(tripId, coords, color, visible, overviewOffset, overviewDash) {
      const ids = routeLayerIds(tripId);
      const vis = visible ? 'visible' : 'none';
      const feature = { type: 'Feature', geometry: { type: 'LineString', coordinates: coords } };
      if (!map.getSource(ids.src)) {
        map.addSource(ids.src, { type: 'geojson', lineMetrics: true, data: feature });
        map.addLayer({
          id: ids.casing, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-color': '#03050a',
            'line-width': zoomWidth([3, 7, 5, 14, 8, 22]),
            'line-opacity': 0.9,
          },
        });
        // White halo between dark casing and color — max contrast on satellite
        map.addLayer({
          id: ids.halo, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-color': '#ffffff',
            'line-width': zoomWidth([3, 5, 5, 10, 8, 16]),
            'line-opacity': 0.55,
          },
        });
        map.addLayer({
          id: ids.glowOuter, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-color': color,
            'line-width': zoomWidth([3, 5, 5, 9, 8, 14]),
            'line-opacity': 0.45,
            'line-blur': 2.2,
          },
        });
        map.addLayer({
          id: ids.glowMid, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-color': color,
            'line-width': zoomWidth([3, 3.2, 5, 5.5, 8, 9]),
            'line-opacity': 0.95,
            'line-blur': 0.1,
          },
        });
        map.addLayer({
          id: ids.core, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-width': zoomWidth([3, 2.4, 5, 4.2, 8, 6.5]),
            'line-color': color,
            'line-opacity': 1,
          },
        });
        map.addLayer({
          id: ids.highlight, type: 'line', source: ids.src,
          layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
          paint: {
            'line-color': '#ffffff',
            'line-width': zoomWidth([3, 0.8, 5, 1.4, 8, 2]),
            'line-opacity': 0.85,
          },
        });
        [ids.halo, ids.glowOuter, ids.glowMid, ids.core, ids.highlight].forEach(id => {
          try { map.setPaintProperty(id, 'line-emissive-strength', 1); } catch (_) {}
        });
      } else {
        map.getSource(ids.src).setData(feature);
        [ids.casing, ids.halo, ids.glowOuter, ids.glowMid, ids.core, ids.highlight].forEach(id => {
          map.setLayoutProperty(id, 'visibility', vis);
        });
        map.setPaintProperty(ids.glowOuter, 'line-color', color);
        map.setPaintProperty(ids.glowMid, 'line-color', color);
        map.setPaintProperty(ids.core, 'line-color', color);
      }
      map._tripRouteMeta = map._tripRouteMeta || {};
      map._tripRouteMeta[tripId] = { offset: overviewOffset || 0, dash: overviewDash || null, color };
    }

    function setRouteStyle(tripId, color, mode) {
      const ids = routeLayerIds(tripId);
      if (!map.getLayer(ids.core)) return;
      const meta = (map._tripRouteMeta && map._tripRouteMeta[tripId]) || { offset: 0, dash: null };
      const isHover = hoveredTripId === tripId && selectedId === 'all';
      const styles = {
        overview: {
          casing: 0.55, halo: 0.28, outer: 0.28, mid: 0.8, coreOp: 1, hi: 0.5,
          coreW: zoomWidth([3, 1.8, 5, 3, 8, 4.5]),
          casingW: zoomWidth([3, 5, 5, 9, 8, 13]),
          haloW: zoomWidth([3, 3.4, 5, 6.5, 8, 10]),
          offset: meta.offset, dash: meta.dash,
        },
        overviewHover: {
          casing: 0.9, halo: 0.55, outer: 0.6, mid: 1, coreOp: 1, hi: 0.95,
          coreW: zoomWidth([3, 2.8, 5, 4.5, 8, 6.5]),
          casingW: zoomWidth([3, 7, 5, 12, 8, 17]),
          haloW: zoomWidth([3, 5, 5, 9, 8, 13]),
          offset: meta.offset, dash: null,
        },
        overviewDim: {
          casing: 0.15, halo: 0.06, outer: 0.06, mid: 0.2, coreOp: 0.4, hi: 0.1,
          coreW: zoomWidth([3, 1.1, 5, 1.8, 8, 2.5]),
          casingW: zoomWidth([3, 3, 5, 5, 8, 7]),
          haloW: zoomWidth([3, 2, 5, 3.5, 8, 5]),
          offset: meta.offset, dash: meta.dash,
        },
        active: {
          casing: 0.95, halo: 0.7, outer: 0.7, mid: 1, coreOp: 1, hi: 1,
          coreW: zoomWidth([3, 3.5, 5, 6, 8, 9]),
          casingW: zoomWidth([3, 10, 5, 16, 8, 24]),
          haloW: zoomWidth([3, 7, 5, 12, 8, 18]),
          offset: 0, dash: null,
        },
        playback: {
          casing: 0.45, halo: 0.25, outer: 0.25, mid: 0.45, coreOp: 0.65, hi: 0.35,
          coreW: zoomWidth([3, 1.8, 5, 3, 8, 4]),
          casingW: zoomWidth([3, 5, 5, 8, 8, 12]),
          haloW: zoomWidth([3, 3.5, 5, 6, 8, 9]),
          offset: 0, dash: null,
        },
        hidden: {
          casing: 0, halo: 0, outer: 0, mid: 0, coreOp: 0, hi: 0,
          coreW: 0, casingW: 0, haloW: 0, offset: 0, dash: null,
        },
      };
      let key = mode;
      if (mode === 'overview') {
        if (hoveredTripId && isHover) key = 'overviewHover';
        else if (hoveredTripId && !isHover) key = 'overviewDim';
      }
      const s = styles[key] || styles.hidden;
      map.setPaintProperty(ids.casing, 'line-opacity', s.casing);
      map.setPaintProperty(ids.halo, 'line-opacity', s.halo);
      map.setPaintProperty(ids.glowOuter, 'line-opacity', s.outer);
      map.setPaintProperty(ids.glowMid, 'line-opacity', s.mid);
      map.setPaintProperty(ids.core, 'line-opacity', s.coreOp);
      map.setPaintProperty(ids.core, 'line-width', s.coreW);
      map.setPaintProperty(ids.casing, 'line-width', s.casingW);
      map.setPaintProperty(ids.halo, 'line-width', s.haloW);
      map.setPaintProperty(ids.core, 'line-color', color);
      map.setPaintProperty(ids.highlight, 'line-opacity', s.hi);
      map.setPaintProperty(ids.glowOuter, 'line-color', color);
      map.setPaintProperty(ids.glowMid, 'line-color', color);
      try {
        [ids.casing, ids.halo, ids.glowOuter, ids.glowMid, ids.core, ids.highlight].forEach(id => {
          map.setPaintProperty(id, 'line-offset', s.offset || 0);
        });
      } catch (_) {}
      try {
        const dash = s.dash;
        [ids.core, ids.glowMid].forEach(id => {
          if (dash) map.setPaintProperty(id, 'line-dasharray', dash);
          else map.setPaintProperty(id, 'line-dasharray', [1, 0]);
        });
      } catch (_) {}
    }

    function ensureTrailLayers(color) {
      if (map.getSource('active-trail')) {
        map.setPaintProperty('active-trail-glow', 'line-color', color);
        return;
      }
      map.addSource('active-trail', { type: 'geojson', lineMetrics: true, data: { type: 'Feature', geometry: { type: 'LineString', coordinates: [] } } });
      map.addLayer({
        id: 'active-trail-casing', type: 'line', source: 'active-trail',
        paint: {
          'line-color': '#05070c',
          'line-width': zoomWidth([4, 8, 6, 14, 9, 20]),
          'line-opacity': 0.85,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-shadow', type: 'line', source: 'active-trail',
        paint: { 'line-color': '#000', 'line-width': 22, 'line-opacity': 0.3, 'line-blur': 8 },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-glow', type: 'line', source: 'active-trail',
        paint: {
          'line-color': color,
          'line-width': zoomWidth([4, 6, 6, 11, 9, 16]),
          'line-opacity': 0.7,
          'line-blur': 3,
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-line', type: 'line', source: 'active-trail',
        paint: {
          'line-width': zoomWidth([4, 3, 6, 5, 9, 7]),
          'line-gradient': ['interpolate', ['linear'], ['line-progress'], 0, color, 0.7, '#ffffff', 1, '#ffffff'],
        },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      map.addLayer({
        id: 'active-trail-head', type: 'line', source: 'active-trail',
        paint: { 'line-color': '#ffffff', 'line-width': 1.4, 'line-opacity': 1 },
        layout: { 'line-cap': 'round', 'line-join': 'round' },
      });
      ['active-trail-glow', 'active-trail-line', 'active-trail-head'].forEach(id => {
        try { map.setPaintProperty(id, 'line-emissive-strength', 1); } catch (_) {}
      });
    }

    // ── Terrain (subtle — routes use Mapbox line layers on surface) ──
    function setupTerrain() {
      setSplash(50);
      if (!map.getSource('mapbox-dem')) {
        map.addSource('mapbox-dem', { type:'raster-dem', url:'mapbox://mapbox.mapbox-terrain-dem-v1', tileSize:512, maxzoom:14 });
      }
      map.setTerrain({ source:'mapbox-dem', exaggeration: 0.55 });
      setSplash(70);
    }

    let mapLabelLayerIds = null;
    function setMapLabelsVisible(visible) {
      if (!map || !map.isStyleLoaded()) return;
      if (!mapLabelLayerIds) {
        mapLabelLayerIds = map.getStyle().layers
          .filter(layer => layer.type === 'symbol' && layer.layout && layer.layout['text-field'])
          .map(layer => layer.id);
      }
      const vis = visible ? 'visible' : 'none';
      mapLabelLayerIds.forEach(id => {
        try { map.setLayoutProperty(id, 'visibility', vis); } catch (_) {}
      });
    }

    // ── Premium route rendering ──
    function drawRoutes() {
      TRIPS.forEach(trip => {
        const coords = (trip.route_path || []).map(p => [p[1], p[0]]);
        const isSelected = selectedId === trip.id;
        const isOverview = selectedId === 'all';
        const visible = isOverview || isSelected;
        addRouteLayers(trip.id, coords, trip.color, visible, trip.overview_offset, trip.overview_dash);
        if (!visible) setRouteStyle(trip.id, trip.color, 'hidden');
        else if (isSelected) setRouteStyle(trip.id, trip.color, 'active');
        else setRouteStyle(trip.id, trip.color, 'overview');
      });
      drawRouteLabels();
    }

    function tripInEra(trip) {
      if (yearFilter === 'all' || yearFilter == null) return true;
      const y = String(trip.start || '').slice(0, 4);
      return y === String(yearFilter);
    }

    function applyEraFilter() {
      if (eraApplying) return;
      eraApplying = true;
      try {
        document.querySelectorAll('.era-chip').forEach(el => {
          el.classList.toggle('active', el.dataset.year === String(yearFilter));
        });
        document.querySelectorAll('.trip-item').forEach(el => {
          if (el.dataset.id === 'all') { el.classList.remove('era-dim'); return; }
          const trip = TRIPS.find(t => t.id === el.dataset.id);
          el.classList.toggle('era-dim', !!(trip && !tripInEra(trip)));
        });
        document.querySelectorAll('.tl-seg').forEach(el => {
          const y = el.dataset.year || '';
          el.classList.toggle('era-dim', yearFilter !== 'all' && y !== String(yearFilter));
        });
        if (selectedId === 'all' && map) {
          TRIPS.forEach(t => {
            if (!map.getLayer(`route-core-${t.id}`)) return;
            if (!tripInEra(t)) setRouteStyle(t.id, t.color, 'overviewDim');
            else setRouteStyle(t.id, t.color, 'overview');
          });
          drawRouteLabels();
          drawAtlasMarkers();
          if (!memoryPaused && !memoryTimer && !hoveredTripId) startMemoryReel();
        }
      } finally {
        eraApplying = false;
      }
    }

    function setYearFilter(year) {
      yearFilter = year === 'all' ? 'all' : String(year);
      applyEraFilter();
    }

    function clearDestMarkers() {
      destMarkers.forEach(m => m.remove());
      destMarkers = [];
    }

    function drawDestinationConstellation() {
      clearDestMarkers();
      if (selectedId !== 'all' || !DEST_GROUPS.length) return;
      DEST_GROUPS.forEach(group => {
        const visibleIds = (group.trip_ids || []).filter(id => {
          const t = TRIPS.find(x => x.id === id);
          return t && tripInEra(t);
        });
        if (!visibleIds.length) return;
        // Skip pure home-name destinations that sit on hubs (rare); keep relocate Bellevue.
        const el = document.createElement('div');
        el.className = 'dest-star';
        el.style.color = group.color;
        const count = visibleIds.length;
        el.innerHTML = `<div class="dest-star-core"><span>${count > 1 ? count : ''}</span></div>`
          + `<div class="dest-star-label">${group.dest}</div>`;
        el.title = `${group.dest} · ${count} trip${count === 1 ? '' : 's'} · ${group.total_miles} mi`;
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const preferred = visibleIds
            .map(id => TRIPS.find(t => t.id === id))
            .find(t => t?.featured) || TRIPS.find(t => t.id === visibleIds[0]);
          if (preferred) selectTrip(preferred.id);
        });
        el.addEventListener('mouseenter', () => {
          hoveredTripId = null;
          visibleIds.forEach(id => {
            const t = TRIPS.find(x => x.id === id);
            if (t) setRouteStyle(t.id, t.color, 'overviewHover');
          });
          TRIPS.forEach(t => {
            if (!visibleIds.includes(t.id) && tripInEra(t)) setRouteStyle(t.id, t.color, 'overviewDim');
          });
          destMarkers.forEach(m => {
            const ids = m._tripIds || [];
            const hit = ids.some(id => visibleIds.includes(id));
            m.getElement().classList.toggle('hot', hit);
            m.getElement().classList.toggle('dim', !hit);
          });
        });
        el.addEventListener('mouseleave', () => {
          if (eraApplying) return;
          applyEraFilter();
        });
        const m = new mapboxgl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat([group.lng, group.lat])
          .addTo(map);
        m._tripIds = visibleIds;
        destMarkers.push(m);
      });
    }

    function drawAtlasMarkers() {
      drawHomeHubs();
      drawDestinationConstellation();
      drawAtlasSpokes();
    }

    function shortTripLabel(trip) {
      if (trip.story_dest) return String(trip.story_dest).slice(0, 36);
      const raw = (trip.name || '').split('—').pop()?.trim() || trip.name || '';
      return raw.replace(/\s*·.*$/, '').slice(0, 42);
    }

    function isPanelCollapsed() {
      return document.getElementById('sidebar')?.classList.contains('collapsed');
    }

    function setPanelCollapsed(collapsed) {
      const sb = document.getElementById('sidebar');
      if (!sb) return;
      sb.classList.toggle('collapsed', !!collapsed);
    }

    function mapCameraPadding() {
      const w = map?.getContainer()?.clientWidth || window.innerWidth || 1200;
      const h = map?.getContainer()?.clientHeight || window.innerHeight || 800;
      const leftNeed = (!isPanelCollapsed() && w > 640)
        ? Math.min(360, Math.floor(w * 0.34))
        : (w <= 640 ? 24 : 48);
      const bottomNeed = document.body.classList.contains('watching')
        ? Math.min(120, Math.floor(h * 0.16))
        : Math.min(200, Math.floor(h * 0.28));
      return {
        top: Math.min(88, Math.floor(h * 0.1)),
        bottom: bottomNeed,
        left: leftNeed,
        right: Math.min(48, Math.floor(w * 0.06)),
      };
    }

    function setWatching(on) {
      if (isRecording) return;
      document.body.classList.toggle('watching', !!on);
      if (!on) {
        document.getElementById('cinema-title')?.classList.remove('visible');
      }
    }

    function showWatchTitleCard(trip, phase, state) {
      const title = document.getElementById('cinema-title');
      if (!title || isRecording) return;
      if (phase === 'intro') {
        document.getElementById('cinema-title-text').textContent = trip?.name || state?.label || '';
        document.getElementById('cinema-subtitle').textContent = state?.caption
          || (trip ? `${trip.miles.toLocaleString()} mi · ${trip.stop_count} stops · ${trip.duration_days}d` : '');
        const hlEl = document.getElementById('cinema-highlights');
        hlEl.innerHTML = (state?.highlights || trip?.story?.highlights || []).slice(0, 4)
          .map(h => `<span>${h}</span>`).join('');
        title.classList.add('visible');
      } else if (phase === 'outro') {
        document.getElementById('cinema-title-text').textContent = 'Journey Complete';
        document.getElementById('cinema-subtitle').textContent = state?.caption || '';
        document.getElementById('cinema-highlights').innerHTML = '';
        title.classList.add('visible');
      } else {
        title.classList.remove('visible');
      }
    }

    function drawRouteLabels() {
      routeLabelMarkers.forEach(m => m.remove());
      routeLabelMarkers = [];
      if (selectedId !== 'all') return;
      // Constellation owns idle labeling; chips only appear on trip hover.
      if (!hoveredTripId) return;
      const trip = TRIPS.find(t => t.id === hoveredTripId);
      if (!trip || !tripInEra(trip)) return;
      const lat = trip.label_lat ?? trip.stops?.[Math.floor((trip.stops?.length || 1) / 2)]?.lat;
      const lng = trip.label_lng ?? trip.stops?.[Math.floor((trip.stops?.length || 1) / 2)]?.lng;
      if (lat == null || lng == null) return;
      const el = document.createElement('div');
      el.className = 'route-chip visible';
      el.innerHTML = `<span class="dot" style="background:${trip.color}"></span>${shortTripLabel(trip)}`;
      const m = new mapboxgl.Marker({ element: el, anchor: 'bottom' })
        .setLngLat([lng, lat])
        .addTo(map);
      routeLabelMarkers.push(m);
    }

    function setHoveredTrip(id) {
      if (hoveredTripId === id) return;
      hoveredTripId = id;
      document.querySelectorAll('.trip-item').forEach(el => {
        el.classList.toggle('preview', !!id && el.dataset.id === id);
      });
      hubMarkers.forEach(m => {
        const ids = m._tripIds || [];
        m.getElement().classList.toggle('dim', !!id && !ids.includes(id));
        m.getElement().classList.toggle('hot', !!id && ids.includes(id));
      });
      destMarkers.forEach(m => {
        const ids = m._tripIds || [];
        m.getElement().classList.toggle('dim', !!id && !ids.includes(id));
        m.getElement().classList.toggle('hot', !!id && ids.includes(id));
      });
      if (selectedId !== 'all') return;
      if (id) {
        // User browsing — pause reel highlight takeover
        document.getElementById('memory-badge')?.classList.remove('visible');
      } else if (!memoryPaused && memoryTimer) {
        const list = memoryPlaylist();
        const trip = list[memoryIndex % Math.max(list.length, 1)];
        if (trip) showMemoryHighlight(trip);
      }
      if (hoverRaf) cancelAnimationFrame(hoverRaf);
      hoverRaf = requestAnimationFrame(() => {
        hoverRaf = null;
        TRIPS.forEach(t => {
          if (!tripInEra(t)) setRouteStyle(t.id, t.color, 'overviewDim');
          else setRouteStyle(t.id, t.color, 'overview');
        });
        drawRouteLabels();
      });
    }

    function isSameHomeTrip(trip) {
      if (!trip?.stops?.length) return false;
      const start = trip.stops[0];
      const end = trip.stops[trip.stops.length - 1];
      return trip.stops.length > 1
        && Math.abs(start.lat - end.lat) < 0.02
        && Math.abs(start.lng - end.lng) < 0.02;
    }

    /** Pixel offsets so round-trip home start/return stay readable at any zoom. */
    function milestoneMarkerOffset(sameHome, isStart, isEnd, geoSepDeg) {
      if (!sameHome) return [0, 0];
      // When outbound/inbound share a corridor, lean on larger pixel separation.
      const tight = geoSepDeg != null && geoSepDeg < 0.035;
      if (isStart) return tight ? [-72, -46] : [-30, -36];
      if (isEnd) return tight ? [72, 42] : [30, 32];
      return [0, 0];
    }

    /** Walk the driving path until far enough from home (and the other endpoint). */
    function endpointLngLat(trip, isStart, isEnd, otherLngLat) {
      const stop = isStart ? trip.stops[0] : trip.stops[trip.stops.length - 1];
      const path = trip.route_path || [];
      if (!isSameHomeTrip(trip) || path.length < 6) return [stop.lng, stop.lat];
      const minFromHome = 0.04; // ~4.5km
      const minFromOther = 0.035;
      const farEnough = (lng, lat) => {
        if (Math.hypot(lng - stop.lng, lat - stop.lat) < minFromHome) return false;
        if (otherLngLat && Math.hypot(lng - otherLngLat[0], lat - otherLngLat[1]) < minFromOther) return false;
        return true;
      };
      if (isStart) {
        for (let i = 1; i < path.length; i++) {
          const lat = path[i][0], lng = path[i][1];
          if (farEnough(lng, lat)) return [lng, lat];
        }
      } else if (isEnd) {
        for (let i = path.length - 2; i >= 0; i--) {
          const lat = path[i][0], lng = path[i][1];
          if (farEnough(lng, lat)) return [lng, lat];
        }
      }
      return [stop.lng, stop.lat];
    }

    function cityOnly(location) {
      return (location || '').split(',')[0].trim() || shortLabel(location);
    }

    function setMilestoneLabel(el, role, location) {
      if (!el) return;
      el.innerHTML = `<span class="role">${role}</span><span class="place">${cityOnly(location)}</span>`;
    }

    // ── Beacon markers ──
    function applyIdleStopVisuals() {
      if (!isSingleTrip() || isPlaying) return;
      const stops = activeStops();
      const lastIdx = stops.length - 1;
      stopMarkers.forEach(m => {
        const isStart = m._idx === 0;
        const isEnd = m._idx === lastIdx;
        // Show the whole journey at rest — not only the stacked home pin.
        m._el.classList.toggle('visible', true);
        m._el.classList.remove('active');
        if (m._lbl) {
          m._lbl.classList.toggle('visible', isStart || isEnd);
          m._lbl.classList.remove('active');
        }
      });
    }

    function clearHubMarkers() {
      hubMarkers.forEach(m => m.remove());
      hubMarkers = [];
    }

    function drawHomeHubs() {
      clearHubMarkers();
      if (selectedId !== 'all' || !HUBS.length) return;
      HUBS.forEach(hub => {
        const visibleIds = (hub.trip_ids || []).filter(id => {
          const t = TRIPS.find(x => x.id === id);
          return t && tripInEra(t);
        });
        if (!visibleIds.length) return;
        const el = document.createElement('div');
        el.className = 'home-hub';
        el.innerHTML = `<div class="home-hub-core">${visibleIds.length}</div>`
          + `<div class="home-hub-label">${hub.label}<span>· home</span></div>`;
        el.addEventListener('click', (e) => {
          e.stopPropagation();
          const epic = visibleIds.map(id => TRIPS.find(t => t.id === id)).find(t => t?.featured);
          const pick = epic || TRIPS.find(t => t.id === visibleIds[0]);
          if (pick) selectTrip(pick.id);
        });
        el.addEventListener('mouseenter', () => {
          if (visibleIds.length === 1) setHoveredTrip(visibleIds[0]);
        });
        el.addEventListener('mouseleave', () => setHoveredTrip(null));
        const m = new mapboxgl.Marker({ element: el, anchor: 'bottom' })
          .setLngLat([hub.lng, hub.lat])
          .addTo(map);
        m._tripIds = visibleIds;
        hubMarkers.push(m);
      });
    }

    function drawStops() {
      stopMarkers.forEach(m => m.remove()); stopMarkers = [];
      clearHubMarkers();
      clearDestMarkers();
      const single = isSingleTrip();
      if (!single) {
        drawAtlasMarkers();
        applyIdleStopVisuals();
        return;
      }
      activeTrips().forEach(trip => {
        const lastIdx = trip.stops.length - 1;
        const indices = trip.stops.map((_, i) => i);
        const sameHome = isSameHomeTrip(trip);
        const startLngLat = sameHome ? endpointLngLat(trip, true, false, null) : null;
        const endLngLat = sameHome ? endpointLngLat(trip, false, true, startLngLat) : null;
        const homeGeoSep = (startLngLat && endLngLat)
          ? Math.hypot(endLngLat[0] - startLngLat[0], endLngLat[1] - startLngLat[1])
          : null;
        indices.forEach(i => {
          const s = trip.stops[i];
          const wrap = document.createElement('div');
          wrap.className = 'beacon-wrap';
          const isStart = i === 0;
          const isEnd = i === lastIdx;
          const isMilestone = isStart || isEnd;
          if (sameHome && isStart) wrap.classList.add('split-start');
          if (sameHome && isEnd) wrap.classList.add('split-end');
          const beacon = document.createElement('div');
          beacon.className = 'beacon' + (isMilestone ? ` milestone ${isStart ? 'start' : 'end'}` : ' waypoint');
          beacon.style.setProperty('--beacon-glow', trip.color + '88');
          const coreText = isStart ? '▶' : (isEnd ? '◆' : '');
          beacon.innerHTML = `<div class="beacon-ring"></div><div class="beacon-core" style="background:${trip.color}">${coreText}</div>`;
          const lbl = document.createElement('div');
          lbl.className = 'beacon-label';
          if (sameHome && isStart) setMilestoneLabel(lbl, 'Start', s.location);
          else if (sameHome && isEnd) setMilestoneLabel(lbl, 'Return', s.location);
          else if (isStart) setMilestoneLabel(lbl, 'Start', s.location);
          else if (isEnd) setMilestoneLabel(lbl, 'Finish', s.location);
          else lbl.textContent = shortLabel(s.location);
          wrap.appendChild(beacon);
          if (isMilestone) wrap.appendChild(lbl);
          let lngLat = [s.lng, s.lat];
          if (isMilestone && sameHome) lngLat = isStart ? startLngLat : endLngLat;
          const pixelOffset = milestoneMarkerOffset(sameHome, isStart, isEnd, homeGeoSep);
          const m = new mapboxgl.Marker({
            element: wrap,
            anchor: 'bottom',
            offset: pixelOffset,
          })
            .setLngLat(lngLat)
            .setPopup(new mapboxgl.Popup({ offset: 14, maxWidth: '280px' }).setHTML(popupHtml(s)))
            .addTo(map);
          m._idx = i; m._el = beacon; m._lbl = isMilestone ? lbl : null; m._stop = s;
          m._isMilestone = isMilestone;
          m._sameHome = sameHome;
          stopMarkers.push(m);
        });
      });
      applyIdleStopVisuals();
    }

    // ── Hero card ──
    function updateHero() {
      const trips = activeTrips();
      const card = document.getElementById('hero-card');
      const viaEl = document.getElementById('hero-via');
      const panelTitle = document.getElementById('panel-title');
      if (selectedId === 'all') {
        panelTitle.textContent = 'Atlas';
        document.getElementById('hero-name').textContent = 'Lifetime Overview';
        const hubBits = (HUBS || []).map(h => `${h.label} (${h.trip_count})`).join(' · ');
        viaEl.innerHTML = hubBits
          ? `Home hubs: <em>${hubBits}</em> — pick an Epic or destination to replay.`
          : 'Select an <em>Epic Road Trip</em> for cinematic replay and video export.';
        document.getElementById('hero-miles').textContent = DASHBOARD.total_miles.toLocaleString();
        document.getElementById('hero-kwh').textContent = DASHBOARD.total_kwh.toLocaleString();
        document.getElementById('hero-days').textContent = TRIPS.length;
        document.getElementById('hero-stops').textContent = TRIPS.reduce((s, t) => s + t.stop_count, 0);
        card.classList.remove('featured');
      } else {
        const t = trips[0];
        panelTitle.textContent = t.name.split('—').pop()?.trim() || t.name;
        document.getElementById('hero-name').textContent = t.name;
        const ownerBit = t.is_shared
          ? ` · <em>${t.trip_crew} in ${t.vehicle_label || "shared car"}</em>`
          : (t.vehicle_label === 'your Tesla'
            ? ` · <em>your Tesla</em>`
            : (t.trip_crew ? ` · <em>${t.trip_crew}</em>` : ''));
        if (t.via_summary) viaEl.innerHTML = `Route via <em>${t.via_summary}</em>${ownerBit}`;
        else viaEl.innerHTML = (t.states.length ? `Through <em>${t.states.join(', ')}</em>` : '') + ownerBit;
        document.getElementById('hero-miles').textContent = t.miles.toLocaleString();
        document.getElementById('hero-kwh').textContent = t.total_kwh;
        document.getElementById('hero-days').textContent = t.duration_days;
        document.getElementById('hero-stops').textContent = t.stop_count;
        card.classList.toggle('featured', t.featured || t.has_colorado);
      }
    }

    // ── Intro — continental US, flat mercator view ──
    function introFlyover() {
      map.fitBounds([[US_BOUNDS.west, US_BOUNDS.south], [US_BOUNDS.east, US_BOUNDS.north]], {
        padding: mapCameraPadding(),
        pitch:0, bearing:0, duration:1400, maxZoom:5,
      });
      setTimeout(hideSplash, 2200);
    }

    // ── Fit trip — frame route in continental US ──
    function fitTrip(animate=true) {
      const bounds = new mapboxgl.LngLatBounds();
      activeTrips().forEach(t => {
        // Prefer the driving path so round trips with identical home endpoints still frame the loop
        const path = t.route_path || [];
        if (path.length >= 2) {
          path.forEach(p => bounds.extend([p[1], p[0]]));
        } else {
          t.stops.forEach(s => bounds.extend([s.lng, s.lat]));
        }
      });
      if (bounds.isEmpty()) return;
      const trip = activeTrip();
      const stopCount = activeTrips().reduce((sum, t) => sum + (t.stop_count || t.stops?.length || 0), 0);
      const miles = trip?.miles || 0;
      setMapLabelsVisible(!isSingleTrip());
      let maxZoom = 5;
      if (isSingleTrip()) {
        maxZoom = Math.min(6.2, Math.max(4.0, 7.4 - Math.log2(Math.max(stopCount, 2))));
        if (miles > 1800) maxZoom = Math.min(maxZoom, 4.4);
        else if (miles > 900) maxZoom = Math.min(maxZoom, 5.0);
        else if (miles < 450) maxZoom = Math.min(6.4, Math.max(maxZoom, 5.4));
      }
      map.fitBounds(bounds, {
        padding: mapCameraPadding(),
        pitch: isSingleTrip() ? 28 : 0,
        bearing: 0,
        duration: animate ? 1100 : 0,
        maxZoom,
        minZoom: 3,
      });
    }

    function updateLocationHud(state) {
      const hud = document.getElementById('location-hud');
      const icon = document.getElementById('hud-icon');
      // While watching, story captions own the narrative — hide the competing HUD.
      if (!state || !isSingleTrip() || state.phase === 'intro' || state.phase === 'outro'
          || document.body.classList.contains('watching') || isRecording) {
        hud.classList.remove('visible');
        return;
      }
      hud.classList.add('visible');
      const charging = state.phase === 'dwell';
      icon.textContent = charging ? '⚡' : '🚗';
      icon.classList.toggle('charging', charging);
      document.getElementById('hud-phase').textContent = charging ? 'Charging' : 'En Route';
      document.getElementById('hud-text').textContent = state.label || '';
    }

    function updateStoryOverlay(state) {
      const overlay = document.getElementById('story-overlay');
      const captionEl = document.getElementById('story-caption');
      const subEl = document.getElementById('story-sub');
      const poisEl = document.getElementById('story-pois');
      if (!state || !isSingleTrip()) {
        overlay.classList.remove('visible');
        return;
      }
      const show = isPlaying || isRecording;
      if (!show) { overlay.classList.remove('visible'); return; }

      if (state.phase === 'intro') {
        overlay.classList.add('visible');
        captionEl.textContent = state.label || activeTrip()?.name || '';
        subEl.textContent = state.caption || '';
        poisEl.innerHTML = (state.highlights || []).map(h =>
          `<span class="story-poi-chip">${h}</span>`
        ).join('');
        return;
      }
      if (state.phase === 'outro') {
        overlay.classList.add('visible');
        captionEl.textContent = 'Journey Complete';
        subEl.textContent = state.caption || '';
        const vc = state.visitedCount || 0;
        const nc = state.nearbyCount || 0;
        poisEl.innerHTML = nc
          ? `<span class="story-poi-chip visited">${vc} confirmed visits</span><span class="story-poi-chip">${nc} nearby highlights</span>`
          : '';
        return;
      }
      if (state.phase === 'dwell' && (state.caption || state.pois?.length)) {
        overlay.classList.add('visible');
        captionEl.textContent = state.caption || `Charging · ${state.label}`;
        subEl.textContent = state.subcaption || '';
        poisEl.innerHTML = (state.pois || []).map(p =>
          `<span class="story-poi-chip${p.visited ? ' visited' : ''}">${p.emoji} ${p.name}${p.visited ? ' ✓' : ''}</span>`
        ).join('');
        return;
      }
      if (state.phase === 'travel') {
        overlay.classList.add('visible');
        captionEl.textContent = `Driving to ${state.label || 'next stop'}`;
        subEl.textContent = '';
        poisEl.innerHTML = '';
        return;
      }
      overlay.classList.remove('visible');
    }

    function clearPoiMarkers() {
      poiMarkers.forEach(m => m.remove());
      poiMarkers = [];
      poiMarkerKey = '';
    }

    function updatePoiMarkers(pois, visible) {
      const key = (visible && pois?.length)
        ? pois.map(p => `${p.id || p.name}:${p.lat},${p.lng}`).join('|')
        : '';
      if (key === poiMarkerKey) return;
      clearPoiMarkers();
      poiMarkerKey = key;
      if (!key || !map) return;
      // Keep POIs away from stacked home pins — skip landmarks within ~2.5km of a same-home endpoint
      const trip = activeTrip();
      const home = isSameHomeTrip(trip) ? trip.stops[0] : null;
      pois.forEach(poi => {
        if (home) {
          const dLat = poi.lat - home.lat;
          const dLng = poi.lng - home.lng;
          if ((dLat * dLat + dLng * dLng) < 0.0006) return; // ~2.5km
        }
        const wrap = document.createElement('div');
        wrap.className = 'poi-wrap visible';
        const pin = document.createElement('div');
        pin.className = 'poi-pin' + (poi.visited ? ' visited' : '');
        pin.textContent = poi.emoji || '📍';
        const lbl = document.createElement('div');
        lbl.className = 'poi-label' + (poi.visited ? ' visited' : '');
        lbl.textContent = poi.name;
        wrap.appendChild(pin);
        wrap.appendChild(lbl);
        const m = new mapboxgl.Marker({ element: wrap, anchor: 'bottom' })
          .setLngLat([poi.lng, poi.lat])
          .addTo(map);
        poiMarkers.push(m);
      });
    }

    function setPlaybackVisuals(playing) {
      const t = activeTrip();
      if (!t) return;
      setRouteStyle(t.id, t.color, playing ? 'playback' : 'active');
    }

    function updateTrailFromState(state) {
      const stops = activeStops();
      if (!state) return;
      animStopIdx = state.stopIndex ?? 0;
      animProg = playbackProgress();
      const color = stops[Math.min(animStopIdx, stops.length - 1)]?.tripColor || '#ef4444';

      if (state.phase === 'intro') {
        if (vehicleMarker) { vehicleMarker.remove(); vehicleMarker = null; }
        clearPoiMarkers();
        ensureTrailLayers(color);
        map.getSource('active-trail').setData({ type: 'Feature', geometry: { type: 'LineString', coordinates: [] } });
        updateStoryOverlay(state);
        updateLocationHud(state);
        if (isPlaying && !isRecording) showWatchTitleCard(activeTrip(), 'intro', state);
        setPlaybackChrome(animProg, state.label || 'Opening…');
        return;
      }
      if (state.phase === 'outro') {
        if (vehicleMarker) { vehicleMarker.remove(); vehicleMarker = null; }
        clearPoiMarkers();
        updateStoryOverlay(state);
        updateLocationHud(state);
        if (isPlaying && !isRecording) showWatchTitleCard(activeTrip(), 'outro', state);
        setPlaybackChrome(animProg, 'Journey complete');
        return;
      }
      if (isPlaying && !isRecording) showWatchTitleCard(activeTrip(), state.phase, state);

      const pos = { lat: state.lat, lng: state.lng };
      const trailCoords = trailCoordsAtTime(animTimeMs);

      if (state.phase === 'travel') {
        lastTravelBearing = smoothAngle(lastTravelBearing, state.bearing || 0, 0.18);
        smoothBearing = lastTravelBearing;
      }
      const bearing = state.phase === 'dwell' ? lastTravelBearing : smoothBearing;

      ensureTrailLayers(color);
      if (trailCoords.length >= 2) {
        map.getSource('active-trail').setData({ type: 'Feature', geometry: { type: 'LineString', coordinates: trailCoords } });
        map.setPaintProperty('active-trail-glow', 'line-color', color);
        map.setPaintProperty('active-trail-line', 'line-gradient', ['interpolate', ['linear'], ['line-progress'], 0, color, 0.85, '#ffffff', 1, '#ffffff']);
      }

      if (pos.lat != null) {
        if (vehicleMarker) {
          vehicleMarker.setLngLat([pos.lng, pos.lat]);
          const body = vehicleMarker.getElement().querySelector('.vehicle-body');
          if (body && state.phase === 'travel') body.style.transform = `rotate(${bearing}deg)`;
          else if (body) body.style.transform = 'rotate(0deg)';
        } else {
          const el = document.createElement('div');
          el.innerHTML = carHtml;
          vehicleMarker = new mapboxgl.Marker({ element: el, anchor: 'center', rotationAlignment: 'map' })
            .setLngLat([pos.lng, pos.lat]).addTo(map);
        }
        if (directorMode) {
          const now = performance.now();
          // Throttle camera eases — easeTo every RAF was a major lag source.
          if (now - lastDirectorMove > 180) {
            lastDirectorMove = now;
            const lookAhead = 0.04;
            let lookPos = pos;
            if (state.phase === 'travel' && state.path?.length >= 2) {
              lookPos = pointOnPath(state.path, Math.min(state.frac + lookAhead, 1)) || pos;
            }
            camBearing = state.phase === 'travel'
              ? smoothAngle(camBearing, bearing, 0.06)
              : camBearing;
            const zoom = state.phase === 'dwell' && state.pois?.length ? 7.2 : Math.min(6.8, Math.max(5.2, map.getZoom()));
            const pad = mapCameraPadding();
            const cam = {
              center: [lookPos.lng, lookPos.lat],
              zoom,
              pitch: Math.min(MAX_PITCH, state.phase === 'dwell' ? 38 : 42),
              bearing: camBearing,
              padding: {
                top: Math.max(40, Math.floor(pad.top * 0.5)),
                bottom: Math.max(100, pad.bottom),
                left: Math.max(24, Math.floor(pad.left * 0.35)),
                right: 40,
              },
            };
            if (isRecording) map.jumpTo(cam);
            else map.easeTo({ ...cam, duration: 420, essential: true });
          }
        }
      }

      updatePoiMarkers(state.pois, state.phase === 'dwell');

      const lastIdx = stops.length - 1;
      const sameHome = isSameHomeTrip(activeTrip());
      stopMarkers.forEach(m => {
        const reached = m._idx <= animStopIdx;
        const isActive = m._idx === animStopIdx;
        const isStart = m._idx === 0;
        const isEnd = m._idx === lastIdx;
        // While the car sits on a stacked home pin, hide that milestone so the car wins.
        const carCovers = sameHome && isActive && (isStart || isEnd) && state.phase === 'dwell';
        m._el.classList.toggle('visible', (reached || m._isMilestone) && !carCovers);
        m._el.classList.toggle('active', isActive && !carCovers);
        if (m._lbl) {
          const showLbl = isActive && !carCovers;
          m._lbl.classList.toggle('visible', showLbl);
          m._lbl.classList.toggle('active', showLbl);
          if (showLbl) {
            if (sameHome && isStart) setMilestoneLabel(m._lbl, 'Start', m._stop.location);
            else if (sameHome && isEnd) setMilestoneLabel(m._lbl, 'Return', m._stop.location);
            else if (isStart) setMilestoneLabel(m._lbl, 'Start', m._stop.location);
            else if (isEnd) setMilestoneLabel(m._lbl, 'Finish', m._stop.location);
            else m._lbl.textContent = shortLabel(m._stop.location);
          }
        }
      });

      const cur = stops[animStopIdx];
      if (cur && state.phase === 'dwell') {
        const pct = Math.round((state.frac || 0) * 100);
        setPlaybackChrome(
          animProg,
          `Charging · ${shortLabel(cur.location)}`,
          stops[0]?.datetime?.slice(0, 10) || '',
          null,
          `<span class="dwell-pct">${pct}%</span>`
        );
      } else {
        const label = cur
          ? (state.phase === 'dwell' ? `Charging · ${shortLabel(cur.location)}` : `Driving · ${state.label || shortLabel(cur.location)}`)
          : 'Ready to replay';
        if (cur) {
          setPlaybackChrome(
            animProg,
            label,
            stops[0]?.datetime?.slice(0, 10) || '',
            cur.datetime?.slice(0, 10) || ''
          );
        } else {
          setPlaybackChrome(animProg, label);
        }
      }
      updateLocationHud(state);
      updateStoryOverlay(state);
    }

    function updateTrail(prog) {
      animTimeMs = prog * (activePlayback()?.total_video_ms || 0);
      updateTrailFromState(positionAtTime(animTimeMs));
    }

    // ── Playback ──
    function animate(ts) {
      if (!isPlaying) return;
      if (!lastTs) lastTs=ts;
      const pb = activePlayback();
      if (!pb?.total_video_ms) { stopPlayback(); return; }
      const rawDelta = ts - lastTs;
      const delta = Math.min(rawDelta, 250);
      animTimeMs += delta * speed;
      lastTs = ts;
      if (animTimeMs >= pb.total_video_ms) {
        animTimeMs = pb.total_video_ms;
        updateTrailFromState(positionAtTime(animTimeMs));
        if (isRecording) finishRecording();
        if (loopTrip) {
          animTimeMs = 0; animStopIdx = 0;
          applyIdleStopVisuals();
          lastTs = 0;
          if (!isRecording) { animFrame = requestAnimationFrame(animate); }
          return;
        }
        if (queueEpics && !isRecording) {
          const next = nextEpicTrip(selectedId);
          stopPlayback();
          if (next) {
            selectTrip(next.id);
            setTimeout(() => startPlayback(false), 900);
          }
          return;
        }
        stopPlayback();
        return;
      }
      updateTrailFromState(positionAtTime(animTimeMs));
      animFrame = requestAnimationFrame(animate);
    }
    function startPlayback(forRecording=false) {
      if (!isSingleTrip()) {
        document.getElementById('prog-text').textContent = 'Select a trip first';
        return;
      }
      if (!activePlayback()?.total_video_ms) return;
      if (animTimeMs >= activePlayback().total_video_ms) { animTimeMs = 0; resetVisuals(false); drawStops(); }
      isPlaying = true; lastTs = 0;
      setPanelCollapsed(true);
      if (!forRecording) setWatching(true);
      setPlaybackVisuals(true);
      document.getElementById('btn-play').disabled = true;
      document.getElementById('btn-pause').disabled = false;
      document.getElementById('location-hud').classList.remove('visible');
      document.getElementById('transport-dock')?.classList.remove('idle');
      animFrame = requestAnimationFrame(animate);
    }
    function stopPlayback() {
      isPlaying=false;
      if (animFrame) cancelAnimationFrame(animFrame);
      document.getElementById('btn-play').disabled = !isSingleTrip();
      document.getElementById('btn-pause').disabled = true;
      if (!isRecording) {
        setPlaybackVisuals(false);
        setWatching(false);
      }
    }
    function resetVisuals(clearHud=true) {
      stopPlayback(); animTimeMs=0; animProg=0; animStopIdx=0;
      smoothBearing = 0; camBearing = 0; lastTravelBearing = 0;
      if (vehicleMarker) { vehicleMarker.remove(); vehicleMarker=null; }
      clearPoiMarkers();
      if (map?.getSource('active-trail')) map.getSource('active-trail').setData({type:'Feature',geometry:{type:'LineString',coordinates:[]}});
      applyIdleStopVisuals();
      setPlaybackChrome(0, isSingleTrip() ? 'Ready to replay' : 'Select a trip to replay');
      if (clearHud) {
        ui('location-hud')?.classList.remove('visible');
        ui('story-overlay')?.classList.remove('visible');
      }
      setPlaybackVisuals(false);
      setWatching(false);
    }

    async function exportTripVideo() {
      if (!isSingleTrip() || !map) return;
      const trip = activeTrip();
      const story = trip.story || {};
      const status = document.getElementById('export-status');
      status.textContent = 'Preparing cinematic recording…';
      status.classList.add('visible');
      resetVisuals();
      drawStops();
      fitTrip(false);
      await new Promise(r => setTimeout(r, 1600));

      document.body.classList.add('cinema-mode', 'portrait-export');
      const title = document.getElementById('cinema-title');
      document.getElementById('cinema-title-text').textContent = trip.name;
      document.getElementById('cinema-subtitle').textContent =
        `${trip.miles.toLocaleString()} mi · ${trip.stop_count} Supercharger stops · ${trip.duration_days} days`;
      const hlEl = document.getElementById('cinema-highlights');
      hlEl.innerHTML = (story.highlights || []).slice(0, 4).map(h => `<span>${h}</span>`).join('');
      title.classList.add('visible');
      map.resize();
      await new Promise(r => setTimeout(r, 500));

      const canvas = map.getCanvas();
      const stream = canvas.captureStream(30);
      recordedChunks = [];
      const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
        ? 'video/webm;codecs=vp9' : 'video/webm';
      mediaRecorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 8_000_000 });
      mediaRecorder.ondataavailable = e => { if (e.data.size) recordedChunks.push(e.data); };
      mediaRecorder.onstop = () => {
        const blob = new Blob(recordedChunks, { type: 'video/webm' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${trip.id}_road_trip.webm`;
        a.click();
        URL.revokeObjectURL(url);
        isRecording = false;
        document.body.classList.remove('cinema-mode', 'portrait-export');
        title.classList.remove('visible');
        hlEl.innerHTML = '';
        status.classList.remove('visible');
        document.getElementById('story-overlay').classList.remove('visible');
        map.resize();
        fitTrip(false);
      };

      isRecording = true;
      status.textContent = 'Recording road trip story…';
      mediaRecorder.start(250);
      startPlayback(true);
    }

    function finishRecording() {
      if (mediaRecorder && mediaRecorder.state !== 'inactive') {
        document.getElementById('export-status').textContent = 'Saving video…';
        mediaRecorder.stop();
      }
      stopPlayback();
    }

    function setBasemapTripFocus(on) {
      if (!map || !map.isStyleLoaded()) return;
      // Dim only raster basemap layers so route lines stay neon-bright.
      map.getStyle().layers.forEach(layer => {
        if (layer.type !== 'raster' && layer.type !== 'background') return;
        try {
          if (layer.type === 'raster') {
            map.setPaintProperty(layer.id, 'raster-brightness-min', on ? 0.05 : 0);
            map.setPaintProperty(layer.id, 'raster-brightness-max', on ? 0.78 : 1);
            map.setPaintProperty(layer.id, 'raster-saturation', on ? -0.35 : 0);
            map.setPaintProperty(layer.id, 'raster-contrast', on ? 0.12 : 0);
          }
        } catch (_) {}
      });
    }

    function updateMapLegend(trip) {
      const legend = document.getElementById('map-legend');
      if (!legend) return;
      if (!trip) {
        legend.classList.remove('visible');
        legend.setAttribute('aria-hidden', 'true');
        return;
      }
      const swatch = document.getElementById('legend-route-swatch');
      const routeLbl = document.getElementById('legend-route-label');
      const endLbl = document.getElementById('legend-end-label');
      swatch.style.background = trip.color;
      swatch.style.color = trip.color;
      const short = (trip.name || '').split('—').pop()?.trim() || 'Route';
      routeLbl.textContent = short.replace(/\s*·.*$/, '').slice(0, 28);
      endLbl.textContent = isSameHomeTrip(trip) ? 'Return' : 'Finish';
      legend.classList.add('visible');
      legend.setAttribute('aria-hidden', 'false');
    }

    // ── Select trip ──
    function selectTrip(id) {
      if (selectedId === id && id !== 'all') {
        // Re-clicking the same trip should feel instant — just refit, don't rebuild layers.
        resetVisuals(); drawStops(); updateHero(); fitTrip();
        updateDockIdle();
        return;
      }
      selectedId=id;
      hoveredTripId=null;
      dismissOnboarding();
      document.body.classList.toggle('trip-focus', id !== 'all');
      setBasemapTripFocus(id !== 'all');
      // Map-first on trip focus; restore panel when returning to atlas.
      setPanelCollapsed(id !== 'all');
      document.querySelectorAll('.trip-item').forEach(el=>{
        el.classList.toggle('active',el.dataset.id===id);
        el.classList.remove('preview');
      });
      document.querySelectorAll('.tl-seg').forEach(el=>el.classList.toggle('active',el.dataset.id===id));
      resetVisuals(); drawRoutes(); drawStops(); updateHero(); fitTrip();
      setMapLabelsVisible(!isSingleTrip());
      updateMapLegend(activeTrip());
      document.getElementById('btn-play').disabled = !isSingleTrip();
      document.getElementById('btn-export').disabled = !isSingleTrip();
      updateDockIdle();
      updateAtlasCta();
      if (id === 'all') {
        applyEraFilter();
        if (!memoryPaused) startMemoryReel();
      } else {
        stopMemoryReel();
        drawAtlasSpokes();
      }
    }

    function updateDockIdle() {
      document.getElementById('transport-dock')?.classList.toggle('idle', selectedId === 'all');
    }

    // ── Night mode ──
    // Tint the canvas instead of reloading the whole base style. A full
    // setStyle() swap tore down/rebuilt every source + refetched all tiles,
    // which threw "Style is not done loading" and left dark tile gaps.
    function toggleNight() {
      nightMode=!nightMode;
      document.getElementById('btn-night').classList.toggle('on', nightMode);
      document.body.classList.toggle('night', nightMode);
    }
    document.getElementById('trip-list').addEventListener('click', e=>{
      const item=e.target.closest('.trip-item'); if(item) selectTrip(item.dataset.id);
    });
    document.getElementById('trip-list').addEventListener('mouseover', e=>{
      const item=e.target.closest('.trip-item');
      if (!item || item.dataset.id === 'all') { if (selectedId==='all') setHoveredTrip(null); return; }
      if (selectedId==='all') setHoveredTrip(item.dataset.id);
    });
    document.getElementById('trip-list').addEventListener('mouseleave', ()=>{
      if (selectedId==='all') setHoveredTrip(null);
    });
    document.getElementById('timeline-track').addEventListener('click', e=>{
      const seg=e.target.closest('.tl-seg'); if(seg) selectTrip(seg.dataset.id);
    });
    document.getElementById('timeline-track').addEventListener('mouseover', e=>{
      const seg=e.target.closest('.tl-seg');
      if (selectedId==='all' && seg) setHoveredTrip(seg.dataset.id);
    });
    document.getElementById('timeline-track').addEventListener('mouseleave', ()=>{
      if (selectedId==='all') setHoveredTrip(null);
    });
    document.getElementById('btn-play').addEventListener('click', startPlayback);
    document.getElementById('btn-pause').addEventListener('click', stopPlayback);
    document.getElementById('btn-step').addEventListener('click', ()=>{
      if (!isSingleTrip()) return;
      stopPlayback();
      const pb = activePlayback();
      if (!pb) return;
      let cursor = 0, targetIdx = animStopIdx + 1;
      for (const seg of pb.segments) {
        if (seg.stop_index >= targetIdx && seg.type === 'dwell') {
          animTimeMs = cursor;
          updateTrailFromState(positionAtTime(animTimeMs));
          return;
        }
        cursor += seg.duration_ms;
      }
      animTimeMs = pb.total_video_ms;
      updateTrailFromState(positionAtTime(animTimeMs));
    });
    document.getElementById('btn-reset').addEventListener('click', ()=>{ resetVisuals(); drawStops(); fitTrip(); });
    document.getElementById('btn-loop').addEventListener('click', ()=>{
      // off → loop one → epic queue → off
      if (!loopTrip && !queueEpics) {
        loopTrip = true; queueEpics = false;
      } else if (loopTrip && !queueEpics) {
        loopTrip = false; queueEpics = true;
      } else {
        loopTrip = false; queueEpics = false;
      }
      syncLoopButton();
    });
    document.getElementById('btn-director').addEventListener('click', ()=>{
      directorMode=!directorMode; document.getElementById('btn-director').classList.toggle('on', directorMode);
    });
    document.getElementById('btn-night').addEventListener('click', toggleNight);
    document.getElementById('speed').addEventListener('input', e=>{ speed=parseFloat(e.target.value); document.getElementById('speed-label').textContent=speed+'×'; });
    document.getElementById('scrubber').addEventListener('input', e=>{
      if (!isSingleTrip()) return;
      stopPlayback();
      const pb = activePlayback();
      if (!pb) return;
      animTimeMs = (parseInt(e.target.value)/1000) * pb.total_video_ms;
      updateTrailFromState(positionAtTime(animTimeMs));
    });
    document.getElementById('sidebar-toggle').addEventListener('click', ()=>{
      const sb=document.getElementById('sidebar');
      sb.classList.toggle('collapsed');
      // Reframe so the route isn't under chrome after toggle.
      if (map) fitTrip(true);
    });
    document.getElementById('era-rail')?.addEventListener('click', e => {
      const chip = e.target.closest('.era-chip');
      if (!chip) return;
      setYearFilter(chip.dataset.year || 'all');
    });
    document.getElementById('atlas-cta')?.addEventListener('click', () => {
      const id = document.getElementById('atlas-cta')?.dataset.tripId;
      if (id) selectTrip(id);
    });
    document.getElementById('memory-pause')?.addEventListener('click', (e) => {
      e.stopPropagation();
      memoryPaused = !memoryPaused;
      const btn = document.getElementById('memory-pause');
      if (memoryPaused) {
        if (btn) btn.textContent = 'Resume';
        if (memoryTimer) { clearInterval(memoryTimer); memoryTimer = null; }
      } else {
        if (btn) btn.textContent = 'Pause';
        startMemoryReel();
      }
    });
    document.addEventListener('keydown', e=>{
      if (e.target.tagName==='INPUT') return;
      if (e.code==='Escape') {
        if (isPlaying) { stopPlayback(); return; }
        if (selectedId !== 'all') { selectTrip('all'); return; }
        if (!memoryPaused) {
          memoryPaused = true;
          const btn = document.getElementById('memory-pause');
          if (btn) btn.textContent = 'Resume';
          stopMemoryReel();
        }
        return;
      }
      if (e.code==='Space') { e.preventDefault(); isPlaying?stopPlayback():startPlayback(); }
      if (e.code==='ArrowRight') { stopPlayback(); document.getElementById('btn-step').click(); }
      if (e.code==='ArrowLeft') { stopPlayback(); if(isSingleTrip()&&animStopIdx>0){
        const pb = activePlayback(); if (!pb) return;
        let cursor = 0, targetIdx = animStopIdx - 1;
        for (const seg of pb.segments) {
          if (seg.stop_index === targetIdx && seg.type === 'dwell') {
            animTimeMs = cursor; updateTrailFromState(positionAtTime(animTimeMs)); return;
          }
          cursor += seg.duration_ms;
        }
      }}
      if (e.code==='KeyR') document.getElementById('btn-reset').click();
      if (e.code==='KeyD') document.getElementById('btn-director').click();
    });

    document.getElementById('btn-export').addEventListener('click', exportTripVideo);
    document.getElementById('onboard-featured').addEventListener('click', startWithFeatured);
    document.getElementById('onboard-dismiss').addEventListener('click', dismissOnboarding);
    document.getElementById('onboarding').addEventListener('click', e=>{
      if (e.target.id === 'onboarding') dismissOnboarding();
    });

    document.getElementById('token-submit').addEventListener('click', ()=>{
      const t = document.getElementById('token-input').value.trim();
      if (t.startsWith('pk.')) bootMap(t);
    });
    document.getElementById('token-input').addEventListener('keydown', e=>{
      if (e.key === 'Enter') document.getElementById('token-submit').click();
    });

    // ── Timeline label: derive real year span from trip data ──
    (function setTimelineRange() {
      const years = TRIPS
        .flatMap(t => [t.start, t.end])
        .map(d => parseInt(String(d).slice(0, 4), 10))
        .filter(y => y >= 1990 && y <= 2100);
      if (!years.length) return;
      const lo = Math.min(...years), hi = Math.max(...years);
      document.getElementById('timeline-label').textContent =
        `Journey Timeline · ${lo}${hi > lo ? ' — ' + hi : ''}`;
    })();

    // ── Boot ──
    (function boot() {
      const saved = localStorage.getItem('mapbox-token');
      const token = MAPBOX_TOKEN || saved;
      if (token) {
        bootMap(token);
      } else {
        document.getElementById('splash').classList.add('hidden');
        document.getElementById('token-gate').classList.add('visible');
      }
    })();
  </script>
</body>
</html>
