    // ── Helpers ──
    function isSingleTrip() { return selectedId !== 'all'; }
    function activeTrips() { return isSingleTrip() ? TRIPS.filter(t => t.id === selectedId) : TRIPS; }
    function activeTrip() { return isSingleTrip() ? TRIPS.find(t => t.id === selectedId) : null; }
    function activeStops() { return activeTrips().flatMap(t => t.stops.map((s,i) => ({...s, tripColor: t.color, tripId: t.id, stopNum: i+1}))); }
    function activePath() {
      if (!isSingleTrip()) return [];
      const t = activeTrip();
      return t ? (t.route_path || []) : [];
    }
    function lerp(a,b,t) { return a+(b-a)*t; }
    function pathCumMiles(path) {
      const cum = [0];
      if (!path || path.length < 2) return cum;
      for (let i = 1; i < path.length; i++) {
        const a = path[i - 1], b = path[i];
        cum.push(cum[i - 1] + haversineKm(a[0], a[1], b[0], b[1]) * 0.621371);
      }
      return cum;
    }
    function pointOnPath(path, prog) {
      if (!path.length) return null;
      if (prog <= 0) return {lat:path[0][0], lng:path[0][1]};
      if (prog >= 1) return {lat:path[path.length-1][0], lng:path[path.length-1][1]};
      // Arc-length interpolation so long highway legs crawl evenly (not by vertex index).
      const cum = pathCumMiles(path);
      const total = cum[cum.length - 1] || 0;
      if (total <= 1e-9) {
        const ex = prog * (path.length - 1), idx = Math.floor(ex), frac = ex - idx;
        const a = path[idx], b = path[Math.min(idx + 1, path.length - 1)];
        return { lat: lerp(a[0], b[0], frac), lng: lerp(a[1], b[1], frac) };
      }
      let target = prog * total;
      for (let i = 1; i < path.length; i++) {
        if (target <= cum[i] || i === path.length - 1) {
          const segLen = cum[i] - cum[i - 1];
          const frac = segLen > 0 ? Math.min(1, (target - cum[i - 1]) / segLen) : 0;
          const a = path[i - 1], b = path[i];
          return { lat: lerp(a[0], b[0], frac), lng: lerp(a[1], b[1], frac) };
        }
      }
      const last = path[path.length - 1];
      return { lat: last[0], lng: last[1] };
    }
    function pathBearing(path, prog) {
      return courseAlongPath(path, prog, 0.15);
    }
    function courseAlongPath(path, prog, lookAheadKm) {
      if (!path || path.length < 2) return 0;
      const totalKm = (typeof pathLengthKm === 'function' ? pathLengthKm(path) : 0) || 1;
      const aheadKm = lookAheadKm || NAV_LOOKAHEAD_KM;
      const origin = pointOnPath(path, Math.max(0, Math.min(1, prog)));
      if (!origin) return 0;
      // Average unit vectors over several look-ahead distances (GPS-style course filter)
      const spans = [0.25, 0.5, 0.85, 1.2].map((f) => aheadKm * f);
      let x = 0, y = 0, hits = 0;
      for (const km of spans) {
        const dProg = Math.max(0.003, Math.min(0.3, km / Math.max(totalKm, 0.2)));
        const b = pointOnPath(path, Math.min(1, prog + dProg));
        if (!b) continue;
        if (haversineKm(origin.lat, origin.lng, b.lat, b.lng) < 0.02) continue;
        const br = bearingBetween(origin.lat, origin.lng, b.lat, b.lng) * Math.PI / 180;
        x += Math.sin(br);
        y += Math.cos(br);
        hits += 1;
      }
      if (hits === 0) {
        const b = pointOnPath(path, Math.min(1, prog + 0.01));
        if (!b) return 0;
        return bearingBetween(origin.lat, origin.lng, b.lat, b.lng);
      }
      return (Math.atan2(x / hits, y / hits) * 180 / Math.PI + 360) % 360;
    }
    function bearingBetween(lat1, lng1, lat2, lng2) {
      const dLng = (lng2 - lng1) * Math.PI / 180;
      const φ1 = lat1 * Math.PI / 180, φ2 = lat2 * Math.PI / 180;
      const y = Math.sin(dLng) * Math.cos(φ2);
      const x = Math.cos(φ1) * Math.sin(φ2) - Math.sin(φ1) * Math.cos(φ2) * Math.cos(dLng);
      return (Math.atan2(y, x) * 180 / Math.PI + 360) % 360;
    }
    function clampTurn(fromDeg, toDeg, maxStep) {
      let diff = ((toDeg - fromDeg + 540) % 360) - 180;
      if (diff > maxStep) diff = maxStep;
      if (diff < -maxStep) diff = -maxStep;
      return (fromDeg + diff + 360) % 360;
    }
    function offsetAlongBearing(lng, lat, bearingDeg, meters) {
      const R = 6378137;
      const δ = meters / R;
      const θ = bearingDeg * Math.PI / 180;
      const φ1 = lat * Math.PI / 180;
      const λ1 = lng * Math.PI / 180;
      const φ2 = Math.asin(Math.sin(φ1) * Math.cos(δ) + Math.cos(φ1) * Math.sin(δ) * Math.cos(θ));
      const λ2 = λ1 + Math.atan2(
        Math.sin(θ) * Math.sin(δ) * Math.cos(φ1),
        Math.cos(δ) - Math.sin(φ1) * Math.sin(φ2)
      );
      return [((λ2 * 180 / Math.PI + 540) % 360) - 180, φ2 * 180 / Math.PI];
    }
    function findStopIdx(stops, path, prog) {
      const pos = pointOnPath(path, prog); if (!pos||!stops.length) return 0;
      let best=0, bestD=Infinity;
      stops.forEach((s,i)=>{ const d=(s.lat-pos.lat)**2+(s.lng-pos.lng)**2; if(d<bestD){bestD=d;best=i;} });
      return best;
    }
    function popupHtml(s) {
      const dt = new Date(s.datetime).toLocaleString('en-US',{dateStyle:'medium',timeStyle:'short'});
      if (s.is_photo || s.kind === 'photo') {
        return `<b>${s.location || 'Photo memory'}</b><br>${dt}`;
      }
      let h=`<b>${s.location}</b><br>${dt}`;
      if(s.in_colorado) h+='<br>Colorado';
      return h;
    }
    function hexToRgb(hex) {
      const r=parseInt(hex.slice(1,3),16), g=parseInt(hex.slice(3,5),16), b=parseInt(hex.slice(5,7),16);
      return [r,g,b];
    }

