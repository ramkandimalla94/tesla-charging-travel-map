    const PLAY_ICON = '<path d="M8 5v14l11-7L8 5z"/>';
    const PAUSE_ICON = '<path d="M6 5h4v14H6V5zm8 0h4v14h-4V5z"/>';

    function syncPlayToggle(playing) {
      const btn = ui('btn-play');
      if (!btn) return;
      btn.classList.toggle('is-playing', !!playing);
      btn.title = playing ? 'Pause' : 'Play';
      btn.setAttribute('aria-label', playing ? 'Pause' : 'Play');
      btn.disabled = !playing && !isSingleTrip();
      const svg = btn.querySelector('svg');
      if (svg) svg.innerHTML = playing ? PAUSE_ICON : PLAY_ICON;
    }

    function tripTzFromLng(lng) {
      if (lng == null || !Number.isFinite(lng)) return 'America/Chicago';
      if (lng <= -112.5) return 'America/Los_Angeles';
      if (lng <= -100) return 'America/Denver';
      if (lng <= -85) return 'America/Chicago';
      return 'America/New_York';
    }

    /** Format an instant in the wall-clock TZ at lng (matches #trip-clock). */
    function formatLocalClock(dt, lng, style) {
      if (!dt || !(dt instanceof Date) || Number.isNaN(dt.getTime())) return '';
      const tz = tripTzFromLng(lng);
      if (style === 'medium') {
        return dt.toLocaleString('en-US', {
          timeZone: tz, dateStyle: 'medium', timeStyle: 'short',
        });
      }
      return dt.toLocaleString('en-US', {
        timeZone: tz,
        weekday: 'short',
        month: 'short',
        day: 'numeric',
        hour: 'numeric',
        minute: '2-digit',
      });
    }

    function clockFromState(state) {
      const seg = state?.seg;
      if (seg?.clock_start) {
        const t0 = Date.parse(seg.clock_start);
        const t1 = Date.parse(seg.clock_end || seg.clock_start);
        if (Number.isFinite(t0)) {
          const frac = state.frac || 0;
          const end = Number.isFinite(t1) ? t1 : t0;
          return new Date(t0 + (end - t0) * frac);
        }
      }
      // Photo memories: never use charger stop time — prefer capture instant.
      if (state?.is_photo || state?.phase === 'memory') {
        const raw = state.datetime || state.seg?.datetime || state.seg?.clock_start;
        const ms = raw ? Date.parse(raw) : NaN;
        if (Number.isFinite(ms)) return new Date(ms);
      }
      const trip = activeTrip();
      const stops = trip?.stops || [];
      const idx = Math.max(0, Math.min(stops.length - 1, state?.stopIndex ?? 0));
      const raw = stops[idx]?.datetime || trip?.start;
      const ms = raw ? Date.parse(raw) : NaN;
      return Number.isFinite(ms) ? new Date(ms) : null;
    }

    let nightFactor = 0;
    function nightIntensityFromHour(hour) {
      // Gradual twilight — not a hard 6 AM / 8 PM switch.
      // Full night ~20:30–05:00, dawn 05→07, dusk 18→20:30.
      const h = ((Number(hour) % 24) + 24) % 24;
      const smoothstep = (a, b, x) => {
        const t = Math.max(0, Math.min(1, (x - a) / (b - a)));
        return t * t * (3 - 2 * t);
      };
      if (h >= 7 && h <= 18) return 0;
      if (h >= 20.5 || h <= 5) return 1;
      if (h < 7) return 1 - smoothstep(5, 7, h);
      return smoothstep(18, 20.5, h);
    }

    function localHourFromState(state) {
      const dt = clockFromState(state);
      if (!dt) return 12;
      const lng = state?.lng != null ? state.lng : (activeTrip()?.stops?.[0]?.lng);
      try {
        const tz = tripTzFromLng(lng);
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: tz, hour: 'numeric', minute: '2-digit', hourCycle: 'h23',
        }).formatToParts(dt);
        const hour = parseInt(parts.find(p => p.type === 'hour')?.value || '12', 10);
        const minute = parseInt(parts.find(p => p.type === 'minute')?.value || '0', 10);
        return hour + minute / 60;
      } catch (_) {
        return dt.getUTCHours() + dt.getUTCMinutes() / 60;
      }
    }

    function clockPlayPace(_hour) {
      // Equal day/night pacing — no night skip or morning linger.
      return 1;
    }

    function setNightIntensity(factor) {
      const next = Math.max(0, Math.min(1, Number(factor) || 0));
      if (Math.abs(next - nightFactor) < 0.01 && !!nightMode === next >= 0.45) return;
      nightFactor = next;
      document.documentElement.style.setProperty('--night', String(next.toFixed(3)));
      nightMode = next >= 0.45;
      document.body.classList.toggle('night', nightMode);
    }

    function setNightMode(on) {
      setNightIntensity(on ? 1 : 0);
    }

    function updateTripClock(state) {
      const el = ui('trip-clock');
      if (!el) return;
      if (!state || !isSingleTrip() || isRecording) {
        el.classList.remove('visible');
        if (!isSingleTrip()) setNightIntensity(0);
        return;
      }
      const dt = clockFromState(state);
      if (!dt) {
        el.classList.remove('visible');
        return;
      }
      const lng = state.lng != null ? state.lng : (activeTrip()?.stops?.[0]?.lng);
      el.textContent = formatLocalClock(dt, lng, 'hud');
      el.classList.add('visible');
      let hour = 12;
      let minute = 0;
      try {
        const tz = tripTzFromLng(lng);
        const parts = new Intl.DateTimeFormat('en-US', {
          timeZone: tz, hour: 'numeric', minute: '2-digit', hourCycle: 'h23',
        }).formatToParts(dt);
        hour = parseInt(parts.find(p => p.type === 'hour')?.value || '12', 10);
        minute = parseInt(parts.find(p => p.type === 'minute')?.value || '0', 10);
      } catch (_) {
        hour = dt.getUTCHours();
        minute = dt.getUTCMinutes();
      }
      setNightIntensity(nightIntensityFromHour(hour + minute / 60));
    }

    function formatSpeedLabel(v) {
      const n = Math.round(Number(v) * 100) / 100;
      return (Number.isInteger(n) ? String(n) : String(n)) + '×';
    }

    function syncSpeedLabel() {
      const el = document.getElementById('speed-label');
      if (el) el.textContent = formatSpeedLabel(speed);
      const input = document.getElementById('speed');
      if (input && Math.abs(parseFloat(input.value) - speed) > 0.001) input.value = String(speed);
    }

    function setPlaybackSpeed(next) {
      const n = Number(next);
      if (!Number.isFinite(n)) return;
      speed = Math.max(SPEED_MIN, Math.min(SPEED_MAX, Math.round(n * 100) / 100));
      syncSpeedLabel();
    }

    function nudgeSpeed(delta) {
      const dir = delta > 0 ? 1 : -1;
      setPlaybackSpeed(speed + dir * SPEED_STEP);
    }

    function firstTravelOffsetMs(pb) {
      let cursor = 0;
      for (const seg of pb?.segments || []) {
        if (seg.type === 'travel') return cursor;
        cursor += seg.duration_ms || 0;
      }
      // Fall back: skip intro only
      cursor = 0;
      for (const seg of pb?.segments || []) {
        if (seg.type !== 'intro') return cursor;
        cursor += seg.duration_ms || 0;
      }
      return 0;
    }

    let storyOverlayKey = '';
    function updateStoryOverlay(state) {
      const overlay = document.getElementById('story-overlay');
      const captionEl = document.getElementById('story-caption');
      const subEl = document.getElementById('story-sub');
      const poisEl = document.getElementById('story-pois');
      if (!overlay) return;

      let next = { visible: false, mode: '', caption: '', sub: '', pois: '' };

      if (state && isSingleTrip() && (isPlaying || isRecording)) {
        const memoryUp = state.phase === 'memory' || (state.phase === 'dwell' && state.is_photo);
        if (memoryUp) {
          next = { visible: false, mode: '', caption: '', sub: '', pois: '' };
        } else if (state.phase === 'intro') {
          next = {
            visible: true, mode: 'intro',
            caption: state.label || activeTrip()?.name || '',
            sub: state.caption || '',
            pois: '',
          };
        } else if (state.phase === 'outro') {
          next = {
            visible: true, mode: 'outro',
            caption: 'Journey Complete',
            sub: state.caption || '',
            pois: '',
          };
        } else if (state.phase === 'dwell' && (state.caption || state.label)) {
          const stop = activeStops()[state.stopIndex ?? 0];
          const copy = dwellUiCopy(state, stop);
          const n = activeStops().length;
          const idx = (state.stopIndex ?? 0) + 1;
          next = {
            visible: true, mode: 'dwell',
            caption: copy.caption,
            sub: n > 1 ? `Stop ${idx} of ${n}` : (state.subcaption || ''),
            pois: '',
          };
        } else if (state.phase === 'travel') {
          const frac = state.frac || 0;
          const dest = (state.label || '').replace(/^Photo\s*·\s*/i, '').trim();
          const destOk = dest && !/^photo/i.test(dest);
          if (frac <= 0.1) {
            next = {
              visible: true, mode: 'travel',
              caption: destOk ? `En route · ${dest}` : 'En route',
              sub: '', pois: '',
            };
          } else if (frac >= 0.78 && destOk) {
            next = {
              visible: true, mode: 'travel approaching',
              caption: `Approaching ${dest}`,
              sub: '', pois: '',
            };
          }
        }
      }

      const key = `${next.visible}|${next.mode}|${next.caption}|${next.sub}|${next.pois}`;
      if (key === storyOverlayKey) return;
      storyOverlayKey = key;

      overlay.classList.toggle('visible', next.visible);
      overlay.classList.toggle('dwell', next.mode === 'dwell');
      overlay.classList.toggle('travel', next.mode.startsWith('travel'));
      overlay.classList.toggle('approaching', next.mode.includes('approaching'));
      if (captionEl) captionEl.textContent = next.caption;
      if (subEl) subEl.textContent = next.sub;
      if (poisEl) poisEl.innerHTML = next.pois;
    }

    function clearPoiMarkers() {
      poiMarkers.forEach(m => m.remove());
      poiMarkers = [];
      poiMarkerKey = '';
    }

    function updatePoiMarkers(_pois, _visible) {
      clearPoiMarkers();
