{# Atlas overview: CTA, memory reel, hub→destination corridor spokes #}
    function featuredTrip() {
      return TRIPS.find(t => t.featured) || TRIPS.find(t => t.has_colorado) || TRIPS[0] || null;
    }

    function nextEpicTrip(currentId) {
      const list = TRIPS.filter(t => t.featured && tripInEra(t));
      if (!list.length) return null;
      const idx = list.findIndex(t => t.id === currentId);
      return list[(idx + 1) % list.length];
    }

    function epicQueueStatus() {
      const list = TRIPS.filter(t => t.featured && tripInEra(t));
      if (!list.length) return null;
      const idx = list.findIndex(t => t.id === selectedId);
      return { n: list.length, i: idx >= 0 ? idx + 1 : 0, list };
    }

    function updateQueueBadge() {
      const badge = document.getElementById('queue-badge');
      if (!badge) return;
      if (!queueEpics) {
        badge.classList.remove('visible');
        badge.hidden = true;
        badge.textContent = '';
        return;
      }
      const st = epicQueueStatus();
      if (!st) {
        badge.classList.remove('visible');
        badge.hidden = true;
        return;
      }
      badge.hidden = false;
      badge.classList.add('visible');
      badge.textContent = st.i
        ? `Epic queue · ${st.i}/${st.n}`
        : `Epic queue · ${st.n} trips`;
    }

    function syncLoopButton() {
      const btn = document.getElementById('btn-loop');
      if (!btn) return;
      btn.classList.toggle('on', loopTrip && !queueEpics);
      btn.classList.toggle('queue', queueEpics);
      btn.title = queueEpics
        ? 'Epic queue on — plays featured trips in sequence'
        : (loopTrip ? 'Loop this trip' : 'Loop off · click for loop · again for epic queue');
      btn.setAttribute('aria-label', btn.title);
      updateQueueBadge();
    }

    function updateAtlasCta() {
      const btn = document.getElementById('atlas-cta');
      if (!btn) return;
      const epic = featuredTrip();
      if (!epic || selectedId !== 'all') {
        btn.classList.remove('visible');
        renderMobileDestRail();
        return;
      }
      document.getElementById('atlas-cta-swatch').style.background = epic.color;
      document.getElementById('atlas-cta-swatch').style.color = epic.color;
      document.getElementById('atlas-cta-title').textContent =
        (epic.name || '').split('—').pop()?.trim().replace(/\s*·.*$/, '') || epic.name;
      document.getElementById('atlas-cta-meta').textContent =
        `${epic.miles.toLocaleString()} mi · ${epic.stop_count} stops · Play after focus`;
      btn.classList.add('visible');
      btn.dataset.tripId = epic.id;
      renderMobileDestRail();
    }

    function visibleDestTripIds(group) {
      return (group.trip_ids || []).filter(id => {
        const t = TRIPS.find(x => x.id === id);
        return t && tripInEra(t);
      });
    }

    let browseDest = null;
    let preserveDestBrowse = false;

    function highlightDestBrowse(group) {
      if (!group) return;
      const visibleIds = visibleDestTripIds(group);
      TRIPS.forEach(t => {
        if (!tripInEra(t)) setRouteStyle(t.id, t.color, 'overviewDim');
        else if (visibleIds.includes(t.id)) setRouteStyle(t.id, t.color, 'overviewHover');
        else setRouteStyle(t.id, t.color, 'overviewDim');
      });
      destMarkers.forEach(m => {
        const ids = m._tripIds || [];
        const hit = ids.some(id => visibleIds.includes(id));
        m.getElement().classList.toggle('hot', hit);
        m.getElement().classList.toggle('dim', !hit);
      });
      document.querySelectorAll('.dest-group-label').forEach(el => {
        el.classList.toggle('active', el.dataset.dest === group.dest);
      });
      drawAtlasSpokes();
    }

    function clearDestBrowse() {
      browseDest = null;
      document.querySelectorAll('.dest-group-label').forEach(el => el.classList.remove('active'));
      document.querySelectorAll('.mobile-dest-chip').forEach(el => el.classList.remove('active'));
    }

    function scrollToDestGroup(destName) {
      const btn = document.querySelector(`.dest-group-label[data-dest="${CSS.escape(destName)}"]`);
      if (btn) btn.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
    }

    function fitDestGroup(group, animate = true) {
      if (!map || !group) return;
      const bounds = new mapboxgl.LngLatBounds();
      visibleDestTripIds(group).forEach(id => {
        const t = TRIPS.find(x => x.id === id);
        if (!t) return;
        const path = t.route_path || [];
        if (path.length >= 2) path.forEach(p => bounds.extend([p[1], p[0]]));
        else (t.stops || []).forEach(s => bounds.extend([s.lng, s.lat]));
      });
      if (group.lng != null && group.lat != null) bounds.extend([group.lng, group.lat]);
      if (bounds.isEmpty()) return;
      map.fitBounds(bounds, {
        padding: mapCameraPadding(),
        pitch: 0,
        bearing: 0,
        duration: animate ? 900 : 0,
        maxZoom: 7.2,
        minZoom: 3,
      });
    }

    /** Browse a destination's trips — stay on atlas until user picks one. */
    function browseDestGroup(destName) {
      const group = DEST_GROUPS.find(g => g.dest === destName);
      if (!group || !visibleDestTripIds(group).length) return;
      preserveDestBrowse = true;
      if (selectedId !== 'all') selectTrip('all');
      preserveDestBrowse = false;
      browseDest = destName;
      if (isMobileLayout()) {
        setPanelCollapsed(false);
        setSheetState('full');
      }
      highlightDestBrowse(group);
      scrollToDestGroup(destName);
      fitDestGroup(group);
      renderMobileDestRail();
    }

    function selectDestGroup(destName) {
      browseDestGroup(destName);
    }

    function renderMobileDestRail() {
      const rail = document.getElementById('mobile-dest-rail');
      if (!rail) return;
      if (!isMobileLayout() || selectedId !== 'all') {
        rail.innerHTML = '';
        rail.hidden = true;
        return;
      }
      const groups = (DEST_GROUPS || []).filter(g => visibleDestTripIds(g).length > 0);
      if (!groups.length) {
        rail.innerHTML = '';
        rail.hidden = true;
        return;
      }
      rail.hidden = false;
      rail.innerHTML = groups.map(g => {
        const count = visibleDestTripIds(g).length;
        const active = browseDest === g.dest ? ' active' : '';
        return `<button type="button" class="mobile-dest-chip${active}" data-dest="${g.dest}" style="--chip-color:${g.color}">
          <span class="chip-dot" aria-hidden="true"></span>
          <span class="chip-name">${g.dest}</span>
          <span class="chip-count">${count}</span>
        </button>`;
      }).join('');
      rail.querySelectorAll('.mobile-dest-chip').forEach(btn => {
        btn.addEventListener('click', () => browseDestGroup(btn.dataset.dest));
      });
    }

    function stopMemoryReel() { /* removed: no auto-cycling memory reel */ }
    function startMemoryReel() { /* removed */ }

    function atlasHotDest() {
      const id = hoveredTripId;
      if (!id) return null;
      const trip = TRIPS.find(t => t.id === id);
      return trip?.story_dest || trip?.dest_label || null;
    }

    function showMemoryHighlight(trip) {
      if (!trip || selectedId !== 'all') return;
      TRIPS.forEach(t => {
        if (!tripInEra(t)) setRouteStyle(t.id, t.color, 'overviewDim');
        else if (t.id === trip.id) setRouteStyle(t.id, t.color, 'overviewHover');
        else setRouteStyle(t.id, t.color, 'overviewDim');
      });
      destMarkers.forEach(m => {
        const hit = (m._tripIds || []).includes(trip.id);
        m.getElement().classList.toggle('hot', hit);
        m.getElement().classList.toggle('dim', !hit);
      });
      hubMarkers.forEach(m => {
        const hit = (m._tripIds || []).includes(trip.id);
        m.getElement().classList.toggle('hot', hit);
        m.getElement().classList.toggle('dim', !hit);
      });
      drawAtlasSpokes();
    }

    /** Perpendicular offset (meters) for parallel corridor filaments. */
    function offsetSpokeCoords(lng1, lat1, lng2, lat2, meters) {
      const dx = lng2 - lng1, dy = lat2 - lat1;
      const len = Math.hypot(dx, dy) || 1;
      const nx = -dy / len, ny = dx / len;
      const midLat = (lat1 + lat2) / 2;
      const dLng = (meters / 111320) / Math.max(0.2, Math.cos(midLat * Math.PI / 180));
      const dLat = meters / 110540;
      return [
        [lng1 + nx * dLng, lat1 + ny * dLat],
        [lng2 + nx * dLng, lat2 + ny * dLat],
      ];
    }

    function drawAtlasSpokes() {
      if (!map) return;
      const feats = [];
      const hotDest = atlasHotDest();
      if (selectedId === 'all') {
        DEST_GROUPS.forEach(group => {
          const visibleIds = (group.trip_ids || []).filter(id => {
            const t = TRIPS.find(x => x.id === id);
            return t && tripInEra(t);
          });
          if (!visibleIds.length) return;
          // Attach spoke to the hub that owns most of this destination's trips
          const hubScore = {};
          visibleIds.forEach(id => {
            const t = TRIPS.find(x => x.id === id);
            const hub = t?.start_hub || 'Home';
            hubScore[hub] = (hubScore[hub] || 0) + 1;
          });
          const hubLabel = Object.entries(hubScore).sort((a, b) => b[1] - a[1])[0]?.[0];
          const hub = HUBS.find(h => h.label === hubLabel) || HUBS[0];
          if (!hub || group.lat == null || group.lng == null) return;
          const visits = visibleIds.length;
          const hot = hotDest && group.dest === hotDest ? 1 : 0;
          const a = [hub.lng, hub.lat], b = [group.lng, group.lat];
          // Soft corridor band + dashed spokes share one GeoJSON source (kind filter)
          feats.push({
            type: 'Feature',
            properties: { kind: 'band', color: group.color, dest: group.dest, visits, hot },
            geometry: { type: 'LineString', coordinates: [a, b] },
          });
          feats.push({
            type: 'Feature',
            properties: { kind: 'spoke', color: group.color, dest: group.dest, visits, role: 'core', hot },
            geometry: { type: 'LineString', coordinates: [a, b] },
          });
          // Multi-visit destinations: fan parallel filaments so the corridor reads as a band
          if (visits >= 2) {
            const spacing = Math.min(42000, 14000 + visits * 5000);
            const sides = visits >= 5 ? [-1.15, 1.15, -0.7, 0.7, -0.35, 0.35]
              : visits >= 3 ? [-1, 1, -0.5, 0.5]
              : [-1, 1];
            sides.forEach((s, i) => {
              feats.push({
                type: 'Feature',
                properties: { kind: 'spoke', color: group.color, dest: group.dest, visits, role: 'filament', hot },
                geometry: {
                  type: 'LineString',
                  coordinates: offsetSpokeCoords(a[0], a[1], b[0], b[1], s * spacing * (1 + (i % 2) * 0.18)),
                },
              });
            });
          }
        });
      }
      const data = { type: 'FeatureCollection', features: feats };
      const vis = selectedId === 'all' ? 'visible' : 'none';
      const hasSource = !!map.getSource('atlas-spokes');
      if (hasSource) {
        map.getSource('atlas-spokes').setData(data);
      } else {
        map.addSource('atlas-spokes', { type: 'geojson', data });
      }
      const hasBand = !!map.getLayer('atlas-spokes-band');
      const hasLine = !!map.getLayer('atlas-spokes-line');
      if (hasBand && hasLine) {
        map.setLayoutProperty('atlas-spokes-band', 'visibility', vis);
        map.setLayoutProperty('atlas-spokes-line', 'visibility', vis);
        return;
      }
      const beforeId = (map.getStyle().layers || []).find(l => /^route-.*-casing$/.test(l.id))?.id;
      // Zoom-aware opacity + visit-aware width; hot corridor brightens during reel/hover
      const bandLayer = {
        id: 'atlas-spokes-band',
        type: 'line',
        source: 'atlas-spokes',
        filter: ['==', ['get', 'kind'], 'band'],
        layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
        paint: {
          'line-color': ['get', 'color'],
          'line-width': [
            'interpolate', ['linear'], ['get', 'visits'],
            1, ['case', ['==', ['get', 'hot'], 1], 12, 8],
            2, ['case', ['==', ['get', 'hot'], 1], 18, 14],
            4, ['case', ['==', ['get', 'hot'], 1], 28, 22],
            8, ['case', ['==', ['get', 'hot'], 1], 40, 32],
          ],
          'line-opacity': [
            'interpolate', ['linear'], ['zoom'],
            2, ['case', ['==', ['get', 'hot'], 1], 0.4, 0.26],
            4, ['case', ['==', ['get', 'hot'], 1], 0.32, 0.18],
            6, ['case', ['==', ['get', 'hot'], 1], 0.2, 0.1],
          ],
          'line-blur': ['case', ['==', ['get', 'hot'], 1], 2.2, 3.8],
        },
      };
      const layer = {
        id: 'atlas-spokes-line',
        type: 'line',
        source: 'atlas-spokes',
        filter: ['==', ['get', 'kind'], 'spoke'],
        layout: { 'line-cap': 'round', 'line-join': 'round', visibility: vis },
        paint: {
          'line-color': ['get', 'color'],
          'line-width': [
            'match', ['get', 'role'],
            'filament', ['case', ['==', ['get', 'hot'], 1], 1.35, 0.95],
            ['case', ['==', ['get', 'hot'], 1], 2.2, 1.55],
          ],
          'line-opacity': [
            'interpolate', ['linear'], ['zoom'],
            2, [
              'match', ['get', 'role'],
              'filament', ['case', ['==', ['get', 'hot'], 1], 0.45, 0.18],
              ['case', ['==', ['get', 'hot'], 1], 0.7, 0.34],
            ],
            4, [
              'match', ['get', 'role'],
              'filament', ['case', ['==', ['get', 'hot'], 1], 0.55, 0.28],
              ['case', ['==', ['get', 'hot'], 1], 0.75, 0.42],
            ],
            6, [
              'match', ['get', 'role'],
              'filament', ['case', ['==', ['get', 'hot'], 1], 0.4, 0.22],
              ['case', ['==', ['get', 'hot'], 1], 0.65, 0.36],
            ],
          ],
          'line-dasharray': [1.2, 1.8],
        },
      };
      const add = (spec) => {
        if (map.getLayer(spec.id)) return;
        try {
          if (beforeId) map.addLayer(spec, beforeId);
          else map.addLayer(spec);
        } catch (_) {
          try { map.addLayer(spec); } catch (__) {}
        }
      };
      add(bandLayer);
      add(layer);
    }

