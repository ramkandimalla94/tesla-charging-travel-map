{# Playback loop, start/stop, reset visuals #}
    // ── Playback ──
    function animate(ts) {
      if (!isPlaying) return;
      if (!lastTs) lastTs=ts;
      const pb = activePlayback();
      if (!pb?.total_video_ms) { stopPlayback(); return; }
      const rawDelta = ts - lastTs;
      const delta = Math.min(rawDelta, 250);
      // Calibrated so UI 1× matches the former 0.5× passenger pace.
      const PLAYBACK_SPEED_REF = 0.5;
      animTimeMs += delta * speed * PLAYBACK_SPEED_REF;
      lastTs = ts;
      if (animTimeMs >= pb.total_video_ms) {
        animTimeMs = pb.total_video_ms;
        updateTrailFromState(positionAtTime(animTimeMs));
        if (isRecording) finishRecording();
        if (loopTrip) {
          animTimeMs = 0; animStopIdx = 0;
          resetNavChase();
          applyIdleStopVisuals();
          lastTs = 0;
          if (!isRecording) { animFrame = requestAnimationFrame(animate); }
          return;
        }
        if (queueEpics && !isRecording) {
          const next = nextEpicTrip(selectedId);
          stopPlayback();
          if (next) {
            selectTrip(next.id);
            setTimeout(() => startPlayback(false), 900);
          }
          return;
        }
        stopPlayback();
        return;
      }
      updateTrailFromState(positionAtTime(animTimeMs));
      animFrame = requestAnimationFrame(animate);
    }
    function startPlayback(forRecording=false) {
      if (!isSingleTrip()) {
        document.getElementById('prog-text').textContent = 'Select a trip first';
        return;
      }
      const pb = activePlayback();
      if (!pb?.total_video_ms) return;
      if (animTimeMs >= pb.total_video_ms) {
        animTimeMs = 0;
        resetVisuals(false);
        drawStops();
      }
      // Interactive play: skip title card / early dwell so the car moves immediately.
      // Recording keeps the full cinematic intro.
      if (!forRecording && animTimeMs <= 120) {
        const jump = firstTravelOffsetMs(pb);
        if (jump > 0) animTimeMs = jump + 24;
      }
      isPlaying = true; lastTs = 0;
      syncPlayToggle(true);
      resetNavChase();
      if (!forRecording) clearUserCameraControl();
      setPanelCollapsed(true);
      if (!forRecording) setWatching(true);
      setPlaybackVisuals(true);
      ui('transport-dock')?.classList.remove('idle');
      updateQueueBadge();
      const trip = activeTrip();
      if (trip?.color) {
        try { ensureTrailLayers(trip.color); } catch (_) {}
      }
      // Paint first motion frame synchronously — no wait for RAF / intro settle.
      const warm = positionAtTime(animTimeMs);
      if (warm?.bearing != null) {
        navBearing = warm.bearing;
        lastTravelBearing = warm.bearing;
        camBearing = directorMode ? warm.bearing : 0;
      }
      if (warm) {
        updateTrailFromState(warm);
        applyPlaybackCamera(warm, true);
      }
      animFrame = requestAnimationFrame(animate);
    }
    function stopPlayback() {
      isPlaying=false;
      if (animFrame) cancelAnimationFrame(animFrame);
      syncPlayToggle(false);
      clearUserCameraControl();
      if (!isRecording) {
        setPlaybackVisuals(false);
        setWatching(false);
      }
    }
    function resetVisuals(clearHud=true) {
      stopPlayback(); animTimeMs=0; animProg=0; animStopIdx=0;
      smoothBearing = 0; lastTravelBearing = 0;
      resetNavChase();
      if (vehicleMarker) { vehicleMarker.remove(); vehicleMarker=null; }
      clearPoiMarkers();
      if (map?.getSource('active-trail')) map.getSource('active-trail').setData({type:'Feature',geometry:{type:'LineString',coordinates:[]}});
      applyIdleStopVisuals();
      setPlaybackChrome(0, isSingleTrip() ? 'Ready to replay' : 'Select a trip to replay');
      if (clearHud) {
        ui('trip-clock')?.classList.remove('visible');
        ui('story-overlay')?.classList.remove('visible');
        setNightMode(false);
      }
      hideMemoryCard();
      storyOverlayKey = '';
      setPlaybackVisuals(false);
      setWatching(false);
    }

