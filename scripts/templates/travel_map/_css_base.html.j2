    :root {
      --bg: #0b1412;
      --bg-deep: #07100e;
      --surface: rgba(18, 32, 28, 0.82);
      --surface-2: rgba(255, 248, 235, 0.05);
      --border: rgba(214, 196, 160, 0.14);
      --border-bright: rgba(214, 196, 160, 0.28);
      --text: #f3efe6;
      --muted: #9aab9f;
      --accent: #7ec8a3;
      --accent-2: #c4a35a;
      --gold: #c4a35a;
      --ink: #d6e6dc;
      --panel-w: 300px;
      --dock-h: 132px;
      --timeline-h: 68px;
      --font-display: 'Fraunces', Georgia, serif;
      --font-body: 'Sora', system-ui, sans-serif;
      --ease: cubic-bezier(.22, 1, .36, 1);
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html, body {
      height: 100%; overflow: hidden;
      font-family: var(--font-body); background: var(--bg); color: var(--text);
      -webkit-font-smoothing: antialiased;
    }

    #map-wrap { position: absolute; inset: 0; overflow: hidden; }
    #map { position: absolute; inset: 0; }
    .map-vignette {
      position: absolute; inset: 0; pointer-events: none; z-index: 2;
      background:
        radial-gradient(ellipse 85% 65% at 50% 40%, transparent 30%, rgba(7,16,14,0.5) 100%),
        linear-gradient(to bottom, rgba(7,16,14,0.45) 0%, transparent 18%, transparent 72%, rgba(7,16,14,0.78) 100%);
      transition: opacity 0.6s var(--ease);
    }
    body.trip-focus .map-vignette {
      background:
        radial-gradient(ellipse 70% 55% at 55% 45%, transparent 22%, rgba(7,16,14,0.58) 100%),
        linear-gradient(to bottom, rgba(7,16,14,0.5) 0%, transparent 14%, transparent 70%, rgba(7,16,14,0.82) 100%);
    }
    .map-grain {
      position: absolute; inset: 0; pointer-events: none; z-index: 3; opacity: 0.035;
      background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 256 256' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.85' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    }
    .mapboxgl-canvas { transition: filter 0.8s ease; }
    body.night .mapboxgl-canvas { filter: brightness(0.42) contrast(1.1) saturate(0.85) hue-rotate(150deg); }

    .map-legend {
      position: absolute; top: 72px; right: 22px; z-index: 11;
      display: flex; flex-direction: column; gap: 6px;
      padding: 10px 12px; border-radius: 12px;
      background: var(--surface); backdrop-filter: blur(18px) saturate(1.2);
      border: 1px solid var(--border); box-shadow: 0 12px 40px rgba(0,0,0,0.4);
      opacity: 0; transform: translateY(-6px); pointer-events: none;
      transition: opacity 0.35s var(--ease), transform 0.35s var(--ease);
    }
    .map-legend.visible { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .map-legend .leg-row {
      display: flex; align-items: center; gap: 8px;
      font-size: 10px; font-weight: 600; letter-spacing: 0.06em; color: var(--muted);
      text-transform: uppercase;
    }
    .map-legend .swatch {
      width: 18px; height: 4px; border-radius: 2px; flex-shrink: 0;
      background: var(--accent);
    }
    .map-legend .pin {
      width: 12px; height: 12px; border-radius: 50%; flex-shrink: 0;
      border: 2px solid rgba(243,239,230,0.9);
    }
    .map-legend .pin.start { background: linear-gradient(145deg, #7ec8a3, #3d8f6e); }
    .map-legend .pin.end { background: linear-gradient(145deg, #c4a35a, #8a7038); }
