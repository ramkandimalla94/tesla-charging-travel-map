    /* ── Splash ── */
    #splash {
      position: fixed; inset: 0; z-index: 9999;
      background:
        radial-gradient(ellipse 90% 70% at 50% 30%, rgba(126,200,163,0.14), transparent 55%),
        linear-gradient(165deg, #0e1c18 0%, var(--bg-deep) 55%, #0a1210 100%);
      display: flex; flex-direction: column; align-items: center; justify-content: center;
      transition: opacity 0.9s var(--ease), visibility 0.9s;
    }
    #splash.hidden { opacity: 0; visibility: hidden; pointer-events: none; }
    #splash .brand-mark {
      font-family: var(--font-body); font-size: 11px; letter-spacing: 0.32em;
      text-transform: uppercase; color: var(--accent-2); margin-bottom: 18px;
      opacity: 0; animation: diaryReveal 0.7s var(--ease) 0.1s forwards;
    }
    #splash h1 {
      font-family: var(--font-display); font-size: clamp(36px, 6vw, 64px);
      font-weight: 600; letter-spacing: -0.03em; margin-bottom: 12px;
      color: var(--text);
      opacity: 0; animation: diaryReveal 0.8s var(--ease) 0.22s forwards;
    }
    #splash p {
      font-size: 15px; color: var(--muted); margin-bottom: 36px; max-width: 28rem;
      text-align: center; line-height: 1.5;
      opacity: 0; animation: diaryReveal 0.8s var(--ease) 0.36s forwards;
    }
    .splash-bar { width: 220px; height: 2px; background: var(--surface-2); border-radius: 2px; overflow: hidden; }
    .splash-fill {
      height: 100%; width: 0%; border-radius: 2px;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      transition: width 0.35s ease;
    }
    @keyframes diaryReveal {
      from { opacity: 0; transform: translateY(10px); }
      to { opacity: 1; transform: translateY(0); }
    }

    /* ── Top bar ── */
    .top-bar {
      position: absolute; top: 0; left: 0; right: 0; z-index: 12;
      display: flex; align-items: center; justify-content: space-between;
      padding: 18px 22px; pointer-events: none;
    }
    .brand {
      font-family: var(--font-display); font-size: 18px; font-weight: 600;
      letter-spacing: -0.02em; pointer-events: auto;
      text-shadow: 0 2px 18px rgba(0,0,0,0.75);
    }
    .brand span { color: var(--accent); font-style: italic; font-weight: 500; }
    .stat-rail {
      display: flex; gap: 8px; pointer-events: auto;
    }
    .stat-chip {
      background: var(--surface); backdrop-filter: blur(18px) saturate(1.15);
      border: 1px solid var(--border); border-radius: 10px;
      padding: 8px 12px; font-size: 11px; color: var(--muted);
      box-shadow: 0 8px 28px rgba(0,0,0,0.3);
    }
    .stat-chip strong { color: var(--text); font-weight: 600; margin-left: 4px; font-size: 12px; }

    /* ── Trip panel (atlas / diary) ── */
    .trip-panel {
      position: absolute; top: 72px; left: 18px; bottom: calc(var(--dock-h) + var(--timeline-h) + 36px);
      width: var(--panel-w); z-index: 10;
      background: linear-gradient(180deg, rgba(14, 22, 19, 0.88), rgba(10, 16, 14, 0.92));
      backdrop-filter: blur(24px) saturate(1.2);
      border: 1px solid rgba(214, 196, 160, 0.12);
      border-radius: 20px;
      box-shadow: 0 18px 60px rgba(0,0,0,0.4);
      display: flex; flex-direction: column; overflow: hidden;
      transition: transform 0.45s cubic-bezier(.22,1,.36,1), opacity 0.35s;
    }
    .trip-panel.collapsed { transform: translateX(calc(-1 * var(--panel-w) - 28px)); opacity: 0.4; }
    .panel-grab { display: none; }
    .panel-head { padding: 20px 18px 12px; border-bottom: none; }
    .panel-head .eyebrow {
      font-size: 10px; font-weight: 600; letter-spacing: 0.16em;
      text-transform: uppercase; color: var(--accent-2); margin-bottom: 8px;
    }
    .panel-head h2 {
      font-family: var(--font-display); font-size: 22px; font-weight: 600;
      letter-spacing: -0.03em; line-height: 1.15; color: var(--text);
    }
    .panel-head .sub { font-size: 12px; color: var(--muted); margin-top: 6px; line-height: 1.4; }

    .trip-hero {
      margin: 4px 14px 8px; padding: 14px 4px 10px;
      border-radius: 0;
      background: transparent;
      border: none; border-bottom: 1px solid rgba(214, 196, 160, 0.1);
      position: relative; overflow: visible;
    }
    .trip-hero::before { display: none; }
    .trip-hero.featured::before { display: none; }
    .trip-hero-name {
      font-family: var(--font-display); font-size: 15px; font-weight: 600;
      line-height: 1.3; margin-bottom: 4px; position: relative;
    }
    .trip-hero-via { font-size: 11px; color: var(--muted); line-height: 1.45; margin-bottom: 12px; position: relative; }
    .trip-hero-via em { color: var(--accent); font-style: italic; font-weight: 500; }
    .metric-grid {
      display: grid; grid-template-columns: repeat(4, 1fr); gap: 0;
      position: relative;
      border-top: none;
    }
    .metric {
      text-align: left; padding: 4px 6px 2px 0;
      border-radius: 0; background: transparent; border: none;
    }
    .metric .val {
      display: block; font-family: var(--font-display); font-size: 15px; font-weight: 600;
      letter-spacing: -0.02em;
    }
    .metric .lbl {
      font-size: 9px; color: var(--muted); text-transform: uppercase;
      letter-spacing: 0.1em; margin-top: 3px;
    }

    .trip-scroll { flex: 1; overflow-y: auto; padding: 6px 10px 16px; }
    .trip-scroll::-webkit-scrollbar { width: 3px; }
    .trip-scroll::-webkit-scrollbar-thumb { background: var(--border-bright); border-radius: 99px; }
    .group-label {
      font-size: 9px; font-weight: 700; color: var(--muted);
      text-transform: uppercase; letter-spacing: 0.14em; padding: 14px 8px 8px;
    }
    .group-label.featured { color: var(--accent-2); }
    .trip-item {
      display: flex; align-items: flex-start; gap: 10px; padding: 10px 10px;
      border-radius: 12px; cursor: pointer; margin-bottom: 2px;
      border: 1px solid transparent; transition: background 0.2s, border-color 0.2s;
    }
    .trip-item:hover { background: rgba(255,248,235,0.04); transform: none; }
    .trip-item.active {
      background: rgba(126, 200, 163, 0.08); border-color: rgba(126, 200, 163, 0.18);
      box-shadow: none;
    }
    .trip-item.featured { border-color: transparent; }
    .trip-item.featured.active {
      background: rgba(196, 163, 90, 0.1); border-color: rgba(196, 163, 90, 0.22);
    }
    .trip-item.preview {
      background: rgba(255,255,255,0.04); border-color: transparent;
      box-shadow: inset 2px 0 0 currentColor;
    }
    .trip-swatch {
      width: 3px; height: 28px; border-radius: 99px; flex-shrink: 0; margin-top: 2px;
      box-shadow: none; opacity: 0.9;
    }
    .trip-name { font-size: 12px; font-weight: 560; line-height: 1.35; letter-spacing: -0.01em; }
    .trip-meta { font-size: 10px; color: var(--muted); margin-top: 3px; line-height: 1.35; }
    .route-chip {
      position: absolute; z-index: 6; pointer-events: none;
      transform: translate(-50%, -130%);
      font-size: 10px; font-weight: 700; letter-spacing: 0.02em;
      padding: 4px 8px; border-radius: 8px; white-space: nowrap;
      background: rgba(8,10,16,0.92); border: 1px solid rgba(255,255,255,0.22);
      color: #fff; box-shadow: 0 6px 18px rgba(0,0,0,0.45);
      opacity: 0; transition: opacity 0.2s;
    }
    .route-chip.visible { opacity: 1; }
    .route-chip .dot {
      display: inline-block; width: 7px; height: 7px; border-radius: 50%;
      margin-right: 6px; vertical-align: middle;
    }

    /* Home hubs — label chips only (no circular dots) */
    .home-hub {
      display: flex; flex-direction: column; align-items: center;
      pointer-events: auto; cursor: pointer;
    }
    .home-hub-core { display: none; }
    .home-hub-label {
      padding: 5px 10px; border-radius: 999px;
      background: rgba(10, 14, 12, 0.72); border: 1px solid rgba(243,239,230,0.28);
      font-size: 10px; font-weight: 600; color: #f4f6fa; white-space: nowrap;
      backdrop-filter: blur(10px);
      letter-spacing: 0.02em;
    }
    .home-hub-label span {
      color: var(--accent-2); font-weight: 700; margin-left: 6px;
      font-variant-numeric: tabular-nums;
    }
    .home-hub.dim { opacity: 0.28; }
    .home-hub.hot .home-hub-label {
      border-color: rgba(196,163,90,0.55);
      box-shadow: 0 0 0 1px rgba(196,163,90,0.25);
    }

    .dest-star {
      display: flex; flex-direction: column; align-items: center;
      pointer-events: auto; cursor: pointer;
    }
    .dest-star-core { display: none !important; }
    .dest-star-label {
      padding: 4px 9px; border-radius: 999px;
      background: rgba(10, 14, 12, 0.7); border: 1px solid rgba(255,255,255,0.16);
      font-size: 10px; font-weight: 600; color: #fff; white-space: nowrap;
      max-width: 140px; overflow: hidden; text-overflow: ellipsis;
      backdrop-filter: blur(8px);
    }
    .dest-star.dim { opacity: 0.2; }
    .dest-star.hot .dest-star-label {
      border-color: color-mix(in srgb, currentColor 55%, transparent);
      color: #fff;
    }

    .dest-group-label {
      font-size: 10px; font-weight: 700; color: var(--text);
      letter-spacing: 0.04em; padding: 10px 8px 4px;
      display: flex; align-items: baseline; justify-content: space-between; gap: 8px;
    }
    .dest-group-label .meta { font-size: 9px; color: var(--muted); font-weight: 600; }
    .trip-item.nested { margin-left: 8px; padding: 9px 10px; }
    .trip-item.nested .trip-name { font-size: 11px; }

    .transport-dock.idle {
      opacity: 0.72; transform: translateX(-50%) translateY(4px);
    }
    body.trip-focus .stat-rail { opacity: 0.35; transition: opacity 0.35s; }
    body.trip-focus .stat-rail:hover { opacity: 1; }

    /* Soft watch mode — cinema feel without portrait export */
    body.watching .trip-panel,
    body.watching .panel-toggle,
    body.watching .top-bar,
    body.watching .timeline-bar,
    body.watching #onboarding,
    body.watching .mapboxgl-ctrl-group,
    body.watching .mapboxgl-ctrl-attrib { opacity: 0 !important; pointer-events: none !important; }
    body.watching .transport-dock {
      opacity: 0.22; transition: opacity 0.35s ease;
    }
    body.watching .transport-dock:hover,
    body.watching .transport-dock:focus-within { opacity: 0.92; }
    body.watching .trip-clock { opacity: 0.9; }
    body.watching .story-overlay { bottom: 120px; left: 50%; transform: translateX(-50%); max-width: min(520px, calc(100vw - 48px)); text-align: center; }
    body.watching .story-overlay .story-caption {
      text-shadow: 0 2px 16px rgba(0,0,0,0.95), 0 0 2px rgba(0,0,0,0.9);
      background: rgba(8,10,16,0.55);
      padding: 8px 14px; border-radius: 12px;
      display: inline-block;
    }
    body.watching .cinema-title.visible { display: block; bottom: 140px; }

    /* Atlas featured CTA + memory reel */
    .atlas-cta {
      position: absolute; top: 78px; right: 22px; z-index: 12;
      display: none; align-items: center; gap: 12px;
      max-width: min(280px, calc(100vw - 48px));
      padding: 12px 14px; border-radius: 14px;
      background: var(--surface); backdrop-filter: blur(18px);
      border: 1px solid var(--border-bright);
      box-shadow: 0 16px 48px rgba(0,0,0,0.4);
      color: var(--text); cursor: pointer; text-align: left;
      transition: border-color 0.2s, transform 0.2s var(--ease), opacity 0.3s;
    }
    .atlas-cta.visible { display: flex; }
    body.trip-focus .atlas-cta,
    body.watching .atlas-cta,
    body.cinema-mode .atlas-cta { opacity: 0 !important; pointer-events: none !important; }
    .atlas-cta:hover { border-color: rgba(126,200,163,0.45); transform: translateY(-1px); }
    .atlas-cta:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
    .atlas-cta-swatch {
      width: 10px; height: 40px; border-radius: 4px; flex-shrink: 0;
      box-shadow: 0 0 12px currentColor;
    }
    .atlas-cta-body { min-width: 0; text-align: left; }
    .atlas-cta-eyebrow {
      font-size: 9px; font-weight: 600; letter-spacing: 0.14em; text-transform: uppercase;
      color: var(--accent-2); margin-bottom: 2px;
    }
    .atlas-cta-title {
      font-family: var(--font-display); font-size: 14px; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
    }
    .atlas-cta-meta { font-size: 10px; color: var(--muted); margin-top: 2px; }

    .photo-hover {
      position: fixed; z-index: 30; pointer-events: none;
      width: 168px; padding: 8px; border-radius: 12px;
      background: rgba(18, 32, 28, 0.94); border: 1px solid var(--border-bright);
      box-shadow: 0 18px 48px rgba(0,0,0,0.55);
      opacity: 0; transform: translateY(8px) scale(0.97);
      transition: opacity 0.25s var(--ease), transform 0.25s var(--ease);
    }
    .photo-hover.visible { opacity: 1; transform: translateY(0) scale(1); }
    .photo-hover img {
      display: block; width: 100%; height: 120px; object-fit: cover; border-radius: 8px;
      background: #12201c;
    }
    .photo-hover .cap {
      margin-top: 8px; font-size: 11px; color: var(--muted); line-height: 1.35;
    }
    .photo-hover .cap strong { color: var(--text); font-weight: 600; display: block; margin-bottom: 2px; }

    /* Cinema memory — large fixed stage (stable; not map-marker anchored) */
    .memory-card { display: none !important; }
    .memory-map-pin { display: none !important; }
    .memory-stage {
      position: fixed;
      left: 50%;
      bottom: calc(var(--dock-h) + var(--timeline-h) + 28px);
      transform: translateX(-50%);
      z-index: 22;
      width: min(720px, 86vw);
      max-height: min(62vh, 560px);
      padding: 10px;
      border-radius: 18px;
      background: rgba(12, 18, 16, 0.88);
      border: 1px solid rgba(255,255,255,0.14);
      box-shadow: 0 24px 64px rgba(0,0,0,0.55);
      opacity: 0;
      visibility: hidden;
      pointer-events: none;
      transition: opacity 0.28s ease;
    }
    .memory-stage.visible {
      opacity: 1;
      visibility: visible;
    }
    .memory-stage img {
      display: block;
      width: 100%;
      max-height: min(52vh, 480px);
      object-fit: contain;
      border-radius: 12px;
      background: #0a100e;
    }
    .memory-stage-cap {
      margin-top: 10px;
      padding: 0 4px 2px;
      font-size: 12px;
      color: var(--muted);
      line-height: 1.35;
      text-align: center;
    }
    .memory-stage-cap strong {
      display: block;
      margin-bottom: 2px;
      font-family: var(--font-display);
      font-size: 16px;
      font-weight: 600;
      color: var(--text);
    }
    body.watching .memory-stage {
      bottom: calc(var(--dock-h) + 36px);
      width: min(780px, 90vw);
      max-height: min(68vh, 620px);
    }
    body.watching .memory-stage img {
      max-height: min(58vh, 540px);
    }
    .photo-pin {
      width: 30px; height: 30px; border-radius: 8px; overflow: hidden;
      border: 1.5px solid rgba(255,255,255,0.95);
      box-shadow: 0 2px 8px rgba(0,0,0,0.22);
      cursor: pointer; background: #efe8dc;
      transition: transform 0.2s var(--ease), box-shadow 0.2s var(--ease);
    }
    .photo-pin:hover, .photo-pin.hot {
      transform: scale(1.18);
      box-shadow: 0 4px 14px rgba(0,0,0,0.28);
      z-index: 2;
    }
    .photo-pin img { width: 100%; height: 100%; object-fit: cover; display: block; }
    body.watching .photo-pin:not(.hot) { opacity: 0.35; }
    .filmstrip {
      display: flex; gap: 6px; overflow-x: auto; padding: 10px 14px 4px;
      border-top: 1px solid var(--border);
    }
    .filmstrip:empty { display: none; }
    .filmstrip img {
      width: 52px; height: 52px; object-fit: cover; border-radius: 8px;
      border: 1px solid var(--border); flex-shrink: 0; cursor: pointer;
    }

    .panel-toggle {
      position: absolute; top: 78px; left: calc(var(--panel-w) + 30px); z-index: 11;
      width: 34px; height: 34px; border-radius: 10px;
      background: var(--surface); border: 1px solid var(--border);
      color: var(--text); cursor: pointer;
      display: flex; align-items: center; justify-content: center;
      backdrop-filter: blur(16px); transition: left 0.45s cubic-bezier(.22,1,.36,1);
      box-shadow: 0 4px 20px rgba(0,0,0,0.35);
    }
    .panel-toggle svg { width: 14px; height: 14px; opacity: 0.8; }
    .trip-panel.collapsed ~ .panel-toggle { left: 18px; }

    /* ── Transport dock (slim, map-first) ── */
    .transport-dock {
      position: absolute; bottom: calc(var(--timeline-h) + 18px); left: 50%;
      transform: translateX(-50%); z-index: 14;
      width: min(400px, calc(100vw - 28px));
      background: rgba(10, 16, 14, 0.52); backdrop-filter: blur(18px) saturate(1.2);
      border: 1px solid rgba(214, 196, 160, 0.12); border-radius: 14px;
      padding: 8px 10px 9px;
      box-shadow: 0 10px 36px rgba(0,0,0,0.4);
    }
    .dock-row { display: flex; align-items: center; gap: 10px; }
    .dock-info { flex: 1; min-width: 0; }
    .dock-location {
      font-family: var(--font-display); font-size: 12px; font-weight: 600;
      white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
      opacity: 0.92;
    }
    .dock-sub { display: none; }
    .queue-badge {
      display: none; margin-top: 6px; width: fit-content;
      font-size: 10px; font-weight: 700; letter-spacing: 0.06em; text-transform: uppercase;
      color: #0f172a; background: var(--gold); border-radius: 999px;
      padding: 3px 9px; box-shadow: 0 0 0 1px rgba(251,191,36,0.35);
    }
    .queue-badge.visible { display: inline-flex; align-items: center; }
    .queue-badge[hidden] { display: none !important; }
    .dock-actions { display: none; }
    .icon-btn {
      width: 40px; height: 40px; min-width: 40px; min-height: 40px; border-radius: 11px;
      border: 1px solid var(--border); background: rgba(255,255,255,0.04);
      color: var(--text); cursor: pointer; display: flex; align-items: center; justify-content: center;
      transition: background 0.15s, border-color 0.15s, transform 0.12s;
    }
    .icon-btn:hover { background: rgba(255,255,255,0.08); border-color: var(--border-bright); }
    .icon-btn:active { transform: scale(0.94); }
    .icon-btn:disabled { opacity: 0.28; cursor: default; }
    .icon-btn:focus-visible {
      outline: 2px solid var(--accent); outline-offset: 2px;
    }
    .icon-btn.queue {
      background: rgba(251,191,36,0.14); border-color: rgba(251,191,36,0.4); color: var(--gold);
    }
    .icon-btn.primary {
      width: 40px; height: 40px; min-width: 40px; min-height: 40px; border-radius: 11px;
      background: rgba(255,255,255,0.9); border: none; color: #0f172a;
      box-shadow: 0 2px 12px rgba(255,255,255,0.1);
      flex-shrink: 0;
    }
    .icon-btn.primary:hover { background: #fff; }
    .icon-btn.primary.is-playing {
      background: rgba(255,255,255,0.14); color: #fff;
      border: 1px solid rgba(255,255,255,0.22); box-shadow: none;
    }
    .icon-btn.export {
      width: auto; min-width: 44px; min-height: 44px; padding: 0 14px; gap: 7px; font-size: 11px; font-weight: 700;
      letter-spacing: 0.04em; text-transform: uppercase;
      background: rgba(126,200,163,0.14);
      border-color: rgba(126,200,163,0.35); color: var(--accent);
    }
    .icon-btn.share {
      color: var(--gold); border-color: rgba(251,191,36,0.3);
      background: rgba(251,191,36,0.08);
    }
    .icon-btn.share:hover { border-color: rgba(251,191,36,0.5); }
    .icon-btn svg { width: 15px; height: 15px; flex-shrink: 0; }

    .share-toast {
      position: fixed; bottom: 28px; left: 50%; transform: translateX(-50%) translateY(12px);
      z-index: 10002; padding: 12px 18px; border-radius: 12px;
      background: var(--surface); border: 1px solid rgba(251,191,36,0.35);
      color: var(--text); font-size: 12px; font-weight: 600;
      box-shadow: 0 12px 40px rgba(0,0,0,0.5); opacity: 0; pointer-events: none;
      transition: opacity 0.25s, transform 0.25s; max-width: min(420px, calc(100vw - 32px));
      text-align: center;
    }
    .share-toast.visible {
      opacity: 1; transform: translateX(-50%) translateY(0);
      pointer-events: auto;
    }

    .scrub-track {
      position: relative; height: 3px; background: rgba(255,255,255,0.06);
      border-radius: 99px; overflow: hidden; cursor: pointer; margin-top: 8px;
    }
    .scrub-fill {
      position: absolute; left: 0; top: 0; bottom: 0; width: 0%;
      background: linear-gradient(90deg, var(--accent), var(--accent-2));
      border-radius: 99px;
      transition: width 0.08s linear;
    }
    input[type=range]#scrubber {
      position: absolute; inset: 0; width: 100%; height: 100%;
      opacity: 0; cursor: pointer; margin: 0;
    }
    .dock-sliders { display: none; }
    .speed-wrap {
      width: 84px; flex-shrink: 0; display: flex; flex-direction: column; gap: 2px;
    }
    .speed-wrap label { display: none; }
    input[type=range]#speed { width: 100%; accent-color: var(--accent); height: 3px; margin: 0; }
    .speed-val { font-size: 10px; font-weight: 700; color: var(--accent); text-align: right; letter-spacing: 0.02em; }

    /* ── Timeline ── */
    .timeline-bar {
      position: absolute; bottom: 14px; left: 18px; right: 18px; height: auto; min-height: var(--timeline-h);
      background: var(--surface); backdrop-filter: blur(24px);
      border: 1px solid var(--border); border-radius: 14px;
      z-index: 10; padding: 8px 14px 10px;
      box-shadow: 0 8px 32px rgba(0,0,0,0.4);
      display: flex; flex-direction: column; gap: 6px;
    }
    .timeline-head {
      display: flex; align-items: center; justify-content: space-between; gap: 10px;
    }
    .timeline-label { font-size: 9px; font-weight: 600; color: var(--muted); letter-spacing: 0.1em; text-transform: uppercase; }
    .era-rail {
      display: flex; gap: 5px; flex-wrap: wrap; justify-content: flex-end; align-items: center;
    }
    .era-rail-label {
      font-size: 9px; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase;
      color: var(--muted); margin-right: 2px; user-select: none;
    }
    .era-chip {
      border: 1px solid rgba(255,255,255,0.14); background: rgba(255,255,255,0.08);
      color: var(--text); font-size: 11px; font-weight: 700; font-family: inherit;
      padding: 5px 11px; border-radius: 999px; cursor: pointer; min-height: 32px;
      transition: background 0.15s, border-color 0.15s, color 0.15s, box-shadow 0.15s;
    }
    .era-chip:hover { color: #fff; border-color: rgba(255,255,255,0.28); background: rgba(255,255,255,0.12); }
    .era-chip.active {
      color: #0f172a; background: #e8e4dc; border-color: transparent;
      box-shadow: 0 0 0 1px rgba(232,228,220,0.35);
    }
    .era-chip:focus-visible { outline: 2px solid var(--accent); outline-offset: 1px; }
    body.trip-focus .era-rail { opacity: 0.55; }
    body.watching .era-rail,
    body.cinema-mode .era-rail { opacity: 0; pointer-events: none; }
    .timeline-track { position: relative; flex: 1; height: 22px; background: rgba(0,0,0,0.35); border-radius: 8px; overflow: hidden; cursor: pointer; }
    .tl-seg {
      position: absolute; top: 3px; bottom: 3px; border-radius: 5px;
      cursor: pointer; opacity: 0.7; transition: opacity 0.2s, filter 0.2s; min-width: 3px;
    }
    .tl-seg:hover, .tl-seg.active { opacity: 1; filter: brightness(1.15); }
    .tl-seg.featured { box-shadow: 0 0 10px rgba(251,191,36,0.4); }
    .tl-seg.era-dim { opacity: 0.12; pointer-events: none; }
    .timeline-scrub {
      position: absolute; top: 0; bottom: 0; width: 2px;
      background: #fff; box-shadow: 0 0 8px rgba(255,255,255,0.8);
      pointer-events: none; transition: left 0.08s;
    }
    .trip-item.era-dim { opacity: 0.28; }
    .dest-star {
      display: flex; flex-direction: column; align-items: center;
      pointer-events: auto; cursor: pointer;
    }
    .dest-star-core { display: none !important; }
    .dest-star-label {
      padding: 4px 9px; border-radius: 999px;
      background: rgba(10, 14, 12, 0.7); border: 1px solid rgba(255,255,255,0.16);
      font-size: 10px; font-weight: 600; color: #fff; white-space: nowrap;
      box-shadow: none;
      max-width: 140px; overflow: hidden; text-overflow: ellipsis;
      backdrop-filter: blur(8px);
    }
    .dest-star.dim { opacity: 0.2; }
    .dest-star.hot .dest-star-core { display: none; }
    .dest-star.hot .dest-star-label {
      border-color: color-mix(in srgb, currentColor 55%, transparent);
    }

