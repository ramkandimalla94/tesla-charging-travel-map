{# Instagram 9:16 export — title hold, outro card, chrome-free canvas #}
    function tripShareBlurb(trip) {
      if (!trip) return '';
      const story = trip.story || {};
      if (story.share_blurb) return story.share_blurb;
      return (
        `${trip.name} — ${Number(trip.miles || 0).toLocaleString()} mi · ${trip.stop_count} places · ${trip.duration_days}d\n` +
        'Relive it: https://ramkandimalla94.github.io/mymilediary/'
      );
    }

    function hideShareToast() {
      const toast = document.getElementById('share-toast');
      if (!toast) return;
      toast.classList.remove('visible');
      toast.onclick = null;
      toast.onkeydown = null;
      toast.style.cursor = '';
      toast.removeAttribute('tabindex');
      toast.removeAttribute('role');
      clearTimeout(showShareToast._t);
      clearTimeout(offerShareAfterPlay._t);
    }

    function showShareToast(msg, ms) {
      const toast = document.getElementById('share-toast');
      if (!toast) return;
      toast.onclick = null;
      toast.onkeydown = null;
      toast.style.cursor = '';
      toast.removeAttribute('tabindex');
      toast.setAttribute('role', 'status');
      toast.textContent = msg;
      toast.classList.add('visible');
      clearTimeout(showShareToast._t);
      showShareToast._t = setTimeout(() => hideShareToast(), ms == null ? 2600 : ms);
    }

    async function shareTripBlurb(opts) {
      const preferNative = !opts || opts.preferNative !== false;
      if (!isSingleTrip()) {
        showShareToast('Select a trip to share');
        return;
      }
      const trip = activeTrip();
      const text = tripShareBlurb(trip);
      const liveUrl = 'https://ramkandimalla94.github.io/mymilediary/';
      const shareData = { title: trip.name || 'My Mile Diary', text, url: liveUrl };

      if (preferNative && typeof navigator.share === 'function') {
        try {
          if (!navigator.canShare || navigator.canShare(shareData)) {
            await navigator.share(shareData);
            showShareToast('Shared');
            return;
          }
        } catch (err) {
          if (err && err.name === 'AbortError') return;
          // Fall through to clipboard when share sheet is unavailable
        }
      }

      try {
        if (navigator.clipboard?.writeText) await navigator.clipboard.writeText(text);
        else {
          const ta = document.createElement('textarea');
          ta.value = text; document.body.appendChild(ta); ta.select();
          document.execCommand('copy'); ta.remove();
        }
        showShareToast('Share blurb copied — paste anywhere');
      } catch (_) {
        showShareToast('Could not copy — try Export instead');
      }
    }

    function offerShareAfterPlay() {
      if (isRecording || loopTrip || queueEpics) return;
      const toast = document.getElementById('share-toast');
      if (!toast) return;
      showShareToast('Journey complete — tap to share', 8000);
      toast.style.cursor = 'pointer';
      toast.tabIndex = 0;
      toast.setAttribute('role', 'button');
      const go = () => {
        hideShareToast();
        shareTripBlurb();
      };
      toast.onclick = go;
      toast.onkeydown = (ev) => {
        if (ev.key === 'Enter' || ev.key === ' ') {
          ev.preventDefault();
          go();
        }
      };
      clearTimeout(offerShareAfterPlay._t);
      offerShareAfterPlay._t = setTimeout(() => hideShareToast(), 8000);
    }

    function showExportTitleCard(trip, phase) {
      const title = document.getElementById('cinema-title');
      if (!title || !trip) return;
      const story = trip.story || {};
      if (phase === 'outro') {
        document.getElementById('cinema-title-text').textContent = 'Journey Complete';
        document.getElementById('cinema-subtitle').textContent =
          `${trip.miles.toLocaleString()} mi · ${trip.stop_count} stops · ${trip.duration_days} days`;
        document.getElementById('cinema-highlights').innerHTML = '';
        title.classList.add('outro');
      } else {
        document.getElementById('cinema-title-text').textContent = trip.name;
        document.getElementById('cinema-subtitle').textContent =
          `${trip.miles.toLocaleString()} mi · ${trip.stop_count} places · ${trip.duration_days} days`;
        const hlEl = document.getElementById('cinema-highlights');
        hlEl.innerHTML = (story.highlights || []).slice(0, 4).map(h => `<span>${h}</span>`).join('');
        title.classList.remove('outro');
      }
      title.classList.add('visible');
    }

    function hideExportTitleCard() {
      const title = document.getElementById('cinema-title');
      if (!title) return;
      title.classList.remove('visible', 'outro');
      document.getElementById('cinema-highlights').innerHTML = '';
    }

    async function exportTripVideo() {
      if (!isSingleTrip() || !map) return;
      if (typeof MediaRecorder === 'undefined') {
        const status = document.getElementById('export-status');
        status.textContent = 'Recording not supported in this browser';
        status.classList.add('visible');
        setTimeout(() => status.classList.remove('visible'), 2800);
        return;
      }
      const trip = activeTrip();
      const status = document.getElementById('export-status');
      status.textContent = 'Preparing cinematic recording…';
      status.classList.add('visible');
      resetVisuals();
      drawStops();
      fitTrip(false);
      await new Promise(r => setTimeout(r, 1200));

      document.body.classList.add('cinema-mode', 'portrait-export');
      showExportTitleCard(trip, 'intro');
      map.resize();
      await new Promise(r => setTimeout(r, 400));

      const canvas = map.getCanvas();
      const stream = canvas.captureStream(30);
      recordedChunks = [];
      const mimeType = MediaRecorder.isTypeSupported('video/webm;codecs=vp9')
        ? 'video/webm;codecs=vp9' : 'video/webm';
      mediaRecorder = new MediaRecorder(stream, { mimeType, videoBitsPerSecond: 8_000_000 });
      mediaRecorder.ondataavailable = e => { if (e.data.size) recordedChunks.push(e.data); };
      mediaRecorder.onstop = () => {
        const blob = new Blob(recordedChunks, { type: 'video/webm' });
        const url = URL.createObjectURL(blob);
        const a = document.createElement('a');
        a.href = url;
        a.download = `${trip.id}_road_trip.webm`;
        a.click();
        URL.revokeObjectURL(url);
        isRecording = false;
        document.body.classList.remove('cinema-mode', 'portrait-export');
        hideExportTitleCard();
        status.classList.remove('visible');
        document.getElementById('story-overlay')?.classList.remove('visible');
        map.resize();
        fitTrip(false);
        showShareToast('Video saved — Share copies a caption with the live link');
      };

      isRecording = true;
      status.textContent = 'Recording title card…';
      mediaRecorder.start(250);
      // Hold intro title on-canvas so Instagram export opens with branding
      await new Promise(r => setTimeout(r, 2400));
      hideExportTitleCard();
      status.textContent = 'Recording road trip story…';
      startPlayback(true);
    }

    function finishRecording() {
      if (!isRecording) { stopPlayback(); return; }
      const trip = activeTrip();
      showExportTitleCard(trip, 'outro');
      const status = document.getElementById('export-status');
      if (status) status.textContent = 'Recording outro…';
      // Brief outro hold on the canvas before stopping the recorder
      setTimeout(() => {
        if (mediaRecorder && mediaRecorder.state !== 'inactive') {
          if (status) status.textContent = 'Saving video…';
          mediaRecorder.stop();
        }
        stopPlayback();
      }, 2200);
    }

