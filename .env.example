# Copy to .env and fill in if using the optional invoice scraper.
# NEVER commit .env — it is gitignored.

# Tesla account credentials (optional, for scrape_invoices.py only)
TESLA_EMAIL=
TESLA_PASSWORD=

# Nominatim user agent (required by OSM usage policy)
NOMINATIM_USER_AGENT=tesla-charging-history-map

# Mapbox access token (free tier: https://account.mapbox.com/)
# Required for 3D satellite map in output/travel_map.html
MAPBOX_TOKEN=
