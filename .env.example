# Copy to .env and fill in.

# Nominatim user agent (required by OSM usage policy)
NOMINATIM_USER_AGENT=mymilediary-local

# Mapbox access token (free tier: https://account.mapbox.com/)
# Required for 3D satellite map in output/travel_map.html
MAPBOX_TOKEN=

# Optional: legacy invoice scraper only
# TESLA_EMAIL=
# TESLA_PASSWORD=
